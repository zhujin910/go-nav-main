      "description": "",
      "type": "js",
      "code": "const clockDiv = document.createElement('div');\nclockDiv.className = \"my-clock-widget\";\nclockDiv.innerHTML = `<div class=\"my-clock-time\"></div><div class=\"my-clock-week\"></div>`;\ndocument.body.appendChild(clockDiv);\n\nconst weekArr = [\"星期日\",\"星期一\",\"星期二\",\"星期三\",\"星期四\",\"星期五\",\"星期六\"];\n\nfunction updateClock(){\n  const now = new Date();\n  const h = String(now.getHours()).padStart(2,'0');\n  const m = String(now.getMinutes()).padStart(2,'0');\n  const s = String(now.getSeconds()).padStart(2,'0');\n  const week = weekArr[now.getDay()];\n  clockDiv.querySelector('.my-clock-time').innerText = `${h}:${m}:${s}`;\n  clockDiv.querySelector('.my-clock-week').innerText = week;\n}\nupdateClock();\nsetInterval(updateClock,1000);\n",
      "loading": "defer",
      "href": "",
      "src": "",
      "crossOrigin": ""
    }
