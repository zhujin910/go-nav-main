 <script>
       $(function(){ 
      $(".yd-list .swiper-slide").each(function(){
            var text=$(this).find(" .yd-font time").text();
        $(this).find(" .yd-font time").text(timeFormat(text))
        });
    	
    });
  function timeFormat(time){
        var date= new Date(time)
        var dateTime = date.getFullYear()+'.'+checkTime(date.getMonth()+1)+'.'+checkTime(date.getDate()); 
        return dateTime;
    }
    function checkTime(i){
        if(i<10){
            i = '0'+i
        }
        return i
    }
</script>
  
<style type="text/css">
    .on_imgbox{width: 100px;height: 94px;background: url(https://hdrs-website.cn-shenzhen-finance.oss.aliyuncs.com//style/image/onlineribt.png) no-repeat;background-size: 100%;margin: 0 auto;}
    .robot_tips{position: fixed;z-index: 999;right: -52px;top: 100px;text-align: center;width: 193px;cursor: pointer;}
    .robot_tips .onlineimga img{width: 100px;}
    .robot_tips .text{color: deepskyblue;font-size: 16px;margin-top: 10px;display: none;position: absolute;top: 80px;}
    .donghua {
  transition: all 0.4s;
  -ms-transition: all 0.4s;
  -moz-transition: tall 0.4s;
  -webkit-transition: all 0.4s;
  -o-transition: all 0.4s;
}
</style>
<script>
    $('#closeNotice').click(function () {
      $('#notice').hide()
    })
// 图标拖拽
window.onload = function(){
            var box = document.getElementById("tips"),iscilck=0;
            function drag (ele){
                ele.onmousedown = function(e){
                    iscilck =0
                  console.log(iscilck)
                   console.log("点击了")
                    var e = e || window.event;  
                    //此处是为了兼容IE，因为IE中事件对象是作为全局对象( window.event )存在的；
                    var pageX = e.pageX || e.clientX + document.documentElement.scrollLeft;
                    var pageY = e.pageY || e.clientY + document.documentElement.scrollTop;
                    //获取鼠标相对盒子的位置；
                    var boxX = pageX - box.offsetLeft;
                    var boxY = pageY - box.offsetTop;
                    ele.onmousemove = function(e){
                     iscilck =1
                         console.log("被拖拽了aaa ",iscilck )
                        var e = e || window.event;
                        var pageX = e.pageX || e.clientX + document.documentElement.scrollLeft;
                        var pageY = e.pageY || e.clientY + document.documentElement.scrollTop;
                      //将鼠标当前的坐标值减去鼠标相对盒子的位置，得到盒子当时的位置并将其赋值给盒子，实现移动效果
                        box.style.left = pageX - boxX +'px';
                        box.style.top = pageY - boxY + 'px';
                    }
                };
                ele.onmouseup = function () {
                    //清除盒子的移动事件;
                     if( iscilck ===0){
                   console.log("123213")
                     window.open( "https://onlineservice.harbourlife.com.cn/webchat/interfacePools.do?urlFrom=web&device=pc&userId=uerId&queue=242&from=web&labels=web")
                   ele.onmousemove = null;
                   }else{
                       console.log("aaaaewew ")
                      ele.onmousemove = null;
                    }   
                };
            } ;
            drag(box)

            console.log('清除二')
            // 清理滚动监听
            $(window).off('scroll');
            // 取消hover绑定
            $('header').removeClass('headerbgm');
            $(".menu-list>ul>li").mouseenter(function(){
                $('header').removeClass('headerbgm');
            })
            $(".menu-list>ul>li").mouseleave(function(){
                $('header').removeClass('headerbgm');
            })
            //下滑头部出现背景
            function onScroll() {
                var index_top = $(window).scrollTop();
                if (index_top > $('.headfixed').outerHeight() && $(window).width() > 1260) {
                    $('header').removeClass('headerbgm');
                } else {
                    $('header').removeClass('headerbgm');
                }
            }
            // 添加滚动监听
            $(window).on('scroll', onScroll);
        }

$(".on_imgbox").mouseover(function(){

  $(".robot_tips .text").css("display","block");
})
$(".on_imgbox").mouseout(function(){
  $(".robot_tips .text").css("display","none");
})

$(function(){
    var rightjuli=$(".robot_tips").css("right");
    if(rightjuli=="-52px"){
        $(".on_imgbox").hover(function(){
            $(".robot_tips").css({"right":"0"})
            if(rightjuli=="-52px"){
                $(".robot_tips").removeClass("donghua");
            }
        });
    }

    // 清理滚动监听
    $(window).off('scroll');
    $('header').removeClass('headerbgm');
});
</script>

  
