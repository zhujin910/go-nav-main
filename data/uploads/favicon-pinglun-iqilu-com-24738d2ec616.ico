<script language="javascript">
var refer=""+document.referrer;
if(!refer){
	refer="https://www.iqilu.com";
}else{
	refer=refer.match(/^http\:\/\/[^\/]+/);
}

setTimeout(function(){
window.location=refer;
},9500);
</script>
<body>
