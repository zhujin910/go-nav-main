</html>
<style type="text/css">
	.ptfooter{
		padding-bottom:6rem;
		background:white;
		padding-top: 3rem;
	}
	
	.ptfooter a{
		color: black;
	}
	 .ptfooter>div {
            text-align: center;
            font-size: 12px;
            line-height: 1.5em;
            margin: 2px 10px;
			color: #333;
        }
