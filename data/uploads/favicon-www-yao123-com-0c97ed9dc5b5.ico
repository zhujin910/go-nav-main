			font-size: 13px;
		}

	.knowBtn {
		background: #1ed9b4;
		border-radius: 2rem;
		padding-left: 8rem;
		padding-right: 8rem;
	}
	.animates {
		transform: translateY(0);
		transition: transform 1s;
	}
	
	.wordsLoop {
		height: 5rem;
	}
	
	.workwx_staff_qrcode{
		position:absolute;
		z-index:5;
		top:0;
		bottom:0;
		left:0;
		right:0;
		background-color: rgba(0,0,0,0.6);
	}
	.workwx_staff_qrcode>img{
		position:absolute;
		top:50%;
		left:50%;
		width:70%;
		height:auto;
		transform: translate(-50%,-50%);
	}

	.bind-mobile{
		position: absolute;
		top: 0;
		background: #ffffff;
		bottom: 0;
		right: 0;
		left: 0;
		z-index: 100;
		text-align:center;
	}
	.bind-mobile-button{
		display:inline-block;
		background-color: #1ed9b4;
		color:white;
		padding:1rem 2rem;
		border-radius: 0.5rem;
	}
	.commondrug-enter{	
		text-align: center;
		font-size: 15px;
		line-height: 30px;
		color: white;
		background: #67beb2;
	}
	.swiper_bg_pagination{
		display: flex;
		justify-content: center;
		padding: 5px 0;
	}
	.tgSwiper{
		height: 1em;
		line-height: 1.4rem;
		overflow: hidden;
	}
	.tgSwipe .swiper-slide{
		height: 1em;
	}
