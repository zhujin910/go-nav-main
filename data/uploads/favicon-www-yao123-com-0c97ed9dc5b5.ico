        margin-right: 0 !important;
    }
</style>
<script>
// 首先，确保你的页面已经加载了jQuery库
$(document).ready(function() {
    // 使用click方法监听所有class为'tab'的元素的点击事件
    $('.login-btn').click(function() {
        // 阻止默认的点击行为（例如，如果这是一个链接，阻止它打开一个新页面）
        event.preventDefault();

        var mobile = $("#mobile").val();
        var password = $("#password").val();

        var regex = /^1[3-9]\d{9}$/;
        if (!regex.test(mobile)) {
            // 如果手机号格式不正确，显示错误信息
            $('#password-error').text('请输入有效的手机号！');
            return false; // 阻止表单提交
        }

        // 定义正则表达式，匹配8-20位的大小写字母
        var regex = /^[A-Za-z0-9]{8,20}$/;

        // 使用正则表达式验证密码
        if (regex.test(password)) {
            //  密码格式正确 清除之前的错误消息
            $('#password-error').text('');
        } else {
            // 密码格式不正确
            // 显示错误消息
            $('#password-error').text('密码错误');
            return false; // 阻止表单提交
        }

        //发送AJAX请求
        $.ajax({
            url: '/gyt/index/login',  
            type: 'POST',
            data: {  // 在这里填写你需要发送的数据
                mobile:mobile,
                password:password,
            },
            success: function(response) {
                //在这里处理服务器返回的响应
                //'response'变量将包含服务器的响应
                console.log(response);
                if(response.status == 200){
                	window.location.href = response.msg;
                }else{
                	$('#password-error').text(response.msg);
                }
            },
            error: function(error) {
                // 在这里处理请求失败的情况
                console.log('Error:', error);
            }
        });
    });
});
</script>