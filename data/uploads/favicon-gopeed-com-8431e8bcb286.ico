cceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"BT download speed depends on the number of seeders, tracker status and your network environment. Try adding more trackers, checking your firewall and port forwarding settings, and making sure DHT is enabled.\"}},{\"@type\":\"Question\",\"name\":\"Does it support proxy settings?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. You can configure HTTP, SOCKS5 proxies or use system proxy in Gopeed's settings. This is useful when direct connections are limited or when you need to route downloads through a specific network.\"}},{\"@type\":\"Question\",\"name\":\"Is it free? Are there any paid features?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Gopeed is completely free and open source. All core download features are available at no cost, with no ads and no hidden paywalls.\"}},{\"@type\":\"Question\",\"name\":\"Can I manage downloads remotely?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Gopeed provides a RESTful API and a web interface. You can manage download tasks remotely through the API or access the web UI from another device on the same network.\"}}]}]5:[\"$\",\"main\",null,{\"className\":\"min-h-screen stable-vh overflow-x-clip bg-white dark:bg-gray-950 text-gray-900 dark:text-gray-100 relative\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"children\":\"$14\"}],[\"$\",\"div\",null,{\"className\":\"fixed inset-0 -z-10 dark:block hidden\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute inset-0 bg-gradient-to-b from-gray-950 via-gray-900 to-gray-950\"}],[\"$\",\"div\",null,{\"className\":\"absolute inset-0 bg-gradient-radial from-primary-900/20 via-transparent to-transparent opacity-50\"}],\"$L15\",\"$L16\"]}],\"$L17\",\"$L18\",\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\"]}]\n"])</script><script>self.__next_f.push([1,"1e:I[139081,[\"/_next/static/chunks/69b8ed0087505ad1.js\",\"/_next/static/chunks/25f35ce7059ac315.js\",\"/_next/static/chunks/fb