<script type="text/javascript">
    
    
    
    
    
    
   
    
    
    
    
    
    
    
    
    
    
    
    
    $(document).on('mouseover', '#totxt', function () {
        var _this = $(this);
        _this.find('ul').show();
    });
    $(document).on('mouseout', '.txtlist,#totxt', function () {
        var _this = $(this);
        $('.txtlist').hide();
    });
    function topagge(page) {
        var url = '';
        var locl = window.location.href;
        var page = '/' + page;
        if (page == '/position') {
            page += '?pages=' + encodeURIComponent(locl);
        }
        window.location.href = page;
    }
    $(document).on('click', '#showall', function () {
        var _this = $(this);
        $(".erweimabg2").show().addClass('block');
        $(".erweimabg1").hide()
        $('.erweimabg').css({ 'right': '10px' })
    })
    $(document).on('click', 'body', function (e) {
        if (e.target.id != 'showall') {
            var has = $(".erweimabg2").attr('class');
            if (has.indexOf('block') > -1) {
                
                $(".erweimabg2").hide();
                $(".erweimabg1").show();
                $('.erweimabg').css({ 'right': '86px' })
            }
        }
    })

    $(document).on("click", ".searchbtn", function () {
        var value = $("#searchInput").val();
        if (value) {
           
           window.location.href = "/searchfuwu?text=" + value;
        }
    });
    $("input").keyup(function (e) {
        var code = e.keyCode || e.charCode;
        if (code === 13) {
            var value = $("#searchInput").val();
            if (value) {
                
                window.location.href = "/searchfuwu?text=" + value;
            }
        }
    });

</script>

