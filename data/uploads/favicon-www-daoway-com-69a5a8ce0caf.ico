<script>

    $(document).on('mouseover', '.navname', function () {
        var _this = $(this);
        _this.addClass('navnamebg');
        var top = 0;
        if (_this.index() > 0) {
            top = (_this.index()) * -30;
        }
        _this.find('ul').show().css('top', top);
        _this.find('img').addClass('act')[0].src = 'https://image.daoway.cn/img/static/img/icon1.png';
    });
    $(document).on('mouseout', '.navname', function () {
        var _this = $(this);
        _this.removeClass('navnamebg');
        _this.find('ul').hide();
        _this.find('img').removeClass('act')[0].src = 'https://image.daoway.cn/img/static/img/right.png';
    });

    $(document).on('mouseover', '.navname li', function () {
        var _this = $(this);
        _this.css('background', '#c4333b')
    });
    $(document).on('mouseout', '.navname li', function () {
        var _this = $(this);
        _this.css('background', '')
    });
    $(document).on('click', '.shopList', function () {
        $('.toast').show();
        window.setTimeout(function () {
            $('.toast').hide();
        }, 2000)
    });
</script>
