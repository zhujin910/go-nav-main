        .new-list-tag.new-list-tag-disabled {
            background: #ccc !important;
            cursor: pointer;
            text-decoration: none;
        }
        .new-list-tag.new-list-tag-disabled:hover { opacity: .85; color: #fff; }
        /* 移动端：标题占满宽度、字号略小，确保长名字不裁切 */
        @media (max-width: 480px) {
            .new-list-block .new-list-item {
                padding: 12px 6px;
                gap: 8px 8px;
            }
            .new-list-block .new-list-title {
                font-size: 14px;
