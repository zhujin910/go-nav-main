            }
            .new-list-block .new-list-date {
                font-size: 11px;
                margin-top: 3px;
            }
            .new-list-block .new-list-tag {
                padding: 3px 9px;
                font-size: 12px;
            }
        }
        .new-list-pager {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 6px;
            padding: 10px 8px 14px;
            flex-wrap: wrap;
        }
        .new-list-pager .pg-btn {
            min-width: 32px;
            height: 30px;
            padding: 0 8px;
            border-radius: 6px;
            border: 1px solid #ddd;
            background: #fff;
            color: #555;
            font-size: 13px;
            cursor: pointer;
            transition: all .15s;
        }
        .new-list-pager .pg-btn:hover {
            border-color: #ff6b6b;
            color: #ff6b6b;
        }
        .new-list-pager .pg-btn.active {
            background: linear-gradient(135deg, #ff6b6b, #ff8e53);
            border-color: #ff6b6b;
            color: #fff;
        }
        .new-list-pager .pg-btn[disabled] {
            opacity: .45;
            cursor: not-allowed;
        }
        .new-list-pager .pg-info {
            font-size: 12px;
            color: #999;
            margin: 0 4px;
        }
    </style>

    <script>
    (function () {
        var block = document.querySelector('.new-list-block');
        if (!block) { return; }

        var contentEl = block.querySelector('.new-list-content');
        var pagerEl   = block.querySelector('.new-list-pager');
        var tabEls    = block.querySelectorAll('.new-tab');
        var pageSize  = 20;
        var state = {
            cat: 'yingshi',
            page: 1,
            data: null,
            hasContent: false   // 是否已有数据，用于判断加载时是否清空
        };

        // API 基础地址：新资源管理系统API
        var API_BASE = 'https://zjsc.jnnsou.com/api/resources.php';

        // 调试模式：控制台打印请求 URL，方便排查 404 等问题
        var DEBUG = false;

        // HTML 转义
        function esc(s) {
            return String(s == null ? '' : s)
                .replace(/&/g, '&amp;').replace(/</g, '&lt;')
                .replace(/>/g, '&gt;').replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        // 合并 baidu / kuake / xunlei 三个数组：按剧名 name 分组合并，
        // 同一剧名只占一行，每行展示该剧名可用的所有平台标签
        function mergeData(data) {
            var map = new Map();
            function add(type, it) {
                if (!it || !it.name) return;
                var link = it[type];
                if (!link) return;
                var entry = map.get(it.name);
                if (!entry) {
                    entry = { name: it.name, date: it.last_update || '', baidu: '', kuake: '', xunlei: '' };
                    map.set(it.name, entry);
                }
                // 同平台已有链接就不覆盖（保留第一条）
                if (!entry[type]) entry[type] = link;
            }
            (data && data.baidu  || []).forEach(function (it) { add('baidu',  it); });
            (data && data.kuake  || []).forEach(function (it) { add('kuake',  it); });
            (data && data.xunlei || []).forEach(function (it) { add('xunlei', it); });
            return Array.from(map.values());
        }

        // 类型映射：网盘类型 → is_type（用于弹窗显示）
        var TYPE_MAP = { baidu: 2, kuake: 0, xunlei: 4 };

        // 弹窗中渲染 QR 码
        function renderQrCode(data) {
            if (!data || typeof qrcanvas === 'undefined') { return; }
            setTimeout(function () {
                var el = document.getElementById('qrcode');
                if (!el) { return; }
                el.innerHTML = '';
                try {
                    var canvas = qrcanvas.qrcanvas({ data: data, size: 120 });
                    el.appendChild(canvas);
                } catch (e) {
                    console.warn('[NewList] QR 渲染失败', e);
                }
            }, 200);
        }

        // 失效关键词（与 list.html 保持一致）
        var INVALID_KEYWORDS = [
            '可能因为涉及侵权',
            '分享者用户封禁链接查看受限',
            '已取消',
            '过期',
            '分享已删除',
            '文件涉及违规内容',
            '链接不存在或提取码错误',
            '链接失效或缺少提取码或访问频繁风控',
            '分享地址已失效',
            '好友已取消了分享'
        ];

        // 转存/分享：最多重试 3 次「转存失败，请重新获取」（百度网盘接口偶发）
        var TRANSFER_RETRY_KEYWORDS = ['转存失败，请重新获取'];
        var TRANSFER_MAX_RETRY = 3;

        // ========= 失效链接服务端存储（所有用户共享，仅用 qf_invalid_resources 表） =========
        // 页面加载时调用 GET /api/other/get_invalid_urls 拉取所有用户上报的失效 URL
        // 这样每个用户都能看到其他人标记过的失效资源
        var invalidUrlsFromServer = {};  // { url: true, ... }
        var invalidUrlsServerLoaded = false;  // 是否已加载完

        function loadInvalidUrlsFromServer() {
            try {
                axios.get('/api/other/get_invalid_urls').then(function (res) {
                    if (res.data && res.data.code == 200 && Array.isArray(res.data.data)) {
                        invalidUrlsFromServer = {};
                        for (var i = 0; i < res.data.data.length; i++) {
                            var it = res.data.data[i];
                            // API优化后返回简单字符串数组，直接使用
                            if (it) { invalidUrlsFromServer[it] = true; }
                        }
                        invalidUrlsServerLoaded = true;
                        if (DEBUG) {
                            console.log('[NewList] 已从服务端拉取失效链接', Object.keys(invalidUrlsFromServer).length, '条');
                        }
                        // 如果首页数据已加载，重新应用失效标记 + 重新渲染
                        if (state && state.data && state.data.length) {
                            applyInvalidFromStore(state.data);
                            applyState();
                        }
                    }
                }).catch(function (err) {
                    if (DEBUG) console.warn('[NewList] 拉取服务端失效链接失败', err);
                });
            } catch (e) { /* 忽略 */ }
        }

        // 把已知的失效 URL 应用到当前数据：自动打 invalid_<type> 标记
        // 失效来源：服务端 qf_invalid_resources 表（所有用户共享，不再使用 localStorage）
        function applyInvalidFromStore(list) {
            if (!list || !list.length) { return list; }
            var has = function (u) {
                return !!(u && invalidUrlsFromServer[u]);
            };
            for (var i = 0; i < list.length; i++) {
                var it = list[i];
                var types = ['baidu', 'kuake', 'xunlei'];
                var allInvalid = true;
                var hasAny = false;
                for (var j = 0; j < types.length; j++) {
                    var t = types[j];
                    if (!it[t]) { continue; }
                    hasAny = true;
                    if (has(it[t])) {
                        it['invalid_' + t] = true;
                    } else {
                        allInvalid = false;
                    }
                }
                if (hasAny && allInvalid) { it.is_invalid = true; }
            }
            return list;
        }

        function getResourceUrl(name, type, url) {
            // 走 /api/other/save_url 转存/分享，复用 list.html 同一套对话框
            if (typeof app === 'undefined' || !app) {
                window.open(url, '_blank');
                return;
            }

            // 把原始 URL 放进 dialogItem 备用
            app.dialogItem = {
                title: name,
                url: url,
                is_type: TYPE_MAP[type] || 0,
                showUrl: '',
                message: '',
                is_local: false,
                is_invalid: false,
                fromNewList: true   // 标记来源：首页最新列表（弹窗据此判断是否显示「前往全网搜索」）
            };
            app.dialogLoading = true;
            app.dialogUrl = true;

            // 走带重试的转存流程（首次）
            tryTransferResource(name, type, url, 1);
        }

        // 带重试的转存分享
        // 命中 TRANSFER_RETRY_KEYWORDS 时自动重试（最多 TRANSFER_MAX_RETRY 次）
        // 重试期间保持 dialogLoading=true，对用户透明
        function tryTransferResource(name, type, url, attempt) {
            app.dialogLoading = true;
            axios.post('/api/other/save_url', {
                url: encodeURIComponent(url || ''),
                title: name || ''
            }).then(function (res) {
                if (res.data && res.data.code == 200) {
                    app.dialogItem.url = res.data.data.url;
                    app.dialogItem.showUrl = res.data.data.url;
                    app.dialogLoading = false;
                    renderQrCode(res.data.data.url);
                    return;
                }

                var message = (res.data && res.data.message) || '转存失败';
                // 命中「转存失败，请重新获取」且未到上限 → 静默重试
                var isRetryable = TRANSFER_RETRY_KEYWORDS.some(function (k) { return message.indexOf(k) !== -1; });
                if (isRetryable && attempt < TRANSFER_MAX_RETRY) {
                    if (DEBUG) {
                        console.log('[NewList][转存] 第 ' + attempt + ' 次返回：' + message + '，准备第 ' + (attempt + 1) + ' 次重试');
                    }
                    setTimeout(function () { tryTransferResource(name, type, url, attempt + 1); }, 600);
                    return;
                }

                // 重试耗尽 或 其他错误 → 显示真实结果
                app.dialogItem.showUrl = '';
                app.dialogItem.message = message;

                // 与 list.html 一致：检测失效关键词
                var isInvalid = INVALID_KEYWORDS.some(function (k) { return message.indexOf(k) !== -1; });
                // 额外：服务器偶尔只返回纯字符串"转存失败"，也判定为失效
                if (!isInvalid && message === '转存失败') {
                    isInvalid = true;
                }
                if (isInvalid) {
                    app.dialogItem.is_invalid = true;
                    markItemInvalid(name, type);
                }
                app.dialogLoading = false;
            }).catch(function (err) {
                app.dialogLoading = false;
                app.dialogItem.showUrl = '';
                app.dialogItem.message = '网络错误，请重试';
            });
        }

        // 把 state.data 中 (name, type) 标记为失效，并刷新列表
        function markItemInvalid(name, type) {
            if (!state.data) { return; }
            var item = null;
            for (var i = 0; i < state.data.length; i++) {
                if (state.data[i].name === name) { item = state.data[i]; break; }
            }
            if (!item) { return; }
            item['invalid_' + type] = true;
            // ① 本会话内立刻把 URL 加入服务端内存集合（刷新前立即生效）
            if (item[type]) { invalidUrlsFromServer[item[type]] = true; }
            // 整行失效判断：所有平台都失效了
            var types = ['baidu', 'kuake', 'xunlei'];
            var allInvalid = types.every(function (t) {
                return !item[t] || item['invalid_' + t];
            });
            if (allInvalid) { item.is_invalid = true; }
            // 走 applyState() 保持分页 + 排序一致
            applyState();
            // ② 持久化到服务器 qf_invalid_resources 表（所有用户共享）
            axios.post('/api/other/save_invalid_url', {
                url: item[type] || '',
                title: name || '',
                is_type: TYPE_MAP[type] || 0
            }).catch(function () { /* 静默 */ });
        }

        // 把 "2026-06-05 22:48:26" 或 Date 转成时间戳（用于排序）
        function toTs(s) {
            if (!s) return 0;
            var t = Date.parse(String(s).replace(/-/g, '/'));
            return isNaN(t) ? 0 : t;
        }

        // 把 "2026-06-05 14:30:26" 转成 "06月05日 14:30"
        // 没时间就只显示 "06月05日"
        function formatDate(d) {
            if (!d) return '';
            var str = String(d);
            var m = str.match(/(\d{4})-(\d{2})-(\d{2})(?:[\sT](\d{1,2}):(\d{1,2})(?::\d{1,2})?)?/);
            if (!m) return '';
            var out = m[2] + '月' + m[3] + '日';
            if (m[4] != null && m[5] != null) {
                // 补零
                var hh = ('0' + m[4]).slice(-2);
                var mm = ('0' + m[5]).slice(-2);
                out += ' ' + hh + ':' + mm;
            }
            return out;
        }

        // 统一处理：排序 + 分页 + 渲染列表 + 渲染分页器
        // 所有数据状态变更（首次加载 / 翻页 / 失效标记）都走这里
        function applyState() {
            if (!state.data) { return; }
            // 最新更新时间排最上方（降序）
            var sorted = state.data.slice().sort(function (a, b) {
                return toTs(b.date) - toTs(a.date);
            });
            var start = (state.page - 1) * pageSize;
            var pageList = sorted.slice(start, start + pageSize);
            renderList(pageList);
            renderPager(sorted.length, state.page);
        }

        function renderList(list) {
            if (!list.length) {
                contentEl.innerHTML = '<div class="new-list-empty">暂无数据</div>';
                return;
            }
            var typeMap = { baidu: '获取百度', kuake: '获取夸克', xunlei: '获取迅雷' };
            var invalidTypeMap = { baidu: '百度', kuake: '夸克', xunlei: '迅雷' };
            var html = list.map(function (it) {
                var dateStr = formatDate(it.date);
                var dateHtml = dateStr
                    ? '<div class="new-list-date">更新时间：' + esc(dateStr) + '</div>'
                    : '';
                // 整行失效：标题前加红色 [失效] 标签
                var invalidPrefix = it.is_invalid
                    ? '<span class="new-list-invalid-tag">[失效]</span> '
                    : '';
                var itemClass = 'new-list-item' + (it.is_invalid ? ' new-list-item-invalid' : '');
                var tags = [];
                ['baidu', 'kuake', 'xunlei'].forEach(function (t) {
                    if (!it[t]) { return; }
                    if (it['invalid_' + t]) {
                        // 单个平台失效：渲染为可点击链接（点击后弹出失效提示 + 前往全网搜索）
                        tags.push(
                            '<a class="new-list-tag new-list-tag-disabled ' + t + '" ' +
                            'data-url="' + esc(it[t]) + '" ' +
                            'data-type="' + t + '" ' +
                            'data-name="' + esc(it.name) + '" ' +
                            'data-invalid="1" ' +
                            'href="javascript:void(0);" rel="nofollow">' +
                            invalidTypeMap[t] + '已失效</a>'
                        );
                    } else {
                        tags.push(
                            '<a class="new-list-tag ' + t + '" data-url="' + esc(it[t]) +
                            '" data-type="' + t + '" data-name="' + esc(it.name) +
                            '" href="javascript:void(0);" rel="nofollow">' + typeMap[t] + '</a>'
                        );
                    }
                });
                return ''
                    + '<div class="' + itemClass + '">'
                    +   '<div class="new-list-main">'
                    +     '<div class="new-list-title">' + invalidPrefix + esc(it.name) + '</div>'
                    +     dateHtml
                    +   '</div>'
                    +   '<span class="new-list-tags">' + tags.join('') + '</span>'
                    + '</div>';
            }).join('');
            contentEl.innerHTML = html;
        }

        function renderPager(total, page, opts) {
            var totalPages = Math.max(1, Math.ceil(total / pageSize));
            var loadingHtml = (opts && opts.loading)
                ? '<span class="new-list-loading-inline">加载中</span>'
                : '';
            if (totalPages <= 1) {
                pagerEl.innerHTML = loadingHtml;
                return;
            }
            var html = loadingHtml;
            html += '<button class="pg-btn" data-pg="' + (page - 1) + '" ' + (page <= 1 ? 'disabled' : '') + '>上一页</button>';
            // 最多显示 7 个页码
            var start = Math.max(1, page - 3);
            var end   = Math.min(totalPages, start + 6);
            start = Math.max(1, end - 6);
            if (start > 1) {
                html += '<button class="pg-btn" data-pg="1">1</button>';
                if (start > 2) html += '<span class="pg-info">…</span>';
            }
            for (var i = start; i <= end; i++) {
                html += '<button class="pg-btn ' + (i === page ? 'active' : '') + '" data-pg="' + i + '">' + i + '</button>';
            }
            if (end < totalPages) {
                if (end < totalPages - 1) html += '<span class="pg-info">…</span>';
                html += '<button class="pg-btn" data-pg="' + totalPages + '">' + totalPages + '</button>';
            }
            html += '<button class="pg-btn" data-pg="' + (page + 1) + '" ' + (page >= totalPages ? 'disabled' : '') + '>下一页</button>';
            html += '<span class="pg-info">共 ' + total + ' 条</span>';
            pagerEl.innerHTML = html;
        }

        function load(cat, page) {
            state.cat = cat;
            state.page = page;

            // 区分首次加载 / 切换分类 vs 翻页
            // 翻页时保留原列表内容，只在分页区显示小加载提示，避免闪白
            var isFirst = !state.hasContent;

            if (isFirst) {
                contentEl.innerHTML = '<div class="new-list-loading">加载中...</div>';
                pagerEl.innerHTML = '';
            } else {
                // 翻页：保留旧数据，分页区显示「加载中」小转圈
                renderPager(state.data ? state.data.length : 0, page, { loading: true });
            }

            // 优先请求所有资源（?all=1），接口不支持时回退到最近 3 天
            // 新API格式: ?all=1&type=tv&page=1&per_page=60
            // 类型映射: yingshi→tv, dianying→movie, qita→other
            var typeParam = cat === 'yingshi' ? 'tv' : (cat === 'dianying' ? 'movie' : 'other');
            var url = API_BASE + '?all=1&type=' + encodeURIComponent(typeParam) + '&page=1&per_page=60&_t=' + Date.now();
            if (DEBUG) { console.log('[NewList] GET', url); }

            function fetchData(u) {
                var p = (typeof fetch === 'function')
                    ? fetch(u, { method: 'GET', mode: 'cors', credentials: 'omit' })
                        .then(function (r) {
                            if (!r.ok) { throw new Error('HTTP ' + r.status); }
                            return r.json();
                        })
                    : axios.get(u).then(function (r) { return r.data; });
                return p;
            }

            fetchData(url)
                .then(function (data) {
                    // 新API数据格式: { data: [...] } 直接是数组
                    var resources = (data && data.data) || [];
                    // 转换为旧格式以兼容现有渲染逻辑
                    var d = { baidu: [], kuake: [], xunlei: [] };
                    resources.forEach(function (it) {
                        var links = it.links || {};
                        if (links.baidu && links.baidu.url) {
                            d.baidu.push({ name: it.name, baidu: links.baidu.url, last_update: it.updated_at });
                        }
                        if (links.quark && links.quark.url) {
                            d.kuake.push({ name: it.name, kuake: links.quark.url, last_update: it.updated_at });
                        }
                        if (links.xunlei && links.xunlei.url) {
                            d.xunlei.push({ name: it.name, xunlei: links.xunlei.url, last_update: it.updated_at });
                        }
                    });
                    var merged = mergeData(d);
                    applyInvalidFromStore(merged);
                    state.data = merged;
                    state.hasContent = true;
                    applyState();
                })
                .catch(function (err) {
                    if (DEBUG) { console.warn('[NewList] all 失败，回退 recent', err); }
                    // 回退到最近 3 天
                    var url2 = API_BASE + '?recent=3&type=' + encodeURIComponent(typeParam) + '&_t=' + Date.now();
                    fetchData(url2)
                        .then(function (data) {
                            var resources = (data && data.data) || [];
                            var d = { baidu: [], kuake: [], xunlei: [] };
                            resources.forEach(function (it) {
                                var links = it.links || {};
                                if (links.baidu && links.baidu.url) {
                                    d.baidu.push({ name: it.name, baidu: links.baidu.url, last_update: it.updated_at });
                                }
                                if (links.quark && links.quark.url) {
                                    d.kuake.push({ name: it.name, kuake: links.quark.url, last_update: it.updated_at });
                                }
                                if (links.xunlei && links.xunlei.url) {
                                    d.xunlei.push({ name: it.name, xunlei: links.xunlei.url, last_update: it.updated_at });
                                }
                            });
                            var merged = mergeData(d);
                            applyInvalidFromStore(merged);
                            state.data = merged;
                            state.hasContent = true;
                            applyState();
                        })
                        .catch(function (err2) {
                            if (DEBUG) { console.error('[NewList] 失败', err2); }
                            var msg = err2 && err2.message ? err2.message : (err2 || '网络错误');
                            contentEl.innerHTML = '<div class="new-list-empty">加载失败：' + esc(msg) + '</div>';
                            state.hasContent = false;
                        });
                });
        }

        // Tab 点击
        tabEls.forEach(function (el) {
            el.addEventListener('click', function () {
                tabEls.forEach(function (t) { t.classList.remove('active'); });
                el.classList.add('active');
                // 切换分类视为首次加载（清空 + 居中加载中）
                state.hasContent = false;
                load(el.getAttribute('data-cat'), 1);
            });
        });

        // 分页点击
        pagerEl.addEventListener('click', function (e) {
            var btn = e.target.closest('.pg-btn');
            if (!btn || btn.disabled) { return; }
            var p = parseInt(btn.getAttribute('data-pg'), 10);
            if (!p || p < 1) { return; }
            load(state.cat, p);
        });

        // 标签点击（事件委托）：调 /api/other/save_url 转存后弹出分享对话框
        // 失效标签（data-invalid="1"）：直接弹出失效提示弹窗 + 「前往全网搜索」
        contentEl.addEventListener('click', function (e) {
            var tag = e.target.closest('.new-list-tag');
            if (!tag) { return; }
            e.preventDefault();
            var item = tag.closest('.new-list-item');
            if (!item) { return; }
            var titleEl = item.querySelector('.new-list-title');
            var name = titleEl ? titleEl.textContent : '';
            var url = tag.getAttribute('data-url') || '';
            var type = tag.getAttribute('data-type') || '';
            var isInvalid = tag.getAttribute('data-invalid') === '1';

            if (isInvalid) {
                // 失效资源：跳过转存，直接显示失效提示 + 前往全网搜索
                showNewListInvalidDialog(name, type, url);
            } else {
                getResourceUrl(name, type, url);
            }
        });

        // 首页失效标签：弹出失效提示（与「前往全网搜索」共用弹窗）
        function showNewListInvalidDialog(name, type, url) {
            // type 可能是 baidu/kuake/xunlei，转成 is_type 数值（与 list.html 对齐：0夸克/2百度/4迅雷）
            var typeNum = 0;
            if (type === 'baidu')  { typeNum = 2; }
            else if (type === 'kuake')  { typeNum = 0; }
            else if (type === 'xunlei') { typeNum = 4; }

            app.dialogItem = {
                title: name,
                name: name,
                url: url || '',
                is_type: typeNum,
                showUrl: '',
                message: '该资源可能已失效',
                is_local: false,
                is_invalid: true,
                fromNewList: true
            };
            app.dialogLoading = false;
            app.dialogUrl = true;
        }

        // 拉取服务端共享的失效链接（所有用户都能看到其他人标记过的失效资源）
        // 必须在 IIFE 内部调用，依赖 IIFE 内的 state/applyInvalidFromStore
        loadInvalidUrlsFromServer();

        // 首次加载
        load('yingshi', 1);
    })();
    </script>

