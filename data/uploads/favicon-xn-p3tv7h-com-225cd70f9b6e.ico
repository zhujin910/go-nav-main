        .new-list-tag:hover { opacity: .8; color: #fff; }
        .new-list-tag.kuake { background: #4dabf7; }
        .new-list-tag.baidu  { background: #ff6b6b; }
        .new-list-tag.xunlei { background: #845ef7; }
        /* ========= 失效态：与 list.html 同步 ========= */
        .new-list-item.new-list-item-invalid {
            border-left: 3px solid #ff4d4f;
            padding-left: 10px;
