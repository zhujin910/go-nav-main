        }
        @keyframes newListSpin {
            to { transform: rotate(360deg); }
        }
        .new-list-item {
            display: flex;
            flex-wrap: wrap;
            align-items: flex-start;
            padding: 10px 6px;
            border-bottom: 1px dashed #eee;
            gap: 8px 10px;
        }
        .new-list-item:last-child { border-bottom: none; }
        .new-list-main {
            flex: 1 1 auto;
            min-width: 0;
        }
        .new-list-title {
            font-size: 15px;
            color: #333;
