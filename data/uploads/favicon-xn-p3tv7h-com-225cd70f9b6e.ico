    <script src="/views/index/news/common/static/js/vue.global.min.js"></script>
<script src="/views/index/news/common/static/js/index.full.min.js"></script>
<script src="/views/index/news/common/static/js/axios.min.js"></script>
<script src="/views/index/news/common/static/js/qrcanvas@3.js"></script>
<script>
    const { createApp, ref, onMounted, onUnmounted } = Vue;
    const { ElButton, ElMessage  } = ElementPlus;
    const app = createApp({
        setup() {
            // 定义响应式数据
            const elementOpacity = ref(0);
            const scrollThreshold = ref(150); // 动态设置的滚动阈值
            const keyword = ref('');
            const qcodeVisible = ref(false);
            const layerVisible = ref(false);
            const content = ref('');
            const load = ref(false)
            const drawer = ref(false)
            const rankList = ref([]);
            const rankDj = ref([]);
            const is_m = ref(0);
            const newList = ref([]);
            const QList = ref([]);
            const QLoading = ref(false);
            const total_result = ref(0);
            const currentSource = ref(0);
            const dialogUrl = ref(false);
            const dialogLoading = ref(false);
            const dialogItem = ref({});
            const is_type = ref(0);
            const pc_type = ref(0);
            
            
            // 公共消息方法
            const showMessage = (message, type = 'info') => {
                ElMessage({
                    message,
                    type,
                    plain: true,
                });
            };


             // 滚动监听方法
            const handleScroll = () => {
                const scrollTop = window.scrollY || document.documentElement.scrollTop;
                elementOpacity.value = scrollTop >= scrollThreshold.value
                    ? Math.min((scrollTop - scrollThreshold.value) / 100, 1)
                    : Math.max(1 - (scrollThreshold.value - scrollTop) / 100, 0);
    
                const boxElement = document.querySelector('.listBox .screen .fixed .box');
                if (boxElement.style.display === 'block' && is_m.value) {
                    boxElement.style.display = 'none'; // 隐藏元素
                }
            };

            // 搜索按钮点击事件
            // 从「全网搜」简化版（URL 带 ?from=newlist）点击搜索时，必须跳到正常的搜索结果页
            // 所以 targetUrl 显式不携带 from 参数，确保跳转到 list.html 完整版
            const searchBtn = () => {
                if (!keyword.value) {
                    return showMessage('请输入你要搜索的内容~', 'error');
                }
                const currentUrl = window.location.href;
                const targetUrl = `/s/${keyword.value}.html`;
                if (currentUrl.includes('/s/') || currentUrl.includes('/d/')) {
                    window.location.href = targetUrl;
                } else {
                    window.open(targetUrl, '_blank');
                }
            };
            
            // 保存按钮点击事件
            const saveBtn = async () => {
                if (!content.value) {
                    return showMessage('请输入你想看的资源信息~', 'error');
                }
                if (load.value) return;
    
                load.value = true;
                try {
                    const response = await axios.post('/api/tool/feedback', { content: content.value });
                    showMessage(response.data.message, response.data.code === 200 ? 'success' : 'error');
                    if (response.data.code === 200) {
                        layerVisible.value = false;
                        content.value = '';
                    }
                } finally {
                    load.value = false;
                }
            };
            
            const setnum = (num) => (num / 10000).toFixed(2) + 'W';
            
            const goLink = (event,id) => {
                event.preventDefault();
                window.location.href = `/d/${id}.html`;
            }
            
            const changeBtn = (e) => {
                const category_id = `0`;
                if(category_id){
                    window.location.href = `/s/${keyword.value}-${e}-${category_id}.html`;
                }else{
                    window.location.href = `/s/${keyword.value}-${e}.html`;
                }
            };
            
            const copyText = async(event,title,url,code) => {
                event.preventDefault();
                var text = '标题：'+title+'\n链接：'+url
                if (code) text += `\n提取码：${code}`;
                text += `\n由【${'许搜 - 全网影视资源'}${window.location.hostname}】提供网盘分享链接`;
                
                
                try {
                    // 优先使用 navigator.clipboard
                    await navigator.clipboard.writeText(text);
                    showMessage('复制成功', 'success');
                } catch (err) {
                    // 如果 navigator.clipboard 失败，使用 document.execCommand 作为回退
                    const textArea = document.createElement('textarea');
                    textArea.value = text;
                    textArea.style.position = 'fixed';  // 避免滚动
                    textArea.style.opacity = 0;
                    document.body.appendChild(textArea);
                    textArea.focus();
                    textArea.select();
            
                    try {
                        const successful = document.execCommand('copy');
                        if (successful) {
                            showMessage('复制成功', 'success');
                        } else {
                            throw new Error('复制失败');
                        }
                    } catch (err) {
                        showMessage('复制失败，请手动复制', 'error');
                    }
            
                    document.body.removeChild(textArea);
                }
            }
            
            const copyLink = async(link) => {
                try {
                    // 优先使用 navigator.clipboard
                    await navigator.clipboard.writeText(link);
                    showMessage('链接复制成功', 'success');
                } catch (err) {
                    // 如果 navigator.clipboard 失败，使用 document.execCommand 作为回退
                    const textArea = document.createElement('textarea');
                    textArea.value = link;
                    textArea.style.position = 'fixed';  // 避免滚动
                    textArea.style.opacity = 0;
                    document.body.appendChild(textArea);
                    textArea.focus();
                    textArea.select();
            
                    try {
                        const successful = document.execCommand('copy');
                        if (successful) {
                            showMessage('链接复制成功', 'success');
                        } else {
                            throw new Error('复制失败');
                        }
                    } catch (err) {
                        showMessage('复制失败，请手动复制', 'error');
                    }
            
                    document.body.removeChild(textArea);
                }
            }
            
            const selectBtn = () => {
                if(!is_m.value) return;
                const boxElement = document.querySelector('.listBox .screen .fixed .box');
                // 切换 display 属性，显示或隐藏
                if (boxElement.style.display === 'none' || boxElement.style.display === '') {
                    boxElement.style.display = 'block'; // 显示
                } else {
                    boxElement.style.display = ''; // 隐藏
                }
            }

            // ========= 失效后跳转全网搜：清洗资源名 =========
            // 去掉「第X部/季/集/期」、画质标签、方括号内容、标点符号、年份、地区、类型标签等
            // 保留剧名主标题（汉字/英文/数字），用作搜索关键词
            const cleanTitleForSearch = (raw) => {
                if (!raw) return '';
                let s = String(raw);

                // 0) 优先提取「」或『』内的内容作为基础标题（外站常用「」包围剧名）
                //    出现多个「」时取第一个最长的匹配
                const quoteMatch = s.match(/[「『]([^」』]+)[」』]/);
                if (quoteMatch) {
                    s = quoteMatch[1].trim();
                }

                // 1) 移除所有成对包裹的方括号/书名号/尖括号/小括号/【】等
                //    （「」已被步骤 0 提取，剩下的【】等通常是标签性内容）
                s = s.replace(/[\[【〔（(<].*?[\]】〕）)>]/g, ' ');

                // 2) 移除「第X部/季/集/期/章/回/话」及变体（X 可为中文数字/阿拉伯数字/无）
                s = s.replace(/第[\s\S]{0,8}?(部|季|集|期|章|回|话)/g, ' ');
                s = s.replace(/(部|季|集|期|章|回|话)\s*\d{1,4}/g, ' ');
                s = s.replace(/\d{1,4}\s*(部|季|集|期|章|回|话)/g, ' ');

                // 3) 移除画质/格式/来源/版本/字幕等标签
                s = s.replace(/(4K|2K|8K|1080[Pp]|720[Pp]|2160[Pp]|1440[Pp]|HD|FHD|UHD|HDR|BD|BluRay|Blu-?ray|DVD|WEB[- ]?DL|WEBRip|HDTV|REMUX|H\.?264|H\.?265|HEVC|AVC|x26[45]|xvid|mp4|mkv|avi|ts|m3u8)/gi, ' ');

                // 4) 移除常见电影/电视剧类型标签
                s = s.replace(/(动作|惊悚|剧情|爱情|喜剧|科幻|战争|悬疑|犯罪|恐怖|纪录|动画|冒险|奇幻|历史|传记|音乐|家庭|武侠|古装|青春|校园|竞技|体育|短片|短剧|综艺|真人秀|脱口秀|纪录片|动漫|电视剧|电影|连续剧)/g, ' ');

                // 5) 移除国家/地区名
                s = s.replace(/(中国大陆|中国|香港|台湾|澳门|美国|英国|法国|德国|意大利|西班牙|葡萄牙|俄罗斯|苏联|日本|韩国|朝鲜|泰国|印度|越南|新加坡|马来西亚|印尼|菲律宾|澳大利亚|新西兰|加拿大|墨西哥|巴西|阿根廷|冰岛|挪威|瑞典|芬兰|丹麦|荷兰|比利时|瑞士|奥地利|爱尔兰|波兰|捷克|匈牙利|希腊|土耳其|以色列|阿联酋|南非|埃及)/g, ' ');

                // 6) 移除 4 位年份（1900-2099）
                s = s.replace(/\b(19|20)\d{2}\b/g, ' ');

                // 7) 移除常见的"自压/官方/中字/中英字幕/双语"等修饰词
                s = s.replace(/(自压|官方|原版|加长|未删减|完整|抢先|抢先版|抢先看|院线|公映|修复|重制|高码率|高码|高画质|低码|中字|中英|双语|国语|粤语|英语|日语|韩语|法语|德语|西班牙语|字幕|内嵌|外挂)/g, ' ');

                // ========= 新增规则：覆盖综艺/短剧/动漫/季播节目常见标记 =========
                // 8) 移除剧种标识（处理"日漫""美剧"等剩余）
                s = s.replace(/(日漫|美漫|韩漫|国漫|港漫|台漫|德剧|美剧|英剧|韩剧|日剧|泰剧|印剧|国产剧|内地剧|港剧|台剧|新加坡剧|网剧|连续剧|电视剧|电影|动漫|番剧|新番|综艺|真人秀|纪录片|短剧|小品)/g, ' ');

                // 9) 移除"完结/超前完结/超前/大结局"等结束标记
                s = s.replace(/(超前完结|超前|大结局|完结)/g, ' ');

                // 10) 移除"含付费超点/加更/加更版"等
                s = s.replace(/(含付费超点|付费超点|含超点|加更|加更版|抢先看|加长版|未删|未删减|修复版|重制版|高燃|超前点映)/g, ' ');

                // 11) 移除"全 N 集/期"形式的总集数标记
                s = s.replace(/全\s*\d{1,4}\s*(集|期|话|回|章|话|篇|部)/g, ' ');

                // 12) 移除"更新 X/Y [集/期]"形式的更新进度标记
                s = s.replace(/更新?\s*\d{1,4}\s*[\/／]\s*\d{1,4}\s*(集|期|话|回|章|篇|部)?/g, ' ');

                // 13) 移除"附X季/集/期"（如"附前8季""附第一季""附前 1 季"）
                s = s.replace(/附[前后上下]?\s*\d{1,4}\s*(季|集|期|部|话|回|章|篇)/g, ' ');
                s = s.replace(/附[前后上下]?\s*第?\s*[一二三四五六七八九十百千零\d]{1,4}\s*(季|集|期|部|话|回|章|篇)/g, ' ');

                // 14) 移除"豆瓣评分"（如"豆瓣9.6分""豆瓣 9 分"）
                s = s.replace(/豆瓣\s*\d+(\.\d+)?\s*分?/g, ' ');

                // 15) 移除"更"系列更新标记
                //    更200 / 更 200 / 更6.6 / 更 5.31期 / 更5.31期 / 更 第 12 期
                s = s.replace(/更\s*第?\s*\d{1,4}(\.\d+)?\s*期?/g, ' ');

                // 16) 移除单独的"X期" / "X集" / "X话" / "X回"（无"第"字）
                s = s.replace(/(^|\s)\d{1,4}(\.\d+)?\s*期/g, ' ');
                s = s.replace(/(^|\s)\d{1,4}\s*集/g, ' ');
                s = s.replace(/(^|\s)\d{1,4}\s*话/g, ' ');
                s = s.replace(/(^|\s)\d{1,4}\s*回/g, ' ');
                s = s.replace(/(^|\s)\d{1,4}\s*章/g, ' ');

                // 17) 移除"X部"（"第3部" / "第三部"）
                s = s.replace(/第\s*[一二三四五六七八九十百千零\d]{1,4}\s*部/g, ' ');

                // 18) 移除多余的"/ \ | , ， 、 ; ； . 。 - — _ · •"等分隔符
                s = s.replace(/[\/\\|,，、;；。·•\.——\-_]+/g, ' ');

                // 19) 移除所有剩余标点符号（保留汉字、英文、数字、空格）
                s = s.replace(/[^\w\s\u4e00-\u9fa5]/g, ' ');

                // 20) 多空格合并 + 去首尾
                s = s.replace(/\s+/g, ' ').trim();

                return s;
            };

            // 失效弹窗 → 前往全网搜索 的目标 URL
            // 仅在 dialogItem.fromNewList（即首页最新列表）下生效
            // ?from=newlist 用来让 list.html 切换为简化版（标题"全网搜"+只显示输入框/按钮/温馨提示）
            // URL 不携带清洗后的名字，让用户自己输入关键词
            const goAllSearchHref = (item) => {
                return '/s/?from=newlist';
            };
            
            const handleDeviceType = () => {
                const isMobile = window.matchMedia('(max-width: 768px)').matches;
                if (isMobile) {
                    // 手机端的逻辑
                    is_m.value = 1
                    pc_type.value = 1
                } else {
                    // 电脑端的逻辑
                    is_m.value = 0
                    pc_type.value = '0';
                }
            };


            // 组件挂载时添加滚动监听
            onMounted(() => {
                handleDeviceType();
                
                window.addEventListener('scroll', handleScroll);
                window.addEventListener('resize', handleDeviceType);
            });

            // 组件卸载时移除滚动监听
            onUnmounted(() => {
                window.removeEventListener('scroll', handleScroll);
                window.removeEventListener('resize', handleDeviceType);
            });

            // 返回数据和方法
            return { elementOpacity, scrollThreshold, keyword, searchBtn, rankList,newList, setnum, qcodeVisible, layerVisible, content, saveBtn, rankDj,goLink,changeBtn,copyText,copyLink,drawer,selectBtn,is_m,QList,QLoading,total_result,currentSource,dialogUrl,dialogLoading,dialogItem,is_type,pc_type, cleanTitleForSearch, goAllSearchHref };
        }
    })
    .use(ElementPlus) // 使用 Element Plus
    .mount('#app'); // 挂载 Vue 实例
</script>
    <script type="text/javascript" charset="utf-8">
        app.rankList = JSON.parse('[{"source_category_id":3,"name":"电视剧","image":"","is_sys":1,"is_type":0},{"source_category_id":1,"name":"短剧","image":"","is_sys":1,"is_type":0},{"source_category_id":4,"name":"动漫","image":"","is_sys":1,"is_type":0},{"source_category_id":2,"name":"电影","image":"","is_sys":1,"is_type":0},{"source_category_id":5,"name":"综艺","image":"","is_sys":1,"is_type":0}]');

        // 检测是否在微信/QQ内置浏览器中
        function isWeChatOrQQBrowser() {
            var ua = navigator.userAgent.toLowerCase();
            return ua.indexOf('micromessenger') !== -1 || ua.indexOf('qq/') !== -1;
        }
        
        // 复制链接到剪贴板
        function copyRedirectLink() {
            var linkInput = document.getElementById('redirect-link');
            linkInput.select();
            linkInput.setSelectionRange(0, 99999); // 移动设备兼容
            
            try {
                var successful = document.execCommand('copy');
                if (successful) {
                    alert('链接已复制到剪贴板！请打开浏览器粘贴访问。');
                } else {
                    alert('复制失败，请手动选择并复制链接。');
                }
            } catch (err) {
                alert('复制失败，请手动选择并复制链接。');
            }
        }
        
        // 关闭微信/QQ防红提示
        function closeWechatRedirectModal() {
            document.getElementById('wechat-redirect-modal').style.display = 'none';
        }
        
        // 弹窗相关函数
        function closeWelcomeModal() {
            document.getElementById('welcome-modal').style.display = 'none';
        }
        
        // 搜索影视函数（跳转到影视搜索结果页）
        function searchMovie() {
            const keyword = app.keyword || '';
            if (!keyword.trim()) {
                alert('请输入搜索关键词！');
                return;
            }
            
            // 跳转到影视搜索结果页，保持原逻辑
            // 注意：这里的跳转路径需要根据实际路由调整
            window.location.href = `/s/${encodeURIComponent(keyword)}.html`;
        }
        
        // 搜索小说函数（跳转到蓝奏云搜索页）
        function searchNovel() {
            const keyword = app.keyword || '';
            if (!keyword.trim()) {
                alert('请输入搜索关键词！');
                return;
            }
            
            // 跳转到蓝奏云搜索页面，传递关键词参数
            // 从配置中读取跳转地址
            const novelUrl = 'https://junxs.top/';
            window.location.href = `${novelUrl}?keyword=${encodeURIComponent(keyword)}`;
        }
        
        // 修改原搜索按钮功能，默认为搜索影视
        app.searchBtn = function() {
            searchMovie();
        };
        
        // 页面加载完成后检测浏览器环境
        document.addEventListener('DOMContentLoaded', function() {
            // 从URL参数中获取关键词（如果有的话）
            const urlParams = new URLSearchParams(window.location.search);
            const keywordFromUrl = urlParams.get('keyword');
            if (keywordFromUrl && app) {
                app.keyword = decodeURIComponent(keywordFromUrl);
            }
            
            // 从配置中读取防红和弹窗开关
            const antiRedEnable = parseInt('1');
            const popupEnable = parseInt('0');
            
            // 详细的浏览器检测
            function isWeChatOrQQBrowser() {
                var ua = navigator.userAgent.toLowerCase();
                // 严格检测：只匹配微信和QQ内置浏览器
                return ua.indexOf('micromessenger') !== -1 || 
                       (ua.indexOf('qq/') !== -1 && ua.indexOf('mqqbrowser') !== -1);
            }
            
            if (isWeChatOrQQBrowser() && antiRedEnable === 1) {
                // 在微信/QQ中，显示防红提示，不显示欢迎弹窗
                document.getElementById('wechat-redirect-modal').style.display = 'flex';
                document.body.style.overflow = 'hidden'; // 禁止页面滚动
                // 阻止所有点击事件，防止用户关闭提示
                document.getElementById('wechat-redirect-modal').addEventListener('click', function(e) {
                    e.stopPropagation();
                });
            } else if (popupEnable === 1) {
                // 不在微信/QQ中，显示欢迎弹窗
                setTimeout(function() {
                    document.getElementById('welcome-modal').style.display = 'flex';
                }, 500);
            }
        });
    </script>
    
