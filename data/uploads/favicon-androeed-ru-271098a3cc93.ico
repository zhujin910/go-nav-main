<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Under Construction — Site Maintenance</title>
    <style>
        /* ===== RESET & BASE ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: #0b0e14;
            overflow: hidden;
            position: relative;
        }

        /* ===== ANIMATED BACKGROUND GRID ===== */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background-image: 
                linear-gradient(rgba(0, 255, 200, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 255, 200, 0.03) 1px, transparent 1px);
            background-size: 40px 40px;
            z-index: 0;
            animation: gridPulse 4s ease-in-out infinite;
        }

        @keyframes gridPulse {
            0%, 100% { opacity: 0.4; }
            50% { opacity: 1; }
        }

        /* ===== FLOATING PARTICLES (CIRCUIT DUST) ===== */
        .particle-container {
            position: fixed;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            overflow: hidden;
        }

        .particle {
            position: absolute;
            width: 4px;
            height: 4px;
            background: #00ffc8;
            border-radius: 50%;
            box-shadow: 0 0 12px rgba(0, 255, 200, 0.4);
            animation: floatParticle linear infinite;
            opacity: 0;
        }

        @keyframes floatParticle {
            0% {
                transform: translateY(100vh) translateX(0) scale(0);
                opacity: 0;
            }
            10% { opacity: 0.8; }
            90% { opacity: 0.8; }
            100% {
                transform: translateY(-10vh) translateX(80px) scale(1.2);
                opacity: 0;
            }
        }

        /* ===== MAIN CARD ===== */
        .construction-card {
            position: relative;
            z-index: 1;
            max-width: 820px;
            width: 92%;
            padding: 60px 48px;
            background: rgba(11, 14, 20, 0.75);
            backdrop-filter: blur(24px) saturate(1.4);
            border-radius: 48px;
            border: 1px solid rgba(0, 255, 200, 0.15);
            box-shadow: 
                0 30px 80px rgba(0, 0, 0, 0.8),
                inset 0 1px 0 rgba(0, 255, 200, 0.05);
            text-align: center;
            transition: transform 0.3s ease;
        }

        .construction-card:hover {
            transform: scale(1.005);
        }

        /* ===== ROBOT & GEARS AREA ===== */
        .scene {
            position: relative;
            width: 100%;
            height: 140px;
            margin-bottom: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 30px;
        }

        /* --- ROBOT EMOJI WITH WRENCH --- */
        .robot {
            font-size: 72px;
            line-height: 1;
            display: inline-block;
            animation: robotBob 2.2s ease-in-out infinite;
            filter: drop-shadow(0 0 30px rgba(0, 255, 200, 0.2));
            position: relative;
        }

        .robot::after {
            content: '🔧';
            position: absolute;
            font-size: 32px;
            bottom: -6px;
            right: -28px;
            animation: wrenchSpin 2.8s linear infinite;
        }

        @keyframes robotBob {
            0%, 100% { transform: translateY(0) rotate(-2deg); }
            50% { transform: translateY(-14px) rotate(2deg); }
        }

        @keyframes wrenchSpin {
            0% { transform: rotate(0deg) scale(1); }
            25% { transform: rotate(45deg) scale(1.2); }
            75% { transform: rotate(-20deg) scale(0.9); }
            100% { transform: rotate(0deg) scale(1); }
        }

        /* --- GEARS (CSS only) --- */
        .gear-group {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .gear {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            border: 4px solid rgba(0, 255, 200, 0.5);
            position: relative;
            animation: gearSpin 4s linear infinite;
            box-shadow: 0 0 20px rgba(0, 255, 200, 0.1);
        }

        .gear::before {
            content: '';
            position: absolute;
            inset: 6px;
            border-radius: 50%;
            border: 3px dashed rgba(0, 255, 200, 0.25);
        }

        .gear::after {
            content: '';
            position: absolute;
            inset: 14px;
            border-radius: 50%;
            background: rgba(0, 255, 200, 0.08);
            box-shadow: inset 0 0 12px rgba(0, 255, 200, 0.1);
        }

        .gear.small {
            width: 32px;
            height: 32px;
            animation-duration: 2.6s;
            animation-direction: reverse;
            border-color: rgba(0, 200, 255, 0.4);
        }

        .gear.small::before {
            inset: 4px;
            border-color: rgba(0, 200, 255, 0.2);
        }

        .gear.small::after {
            inset: 9px;
            background: rgba(0, 200, 255, 0.05);
        }

        .gear.reverse {
            animation-direction: reverse;
            border-color: rgba(0, 255, 150, 0.4);
        }

        @keyframes gearSpin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* ===== TITLE ===== */
        .title {
            font-size: clamp(2rem, 6vw, 3.4rem);
            font-weight: 700;
            letter-spacing: -0.02em;
            background: linear-gradient(135deg, #e0fff5 0%, #00ffc8 50%, #00cc99 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 12px;
            text-shadow: 0 0 60px rgba(0, 255, 200, 0.08);
        }

        /* ===== SUBTITLE ===== */
        .subtitle {
            font-size: clamp(1rem, 2vw, 1.25rem);
            color: rgba(255, 255, 255, 0.55);
            font-weight: 300;
            letter-spacing: 0.04em;
            margin-bottom: 28px;
            line-height: 1.6;
        }

        .subtitle strong {
            color: rgba(0, 255, 200, 0.7);
            font-weight: 400;
        }

        /* ===== PROGRESS / PCB TRACE ANIMATION ===== */
        .pcb-container {
            width: 100%;
            height: 6px;
            background: rgba(255, 255, 255, 0.04);
            border-radius: 12px;
            margin: 8px 0 28px 0;
            overflow: hidden;
            position: relative;
            box-shadow: inset 0 0 8px rgba(0,0,0,0.6);
        }

        .pcb-trace {
            height: 100%;
            width: 35%;
            background: linear-gradient(90deg, 
                transparent, 
                #00ffc8 20%, 
                #00ccff 50%, 
                #00ffc8 80%, 
                transparent
            );
            border-radius: 12px;
            animation: pcbRun 2.8s ease-in-out infinite;
            box-shadow: 0 0 30px rgba(0, 255, 200, 0.15);
            position: relative;
        }

        .pcb-trace::after {
            content: '⚡';
            position: absolute;
            right: -8px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 14px;
            color: #00ffc8;
            animation: sparkPulse 0.6s ease-in-out infinite alternate;
        }

        @keyframes pcbRun {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(350%); }
        }

        @keyframes sparkPulse {
            0% { opacity: 0.3; transform: translateY(-50%) scale(0.8); }
            100% { opacity: 1; transform: translateY(-50%) scale(1.3); }
        }

        /* ===== STATUS BADGE ===== */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 8px 22px;
            border-radius: 100px;
            background: rgba(0, 255, 200, 0.06);
            border: 1px solid rgba(0, 255, 200, 0.12);
            color: rgba(255, 255, 255, 0.5);
            font-size: 0.8rem;
            font-weight: 400;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin-top: 12px;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #00ffc8;
            animation: dotBlink 1.4s ease-in-out infinite;
            box-shadow: 0 0 16px rgba(0, 255, 200, 0.4);
        }

        @keyframes dotBlink {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.2; transform: scale(0.6); }
        }

        /* ===== ESTIMATED TIME ===== */
        .eta {
            margin-top: 18px;
            font-size: 0.85rem;
            color: rgba(255, 255, 255, 0.25);
            letter-spacing: 0.06em;
        }

        .eta span {
            color: rgba(0, 255, 200, 0.5);
            font-weight: 500;
        }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 640px) {
            .construction-card {
                padding: 36px 20px;
                border-radius: 32px;
            }

            .scene {
                height: 110px;
                gap: 12px;
                flex-wrap: wrap;
            }

            .robot {
                font-size: 54px;
            }

            .robot::after {
                font-size: 24px;
                right: -18px;
                bottom: -4px;
            }

            .gear {
                width: 34px;
                height: 34px;
            }

            .gear.small {
                width: 24px;
                height: 24px;
            }

            .gear-group {
                gap: 4px;
            }

            .status-badge {
                font-size: 0.65rem;
                padding: 6px 16px;
            }
        }

        @media (max-width: 420px) {
            .gear-group .gear:not(.small) {
                display: none;
            }
        }
    </style>
</head>
<body>

    <!-- ===== FLOATING PARTICLES ===== -->
    <div class="particle-container" id="particles"></div>

    <!-- ===== MAIN CONTENT ===== -->
    <main class="construction-card">
        <!-- SCENE: Robot + Gears -->
        <div class="scene">
            <div class="gear-group">
                <div class="gear"></div>
                <div class="gear small reverse"></div>
                <div class="gear small"></div>
            </div>

            <div class="robot"></div>

            <div class="gear-group">
                <div class="gear reverse"></div>
                <div class="gear small"></div>
                <div class="gear small reverse"></div>
            </div>
        </div>

        <!-- TITLE -->
        <h1 class="title">Under Construction</h1>

        <!-- SUBTITLE -->
        <p class="subtitle">
            We're rebuilding for a faster, smarter experience.<br>
            <strong>• circuits rewired •</strong>
        </p>

        <!-- PCB TRACE ANIMATION -->
        <div class="pcb-container">
            <div class="pcb-trace"></div>
        </div>

        <!-- STATUS -->
        <div class="status-badge">
            <span class="status-dot"></span>
            System upgrade in progress
        </div>

        <!-- ETA -->
        <div class="eta">
            Estimated completion: <span>soon — stay tuned</span>
        </div>
    </main>

    <script>
        // ===== PARTICLE SYSTEM =====
        (function createParticles() {
            const container = document.getElementById('particles');
            const count = 40;

            for (let i = 0; i < count; i++) {
                const particle = document.createElement('div');
                particle.className = 'particle';

                const size = 2 + Math.random() * 4;
                const left = 5 + Math.random() * 90;
                const duration = 8 + Math.random() * 20;
                const delay = Math.random() * 18;

                particle.style.width = size + 'px';
                particle.style.height = size + 'px';
                particle.style.left = left + '%';
                particle.style.animationDuration = duration + 's';
                particle.style.animationDelay = delay + 's';
                particle.style.background = Math.random() > 0.5 ? '#00ffc8' : '#00ccff';
                particle.style.boxShadow = `0 0 ${size * 3}px ${Math.random() > 0.5 ? 'rgba(0,255,200,0.3)' : 'rgba(0,200,255,0.3)'}`;

                container.appendChild(particle);
            }
        })();
    </script>
</body>
</html>