      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 900;
      color: #0f172a;
      font-size: 18px;
    }

    .logo-icon {
      width: 38px;
      height: 38px;
      border-radius: 14px;
      display: grid;
