      margin-top: 4px;
      word-break: break-word;
    }

    .quote-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }

    .quote-card {
      position: relative;
      overflow: hidden;
      padding: 20px;
      border-radius: 20px;
      background: #ffffff;
      border: 1px solid #e5e7eb;
      box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
      transition: transform 0.16s, box-shadow 0.16s, border-color 0.16s;
    }

    .quote-card:hover {
      transform: translateY(-3px);
      border-color: #bfdbfe;
      box-shadow: 0 18px 44px rgba(37, 99, 235, 0.12);
    }

    .quote-mark {
      position: absolute;
      right: 18px;
      top: 8px;
      color: rgba(37, 99, 235, 0.08);
      font-size: 76px;
      line-height: 1;
      font-weight: 900;
    }

    .quote-text {
      position: relative;
      z-index: 1;
      color: #0f172a;
      font-size: 17px;
      font-weight: 700;
      margin-bottom: 14px;
    }

    .quote-meta {
      position: relative;
      z-index: 1;
      display: flex;
      flex-wrap: wrap;
