        </div>

        <div class="message" id="message"></div>

        <div class="stats-grid">
          <div class="stat-card">
            <span>当前展示</span>
            <strong id="visibleCount">0</strong>
          </div>
          <div class="stat-card">
            <span>名言总数</span>
            <strong id="totalCount">0</strong>
          </div>
