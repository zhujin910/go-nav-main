  <script>
    const quotes = [
      { text: '学而时习之，不亦说乎。', author: '孔子', scope: '中国', category: '学习', keywords: '学习 读书 成长' },
      { text: '敏而好学，不耻下问。', author: '孔子', scope: '中国', category: '读书', keywords: '读书 学习 求知' },
      { text: '三人行，必有我师焉。', author: '孔子', scope: '中国', category: '学习', keywords: '学习 谦虚 成长' },
      { text: '少壮不努力，老大徒伤悲。', author: '汉乐府', scope: '中国', category: '时间', keywords: '时间 励志 珍惜' },
      { text: '读书破万卷，下笔如有神。', author: '杜甫', scope: '中国', category: '读书', keywords: '读书 写作 学习' },
      { text: '黑发不知勤学早，白首方悔读书迟。', author: '颜真卿', scope: '中国', category: '读书', keywords: '读书 时间 学习' },
      { text: '纸上得来终觉浅，绝知此事要躬行。', author: '陆游', scope: '中国', category: '学习', keywords: '实践 学习 读书' },
      { text: '业精于勤，荒于嬉。', author: '韩愈', scope: '中国', category: '励志', keywords: '励志 勤奋 学习' },
      { text: '路漫漫其修远兮，吾将上下而求索。', author: '屈原', scope: '中国', category: '励志', keywords: '励志 坚持 求索' },
      { text: '志不强者智不达。', author: '墨子', scope: '中国', category: '品德', keywords: '志向 品德 励志' },
      { text: '合理安排时间，就等于节约时间。', author: '培根', scope: '外国', category: '时间', keywords: '时间 珍惜 效率' },
      { text: '知识就是力量。', author: '培根', scope: '外国', category: '读书', keywords: '知识 读书 学习' },
      { text: '时间是衡量事业的标准。', author: '培根', scope: '外国', category: '时间', keywords: '时间 事业 珍惜' },
      { text: '书籍是人类进步的阶梯。', author: '高尔基', scope: '外国', category: '读书', keywords: '书籍 读书 进步' },
      { text: '生活就像海洋，只有意志坚强的人才能到达彼岸。', author: '马克思', scope: '外国', category: '励志', keywords: '励志 坚强 生活' },
      { text: '完成工作的方法是爱惜每一分钟。', author: '达尔文', scope: '外国', category: '时间', keywords: '时间 工作 珍惜' },
      { text: '学习不是一日之功，积累才能见到变化。', author: '通用语句', scope: '通用', category: '学习', keywords: '学习 积累 成长' },
      { text: '把今天的事做好，就是对明天的准备。', author: '通用语句', scope: '通用', category: '励志', keywords: '励志 时间 行动' },
      { text: '读书让人看见更大的世界，也看清自己的方向。', author: '通用语句', scope: '通用', category: '读书', keywords: '读书 世界 方向' },
      { text: '珍惜时间的人，往往更懂得珍惜机会。', author: '通用语句', scope: '通用', category: '时间', keywords: '时间 机会 珍惜' }
    ];

    const keywordInput = document.getElementById('keywordInput');
    const categorySelect = document.getElementById('categorySelect');
    const authorSelect = document.getElementById('authorSelect');
    const message = document.getElementById('message');
    const quoteGrid = document.getElementById('quoteGrid');
    const emptyBox = document.getElementById('emptyBox');
    const visibleCount = document.getElementById('visibleCount');
    const totalCount = document.getElementById('totalCount');
    const currentCategory = document.getElementById('currentCategory');
    const selectedBox = document.getElementById('selectedBox');
    const selectedQuote = document.getElementById('selectedQuote');
    const selectedText = document.getElementById('selectedText');

    let currentList = quotes;

    function setMessage(text, type) {
      message.textContent = text;
      message.style.color = type === 'success' ? '#16a34a' : '#dc2626';
    }

    function escapeHtml(value) {
      return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function renderQuotes(list) {
      currentList = list;

      quoteGrid.innerHTML = list.map(function(item, index) {
        return `
          <div class="quote-card">
            <div class="quote-mark">“</div>
            <div class="quote-text">${escapeHtml(item.text)}</div>
            <div class="quote-meta">
              <span>${escapeHtml(item.author)}</span>
              <span>${escapeHtml(item.category)}</span>
              <span>${escapeHtml(item.scope)}</span>
            </div>
            <button class="copy-btn" onclick="selectQuote(${index})">选择并复制</button>
          </div>
        `;
      }).join('');

      visibleCount.textContent = list.length;
      totalCount.textContent = quotes.length;
      currentCategory.textContent = categorySelect.value || '全部';
      emptyBox.style.display = list.length ? 'none' : 'block';
    }

    function filterQuotes(showMessage = true) {
      const keyword = keywordInput.value.trim().toLowerCase();
      const category = categorySelect.value;
      const scope = authorSelect.value;

      if (keyword.length > 30) {
        setMessage('关键词不建议超过 30 个字符，请适当精简后再查询。', 'error');
        return;
      }

      const result = quotes.filter(function(item) {
        const text = (item.text + ' ' + item.author + ' ' + item.category + ' ' + item.keywords).toLowerCase();
        const keywordMatched = !keyword || text.includes(keyword);
        const categoryMatched = !category || item.category === category;
        const scopeMatched = !scope || item.scope === scope;
        return keywordMatched && categoryMatched && scopeMatched;
      });

      renderQuotes(result);

      if (showMessage) {
        if (result.length) {
          setMessage('已找到 ' + result.length + ' 条名言名句，结果仅供参考。', 'success');
        } else {
          setMessage('未找到匹配内容，请更换关键词、分类或作者范围。结果仅供参考。', 'error');
        }
      }
    }

    function selectQuote(index) {
      const item = currentList[index];

      if (!item) {
        setMessage('未找到可复制的名言内容。', 'error');
        return;
      }

      const text = '“' + item.text + '”——' + item.author;
      selectedQuote.textContent = text;
      selectedText.textContent = '分类：' + item.category + '；作者范围：' + item.scope + '。使用时建议结合语境和可靠出处核对，结果仅供参考。';
      selectedBox.style.display = 'block';

      navigator.clipboard.writeText(text).then(function() {
        setMessage('已选择并复制名言内容，结果仅供参考。', 'success');
      }).catch(function() {
        const temp = document.createElement('textarea');
        temp.value = text;
        document.body.appendChild(temp);
        temp.select();
        document.execCommand('copy');
        document.body.removeChild(temp);
        setMessage('已选择名言内容，请根据浏览器提示确认复制。结果仅供参考。', 'success');
      });
    }

    function quickCategory(category) {
      keywordInput.value = '';
      categorySelect.value = category;
      filterQuotes(true);
      document.getElementById('tool').scrollIntoView({ behavior: 'smooth' });
    }

    function randomQuote() {
      const source = currentList.length ? currentList : quotes;
      const item = source[Math.floor(Math.random() * source.length)];
      renderQuotes([item]);
      selectedBox.style.display = 'none';
      setMessage('已随机推荐 1 条名言名句，结果仅供参考。', 'success');
    }

    function resetFilter() {
      keywordInput.value = '';
      categorySelect.value = '';
      authorSelect.value = '';
      selectedBox.style.display = 'none';
      message.textContent = '';
      renderQuotes(quotes);
    }

    keywordInput.addEventListener('input', function() {
      message.textContent = '';
      filterQuotes(false);
    });

    categorySelect.addEventListener('change', function() {
      filterQuotes(true);
    });

    authorSelect.addEventListener('change', function() {
      filterQuotes(true);
    });

    renderQuotes(quotes);
  </script>
  <div class="icp-footer" style="text-align:center;padding:14px 12px 22px;margin:0;color:inherit;font-size:13px;line-height:1.6;opacity:.68;">
    
  </div>

