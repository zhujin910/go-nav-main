      gap: 18px;
      color: #475569;
      font-size: 14px;
    }

    .nav-links a:hover {
      color: #2563eb;
    }

    .page {
      width: min(1180px, 94%);
      margin: 0 auto;
      padding: 42px 0 56px;
    }

