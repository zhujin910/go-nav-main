  <script>
// 在手机端 隐藏 常用站点下面第七个网址及其以后的网址块
    window.addEventListener('DOMContentLoaded', (event) => {
      var xpath = '/html/body/div[2]/div[3]/div[4]/div/div/div[4]/div[1]/div/div[6]/following-sibling::div';
      var result = document.evaluate(xpath, document, null, XPathResult.ORDERED_NODE_SNAPSHOT_TYPE, null);
      for (var i = 0; i < result.snapshotLength; i++) {
        result.snapshotItem(i).classList.add('hidden-on-mobile');
      }
    });
  </script>

