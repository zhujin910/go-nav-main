#bulletin_box .text-xs {
    font-size: 0.85rem !important;
}



table,tr,td,th{
padding: 0;
margin: 0;
}
table{
width: 100%;
border-color: #ccc;
}
table tr{
line-height: 30px;
border-color: #ccc;
}
table th,table td{
text-align: center;
border-color: #ccc;
}

table td{
    text-align: left;
    float: none !important;
    padding: 8px;
    border-width: initial;
    border-style: none;
    border-color: initial;
    border-image: initial;
    background: 0px 0px;
    border: 1px solid #ddd;
}

table tr:nth-child(odd){
background: rgb(249, 249, 249);
}

.panel-body ul {
margin: 25px auto;
padding: 0;
}
.panel-body li{
margin-left: 30px;
line-height: 30px;
}
.new-news li{list-style:none}

/*.panel-body a{
color:#4183c4;
}
*/
.site-go a{
  color:#282a2d;
}


h2,h3,h4,h5,h6{
  margin-bottom:.65em;margin-top:.65em;
  font-weight: 700;
}


.panel-body h2 {color: #f1404b;font-size: 1.75em;}
.panel-body h3 {color: #F77A0B;font-size: 1.5em;}
.panel-body h4 {color: #662D91;font-size: 1.25em;}

.navbar-collapse li{
  list-style:none
}

.news_title{margin-top: 0em;}




/*网址页内容高度*/
@media (min-width: 1200px){
  .mb-xl-5, .my-xl-5 {margin-bottom: 1rem!important;}}
@media (min-width: 768px){
  .pb-md-5, .py-md-5 {padding-bottom: 1rem!important;}}
@media (min-width: 768px){
  .pt-md-5, .py-md-5 {padding-top: 1rem!important;}}

/*置顶文字大小*/
.text-ss {
    font-size: .65rem!important;
}
.badge {
  padding: .25em .25em;
  border-radius: 5px;
}

/*手机端隐藏某个class*/
    @media (max-width: 768px) {
      .hidden-on-mobile {
        display: none;
      }
    }

/*网址页面的按钮颜色*/
.site-body .btn-mobile {
    background-color: #1296db80 !important; 
}

.site-body .btn-arrow:hover {
    color: #fff;
    background: #1296db73;
}

.site-body .btn-arrow {
    color: #ffffff;
    border-radius: 6px;
    padding: 7px 16px;
    background-color: #1296db;
    transition: .3s;
}

