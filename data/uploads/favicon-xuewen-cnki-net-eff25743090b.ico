<input type="hidden" value="" id="rbookCate">
<input type="hidden" value="" id="typecode">
<input type="hidden" value="" id="hotsubject">
<input type="hidden" id="contextPath" value="">
<script src="/xinke/js/list/jquery.lazyload.js;jsessionid=8C52D9ADB7AE8904AA45D5A53070268A"></script>
<script type="text/javascript">        AC_FL_RunContent = 0;</script>
<script src="/xinke/js/list/AC_RunActiveContent.js;jsessionid=8C52D9ADB7AE8904AA45D5A53070268A"></script>
<script src="/xinke/js/list/list.js;jsessionid=8C52D9ADB7AE8904AA45D5A53070268A?v=2"></script>
<script src="/xinke/js/list/paperList.js;jsessionid=8C52D9ADB7AE8904AA45D5A53070268A?v=1"></script>
<script type="text/javascript">
    var mallHomeUrl ="https://mall.cnki.net";
    var contextPath = $("#contextPath").val();
    // var hrefUrl = contextPath + "/reference/index?navicode=";
    var hrefUrl = "index?navicode=";
    $(function () {

        paperList.forEach(function (first) {
            var liTag = $('<li>' +
                '<a href="' + hrefUrl + first.code + '" title="' + first.name + '">' + first.name + '</a>' +
                '<br />' +
                '</li>')
            $('#pop_up').append(liTag)

            first.secondShowCate && first.secondShowCate.forEach(function (item, idx) {
                var aTag = $('<a class="second" href="' + hrefUrl + item.code + '" title="' + item.name + '">' + item.name + '</a>')
                liTag.append(aTag);
                if (first.secondShowCate.length == 2 && idx == 0) {
                    var divider = $('<span class="divider"></span>')
                    liTag.append(divider)
                }
                if (first.secondShowCate.length == 3 && (idx == 0 || idx == 1)) {
                    var divider = $('<span class="divider"></span>')
                    liTag.append(divider)
                }
            })
            var divTag = $('<div class="pop_up_m" style="display: none;">' +
                '<div class="pop_up_m_left">' +
                '</div>' +
                '</div>')
            liTag.append(divTag)
            var hasThied = first.secondCate && first.secondCate.some(function (item) {
                return item.thirdCate
            })
            if (hasThied) {
                first.secondCate.forEach(function (item, idx) {
                    var dlTag = $('<dl>' +
                        '<dt><a href="' + hrefUrl + item.code + '" title="' + item.name + '">' + item.name + '</a></dt>' +
                        '<dd>' +
                        '<p class="p_tag"></p>' +
                        '</dd>' +
                        '</dl>')
                    divTag.find('.pop_up_m_left').append(dlTag)
                    item.thirdCate && item.thirdCate.forEach(function (third) {
                        var aTag = $('<a href="' + hrefUrl + third.code + '" title="' + third.name + '">' + third.name + '</a>')
                        dlTag.find('.p_tag').append(aTag)
                    })

                })
            } else {
                first.secondCate && first.secondCate.forEach(function (item, idx) {
                    var dtTag = $(
                        '<div class="no_third"><a href="' + hrefUrl + item.code + '" title="' + item.name + '">' + item.name + '</a></div>'
                    )
                    divTag.find('.pop_up_m_left').append(dtTag)
                })
            }
        })

        $("#pop_up >li").mouseover(function () {
            $(this).css({
                "background-color": "#ffffff",
                "border-top": "1px solid #5ba11d",
                "border-bottom": "1px solid #5ba11d"
            })
            j = $(this).index();
            $(".pop_up_m").eq(j).css("display", "block");

        })
        $("#pop_up >li").mouseout(function () {
            $(this).css({
                "background-color": "#f6fdf1",
                "border-top": "1px solid #f3fbfe",
                "border-bottom": "1px solid #fff"
            })
            $(".pop_up_m").eq(j).css("display", "none");
        })


        $(".pop_up_m").mouseover(function () {
            $(this).css("display", "block");
            l = $(".pop_up_m").index($(this));
            $("#pop_up > li").eq(l).css({
                "background-color": "#ffffff",
                "border-top": "1px solid #5ba11d",
                "border-bottom": "1px solid #5ba11d"
            });
        })
        $(".pop_up_m").mouseout(function () {
            $(this).css("display", "none");
            $("#pop_up > li").eq(l).css({
                "background-color": "#f6fdf1",
                "border-top": "1px solid #f3fbfe",
                "border-bottom": "1px solid #fff"
            });
        })
        $(".close").click(function () {
            $(this).parent().parent().css("display", "none");
        })

        $(".nav_left").click(function () {
            window.location.href = "index";
        })

        $("#pop_nav a.second").click(function () {
            if ($(this).hasClass("hot") == true) {
                var hotsubject = $(this).attr("hotsubject");
                window.location.href = "index?hotsubject=" + encodeURI(hotsubject);
            } else {
                var code = $(this).attr("code");
                window.location.href = "index?typecode=" + code;
            }
        })

    });
</script>
<script type="text/javascript">
    $(document).ready(function () {
        $("img").lazyload({
            placeholder: "http://qiangguo.cnki.net/images/grey.gif",
            effect: "fadeIn"
        });
        // 悬浮框跳转
        $(".rightToolbar .cart").click(function () {
            window.open('/cart/?s=MALL', '_blank')
        })
        $(".rightToolbar .feedback").click(function () {
            window.open('https://mall.cnki.net/help/help_QS.html', '_blank')
        })
        $(".rightToolbar .service").click(function () {
            window.open('https://help.cnki.net', '_blank')
        })
        $(".rightToolbar .ad").click(function () {
            window.open('https://a.cnki.net/front/#/home', '_blank')
        })
        $(".rightToolbar .goTop").click(function () {
            $("html, body").animate({scrollTop: 0}, "slow");
        })
    });
</script>

