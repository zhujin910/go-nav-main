<script>
    var jis=3
    $(function(){
        $(".a-zhankpd").hide();
    })
    var t=setInterval(function(){
        jis--;
        if(jis==0) {
            clearInterval(t)
        }
        $(".s-jis").text(jis)
    },1000)
