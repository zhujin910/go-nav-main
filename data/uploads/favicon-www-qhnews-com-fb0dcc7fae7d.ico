/* ========== 新闻栏目组件样式 ========== */

.news-box { width: 470px; max-width: 470px; margin: 0 auto; overflow: hidden; }

.news-tabs { width: 470px; max-width: 470px; border-collapse: collapse; table-layout: fixed; }

.news-tabs td { height: 40px; vertical-align: middle; overflow: hidden; }

.news-tabs .tab-title { width: 356px; font-size: 24px; font-weight: bold; }

.news-tabs .tab-title a { color: #1c5cb4; text-decoration: none; }

/* 大标题hover：无下划线 */
.news-tabs .tab-title a:hover { text-decoration: none; }

.news-tabs .tab-sub { width: 103px; text-align: right; font-size: 18px; color: #000; }

.news-tabs .tab-sub a { cursor: pointer; margin-left: 8px; color: #000; text-decoration: none; font-size: 18px; }

.news-tabs .tab-sub a:hover,
.news-tabs .tab-sub a.active { color: #1c5cb4; font-weight: bold; }

.news-divider { width: 470px; max-width: 470px; height: 10px; display: block; }

.news-list {
  width: 470px;
  max-width: 470px;
  box-sizing: border-box;
  background: url('http://www.qhnews.com/images2/5.jpg') repeat-y;
  padding: 10px 0;
  overflow: hidden;
}

.news-list ul { list-style: none; margin: 0; padding: 0 15px; width: 100%; box-sizing: border-box; }

.news-list li {
  height: 52px;
  line-height: 52px;
  border-bottom: 1px dashed #ccc;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  width: 100%;
  box-sizing: border-box;
}

.news-list li a { font-size: 18px; color: #333; text-decoration: none; }

.news-list li a,
.news-list li a:link,
.news-list li a:visited,
.news-list li font,
.news-list li * {
  font-size: 18px !important;
}

.news-list li a::before {
  content: "\25A0";
  color: #000;
  font-size: 10px;
  margin-right: 8px;
  vertical-align: middle;
}

/* 新闻列表hover：只变蓝色，无下划线 */
.news-list li a:hover { color: #1c5cb4; text-decoration: none; }

.news-panel { display: none; width: 100%; }

.news-panel.active { display: block; }

/* 全局链接：所有状态无下划线 */
a:link { text-decoration: none; }
a:visited { text-decoration: none; }
a:hover { text-decoration: none; }
a:active { text-decoration: none; }

</style>

