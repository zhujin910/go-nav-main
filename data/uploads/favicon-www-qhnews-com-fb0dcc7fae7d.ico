    <td width="900" valign="top"><style type="text/css">
/* ========== 图片轮播图组件 ========== */
.slider {
  width: 900px;
  height: 528px;
  margin: 0 auto;
  position: relative;
  overflow: hidden;
}
.slider-list {
  width: 900px;
  height: 100%;
  position: relative;
}
/* 单张图片项：绝对定位叠加，透明度切换，z-index控制层级 */
.slider-item {
  width: 900px;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  opacity: 0;
  z-index: 1;                /* 默认底层 */
  transition: opacity 0.6s ease;
}
/* 当前激活的图片：显示 + 最高层级（在最上面，可点击） */
.slider-item.active {
  opacity: 1;
  z-index: 2;
}
/* 确保链接块级显示，填满整个item区域 */
.slider-item a {
  display: block;
  width: 900px;
  height: 100%;
}
.slider-item img {
  width: 900px;
  height: 100%;
  display: block;
  object-fit: cover;
  transition: transform 0.6s ease;
}
.slider-item:hover img {
  transform: scale(1.022);
}
/* 底部信息条 */
.slider-bar {
  width: 900px;
  max-width: 900px;
  height: 50px;
  line-height: 50px;
  position: absolute;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 10;
  padding: 0 20px;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 8px;
}
.slider-count {
  float: left;
  color: #fff;
  font-weight: bold;
}
.slider-count .current {
  font-size: 24px;
}
.slider-count .total,
.slider-count .sep {
  font-size: 16px;
}
.slider-title {
  float: right;
  color: #fff;
  font-size: 16px;
  text-decoration: none;
  max-width: 700px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  transition: color 0.2s ease;
}
.slider-title:hover {
  color: #ffd700;
  text-decoration: none;
}
/* 左右切换箭头 */
.slider-arrow {
  width: 40px;
  height: 60px;
  line-height: 60px;
  text-align: center;
  position: absolute;
  top: 50%;
  margin-top: -30px;
  background: rgba(0, 0, 0, 0.3);
  color: #fff;
  font-size: 24px;
  cursor: pointer;
  z-index: 20;
  user-select: none;
  transition: background 0.3s ease;
}
.slider-arrow:hover {
  background: rgba(0, 0, 0, 0.6);
}
.slider-prev { left: 0; }
.slider-next { right: 0; }
/* 指示点 */
.slider-dots {
  position: absolute;
  bottom: 60px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 15;
}
.slider-dots span {
  display: inline-block;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  margin: 0 5px;
  cursor: pointer;
  transition: background 0.3s ease;
}
.slider-dots span.active {
  background: #fff;
}
</style>
<!-- ========== 轮播图HTML结构 ========== -->
<div class="slider" id="slider">
  <div class="slider-list">
    <div class="slider-item active">


<table width="100%" >
<tr>
<td >
<a href="http://www.qhnews.com/index/system/2026/08/22/030600917.shtml" target="_blank"> <img src="http://www.qhnews.com/pic/003/002/340/00300234079_cf5e2e21.jpg" alt="寻访千年印记 接续守护文脉"> </a>
</td>
</tr>
