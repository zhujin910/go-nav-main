/* ========== 专题图组组件样式 ========== */

/* 主内容区：背景从#f5faff渐变到#ffffff + 蓝色阴影 */
.feature-section {
  background: linear-gradient(to bottom, #f5faff 0%, #ffffff 100%);
  box-shadow: 0 4px 20px rgba(0, 120, 255, 0.12);
  border-radius: 6px;
}

/* 顶部"更多>>"链接：样式和中间新闻一致，无符号 */
.feature-more {
  font-size: 18px;
  color: #333;
  text-decoration: none;
}
.feature-more:hover {
  color: #1c5cb4;
  text-decoration: none;
}

/* 图片容器：280x160，圆角，相对定位 */
.feature-img {
  position: relative;
  width: 280px;
  height: 160px;
  border-radius: 8px;
  overflow: hidden;
  display: block;
}
.feature-img img {
  width: 280px;
  height: 160px;
  display: block;
  object-fit: cover;
}

/* 图片底部黑色半透明条：高50px，透明度40% */
.feature-img .img-caption {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 50px;
  line-height: 50px;
  background: rgba(0, 0, 0, 0.4);
  color: #fff;
  font-size: 14px;
  padding: 0 12px;
  box-sizing: border-box;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  text-decoration: none;
  transition: color 0.2s ease;
}
.feature-img .img-caption:hover {
  color: #ffd700;
}

/* 中间新闻标题列表：宽460px，整体向下偏移10px */
.feature-news {
  width: 460px;
  margin: 10px 0 0 0;
  padding: 0;
}
.feature-news li {
  height: 52px;
  line-height: 52px;
  list-style: none;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  position: relative;
}

/* 用伪元素画虚线，距离底部8px（即向上移8px） */
.feature-news li::after {
  content: "";
  position: absolute;
  bottom: 8px;
  left: 0;
  right: 0;
  border-bottom: 1px dashed #ccc;
}
.feature-news li a {
  font-size: 18px;
  color: #333;
  text-decoration: none;
}

/* 新闻标题前的黑色小方块符号：Unicode转义，避免gb2312乱码成问号 */
.feature-news li a::before {
  content: "\25A0";
  color: rgba(0, 0, 0, 0.5);
  font-size: 10px;
  margin-right: 8px;
  vertical-align: middle;
}
.feature-news li a:hover {
  color: #1c5cb4;
  text-decoration: none;
}

</style>

