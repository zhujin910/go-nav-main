/* ============================================================
   栏目模板：州县动态（前缀 zxdt2-，第二版，区别于旧版 zxdt-）
   ============================================================ */

/* 顶部大标题：24px加粗，主题蓝色 */
.zxdt2-title {
  font-size: 24px;
  font-weight: bold;
  color: #1c5cb4;
}

/* 右上角"更多>>"链接：16px灰色，右对齐，无下划线 */
.zxdt2-more {
  font-size: 16px;
  color: #999;
  text-decoration: none;
  text-align: right;
  display: block;
}
.zxdt2-more:hover {
  color: #1c5cb4;
}

/* 强制左侧模板图片：154x93，8px圆角 */
.zxdt2-img-cell img {
  width: 154px;
  height: 93px;
  display: block;
  border-radius: 8px !important;
  object-fit: cover;
}

/* 右侧第一条稿子卡片：白色背景，蓝色柔和阴影，8px圆角 */
.zxdt2-news1 {
  width: 261px;
  height: 93px;
  background: #fff;
  padding: 10px 14px;
  box-sizing: border-box;
  box-shadow: 0 2px 10px rgba(0, 120, 255, 0.15);
  border-radius: 8px;
  font-size: 18px;
  color: #333;
  line-height: 1.5;
  overflow: hidden;
  display: flex;
  align-items: center;
}

/* 右侧第一条稿子：强行规定字体加粗 */
.zxdt2-news1,
.zxdt2-news1 a,
.zxdt2-news1 a:link,
.zxdt2-news1 a:visited,
.zxdt2-news1 a:hover,
.zxdt2-news1 font,
.zxdt2-news1 span,
.zxdt2-news1 * {
  font-weight: bold !important;
}
.zxdt2-news1 a {
  color: #333;
  text-decoration: none;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.zxdt2-news1 a:hover {
  color: #1c5cb4;
}

/* 底部新闻列表 */
.zxdt2-list {
  width: 100%;
  margin: 0;
  padding: 0;
  list-style: none;
}
.zxdt2-list li {
  height: 40px;
  line-height: 40px;
  border-bottom: 1px dashed #ccc;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.zxdt2-list li:last-child {
  border-bottom: none;
}

/* 底部新闻标题：强行不加粗 */
.zxdt2-list li a,
.zxdt2-list li a:link,
.zxdt2-list li a:visited,
.zxdt2-list li a:hover,
.zxdt2-list li font,
.zxdt2-list li span,
.zxdt2-list li * {
  font-weight: normal !important;
}
.zxdt2-list li a {
  font-size: 16px;
  color: #333;
  text-decoration: none;
  padding-left: 16px;
  position: relative;
}

/* 红色圆点：Unicode转义 */
.zxdt2-list li a::before {
  content: "\2022";
  color: #d32f2f;
  font-size: 12px;
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
}
.zxdt2-list li a:hover {
  color: #1c5cb4;
}

</style>

