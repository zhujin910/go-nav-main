<script>
// ========== 轮播图交互逻辑 ==========
var slider = document.getElementById('slider');
var items = document.querySelectorAll('.slider-item');
var dots = document.querySelectorAll('.slider-dots span');
var currentEl = document.getElementById('sliderCurrent');
var totalEl = document.getElementById('sliderTotal');
var titleEl = document.getElementById('sliderTitle');
var prevBtn = document.getElementById('sliderPrev');
var nextBtn = document.getElementById('sliderNext');
var currentIndex = 0;
var total = items.length;
var timer = null;
var interval = 4000;
totalEl.textContent = total;
function goTo(index) {
  if (index < 0) index = total - 1;
  if (index >= total) index = 0;
  items.forEach(function(item) { item.classList.remove('active'); });
  dots.forEach(function(dot) { dot.classList.remove('active'); });
  items[index].classList.add('active');
  dots[index].classList.add('active');
  currentEl.textContent = index + 1;
  // 从当前slide中提取链接和标题，同步到底部信息条
  var linkEl = items[index].querySelector('a');
  var imgEl = items[index].querySelector('img');
  if (linkEl) {
    titleEl.href = linkEl.href;
    titleEl.textContent = imgEl ? (imgEl.alt || imgEl.title || '') : '';
  }
  currentIndex = index;
}
function next() { goTo(currentIndex + 1); }
function prev() { goTo(currentIndex - 1); }
function startAuto() { timer = setInterval(next, interval); }
function stopAuto() { clearInterval(timer); }
prevBtn.addEventListener('click', function() { prev(); stopAuto(); startAuto(); });
nextBtn.addEventListener('click', function() { next(); stopAuto(); startAuto(); });
dots.forEach(function(dot) {
  dot.addEventListener('click', function() {
    var idx = parseInt(this.getAttribute('data-index'));
    goTo(idx);
    stopAuto();
    startAuto();
  });
});
slider.addEventListener('mouseenter', stopAuto);
slider.addEventListener('mouseleave', startAuto);
goTo(0);
startAuto();
</script>
