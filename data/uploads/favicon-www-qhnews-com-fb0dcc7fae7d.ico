<script>
// ========== 实时日期日历 ==========
(function() {
  var weekDays = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六'];
  function updateDate() {
    var now = new Date();
    var y = now.getFullYear();
    var m = now.getMonth() + 1;
    var d = now.getDate();
    var w = weekDays[now.getDay()];
    document.getElementById('epaperDate').textContent = y + '年' + m + '月' + d + '日 ' + w;
  }
  updateDate();
  setInterval(updateDate, 60000);
})();

// ========== 报纸切换（鼠标经过切换，切换后固定显示） ==========
(function() {
  var btns = document.querySelectorAll('.epaper-btn');
  var imgEl = document.getElementById('epaperImg');
  var linkEl = document.getElementById('epaperLink');

  btns.forEach(function(btn) {
    // 鼠标经过：切换到对应报纸并固定显示
    btn.addEventListener('mouseenter', function() {
      btns.forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');

      var paper = btn.getAttribute('data-paper');
      var imgNum = btn.getAttribute('data-img');
      var title = btn.getAttribute('data-title');

      linkEl.href = 'http://epaper.tibet3.com/' + paper + '/';
      linkEl.title = title;
      imgEl.src = 'https://epaper.tibet3.com/m/getTodayPage/' + imgNum;
      imgEl.alt = title;
      imgEl.title = title;
    });
  });
  // 已去掉 mouseleave 自动恢复，hover后固定显示，方便移到左侧点击图片链接
})();
</script>
