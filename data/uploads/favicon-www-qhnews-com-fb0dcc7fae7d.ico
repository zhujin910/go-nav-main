/* ========== 六图网格组件 ========== */

/* 外层容器：宽1400px，水平居中，图片均匀分布 */
.img-grid-6 {
  width: 1400px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;  /* 6张图均匀分布，间距自动均分 */
}

/* 单张图片容器：固定210px × 100px，圆角 */
.img-grid-6 .img-item {
  width: 210px;       /* 固定宽度210px */
  height: 100px;      /* 固定高度100px */
  border-radius: 8px; /* 四角弧度 */
  overflow: hidden;   /* 图片超出圆角部分裁剪 */
}

/* 图片填满容器 */
.img-grid-6 .img-item img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;  /* 等比填满，不变形 */
  transition: transform 0.3s ease;
}

/* 鼠标悬停：图片轻微放大 */
.img-grid-6 .img-item:hover img {
  transform: scale(1.05);
}

</style>

