<script>

// ========== 友情链接标签切换交互 ==========
(function() {

  var tabs = document.querySelectorAll('.yqlj-tab');
  var panels = document.querySelectorAll('.yqlj-panel');

  function switchPanel(panelId) {
    tabs.forEach(function(t) { t.classList.remove('yqlj-active'); });
    panels.forEach(function(p) { p.classList.remove('yqlj-active'); });
    document.querySelector('.yqlj-tab[data-panel="' + panelId + '"]').classList.add('yqlj-active');
    document.getElementById('yqlj-panel-' + panelId).classList.add('yqlj-active');
  }

  tabs.forEach(function(tab) {
    tab.addEventListener('mouseenter', function() {
      switchPanel(tab.getAttribute('data-panel'));
    });
  });

})();

</script>
