/* ========== 生态高地栏目卡片 ========== */

/* 外层卡片容器：宽度445px，水平居中，白色背景，10px圆角，蓝色柔和阴影 */
.st-card {
  width: 445px;
  margin: 0 auto;
  background: #fff;
  border-radius: 10px;
  box-shadow: 0 2px 12px rgba(0, 120, 255, 0.12);  /* 蓝色柔和阴影 */
  overflow: hidden;
  padding: 16px 18px 20px;
  box-sizing: border-box;
}

/* 顶部标题栏：高度36px，行高36px，底部间距8px */
.st-header {
  width: 100%;
  height: 36px;
  line-height: 36px;
  margin-bottom: 8px;
}

/* 左侧大标题"生态高地"：左浮动，24px加粗，主题蓝色 */
.st-title {
  float: left;
  font-size: 24px;
  font-weight: bold;
  color: #1c5cb4;
}

/* 右侧"更多>>"链接：右浮动，16px灰色，无下划线 */
.st-more {
  float: right;
  font-size: 16px;
  color: #999;
  text-decoration: none;
}
.st-more:hover {
  color: #1c5cb4;
}

/* 标题下方装饰分隔图 11.jpg：宽度铺满，固定高度11px，块级显示 */
.st-divider-img {
  width: 100%;
  height: 11px;
  display: block;
  margin: 4px 0 12px 0;
  object-fit: cover;
}

/* 主图容器：相对定位，8px圆角，溢出裁剪 */
.st-main-img {
  position: relative;
  width: 100%;
  height: 220px;
  border-radius: 8px;
  overflow: hidden;
}

/* 主图：填满容器，块级显示，等比缩放 */
.st-main-img img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

/* 图片底部黑色半透明标题条：绝对定位贴底，黑色透明度45%，白色加粗文字 */
.st-img-caption {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 44px;
  line-height: 44px;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 18px;
  font-weight: bold;
  padding: 0 14px;
  box-sizing: border-box;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  text-decoration: none;
}

/* 摘要文字区域：上间距10px，14px浅灰色，行高1.7，右侧留70px给详情按钮 */
.st-summary {
  width: 100%;
  margin-top: 10px;
  font-size: 14px;
  color: #aeb0b2;
  line-height: 1.7;
  position: relative;
  padding-right: 70px;
  box-sizing: border-box;
}

/* 红色"详情"按钮：绝对定位在摘要右下角，红色背景，4px圆角 */
.st-detail-btn {
  position: absolute;
  right: 0;
  bottom: 0;
  display: inline-block;
  padding: 4px 14px;
  background: #d32f2f;
  color: #fff;
  font-size: 14px;
  text-decoration: none;
  border-radius: 4px;
}
.st-detail-btn:hover {
  background: #b71c1c;
}

/* 新闻列表：上间距18px，清除默认列表样式 */
.st-news-list {
  width: 100%;
  margin: 18px 0 0 0;
  padding: 0;
  list-style: none;
}

/* 每条新闻：高38px，行高38px，底部虚线分隔，超出省略 */
.st-news-list li {
  height: 38px;
  line-height: 38px;
  border-bottom: 1px dashed #ccc;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 新闻标题链接：18px深灰色，无下划线 */
.st-news-list li a {
  font-size: 18px;
  color: #333;
  text-decoration: none;
}

/* 新闻标题前的灰色小圆点符号 */
.st-news-list li a::before {
  content: "●";
  color: #999;
  font-size: 8px;
  margin-right: 10px;
  vertical-align: middle;
}
.st-news-list li a:hover {
  color: #1c5cb4;
}

</style>

