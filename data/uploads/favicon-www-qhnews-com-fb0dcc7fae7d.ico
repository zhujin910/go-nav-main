/* ========== 报社动态栏目卡片 ========== */
/* 外层卡片：649x214，浅蓝渐变背景，圆角 */
.bsdt-card {
  width: 649px;
  height: 214px;
  margin: 0 auto;
  background: linear-gradient(135deg, #f0f6ff 0%, #e8f1fc 50%, #f5f9ff 100%);
  border-radius: 12px;
  position: relative;
  overflow: hidden;
  box-shadow: 0 2px 10px rgba(0, 120, 255, 0.08);
  box-sizing: border-box;
  padding: 16px 30px;
}
/* 左侧竖排大标题区 */
.bsdt-title {
  float: left;
  width: 100px;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.bsdt-title-top {
  font-size: 36px;
  font-weight: bold;
  color: #1c5cb4;
  line-height: 1.1;
  letter-spacing: 2px;
}
.bsdt-title-bottom {
  font-size: 36px;
  font-weight: bold;
  color: #1c5cb4;
  line-height: 1.1;
  letter-spacing: 2px;
  margin-top: 4px;
}
/* 右侧内容区：649-60(padding)-100(标题)=489px */
.bsdt-content {
  float: right;
  width: 489px;
  height: 100%;
  position: relative;
}
/* 右上"更多>>"链接 */
.bsdt-more {
  position: absolute;
  top: 0;
  right: 0;
  font-size: 16px;
  color: #999;
  text-decoration: none;
}
.bsdt-more:hover {
  color: #1c5cb4;
}
/* 新闻列表 */
.bsdt-news {
  width: 100%;
  margin-top: 32px;
  padding: 0;
  list-style: none;
}
.bsdt-news li {
  height: 40px;
  line-height: 40px;
  border-bottom: 1px dashed #ccc;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* 最后一条去掉虚线 */
.bsdt-news li:last-child {
  border-bottom: none;
}
.bsdt-news li a {
  font-size: 18px;
  color: #333;
  text-decoration: none;
  padding-left: 16px;
  position: relative;
}
/* 新闻前蓝色竖线符号 */
.bsdt-news li a::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 4px;
  height: 18px;
  background: #1c5cb4;
  border-radius: 2px;
}
.bsdt-news li a:hover {
  color: #1c5cb4;
}
</style>

