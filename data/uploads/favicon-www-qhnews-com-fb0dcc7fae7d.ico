/* 页面基础样式：清除默认外边距 */

body {

  margin-left: 0px;  /* 左外边距为0 */

  margin-top: 0px;   /* 上外边距为0 */

}

/* 专题栏目条容器 */

.topic-bar {

  /* 四层蓝色阴影叠加，实现从边框蓝色渐变到白色背景的光晕效果 */

  box-shadow:

    0 0 6px rgba(0, 120, 255, 0.5),    /* 第1层：紧贴边框，最实的蓝光 */

    0 0 14px rgba(0, 120, 255, 0.3),   /* 第2层：向外扩散，中等透明度 */

    0 0 28px rgba(0, 120, 255, 0.15),  /* 第3层：继续扩散，较淡 */

    0 0 45px rgba(0, 120, 255, 0.06);  /* 第4层：最外层，极淡，融入白色背景 */

  border-radius: 4px;  /* 四角圆角4像素 */

  font-size: 18px !important;  /* 容器级字号，强制覆盖模板默认值 */

}

/* 栏目条单元格：统管单元格内所有文字大小 */

.topic-bar td {

