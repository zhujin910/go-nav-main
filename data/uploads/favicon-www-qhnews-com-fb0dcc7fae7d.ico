/* ============================================================
   友情链接栏目（前缀 yqlj-）
   ============================================================ */

.yqlj-box {
  width: 1400px;
  margin: 0 auto;
  overflow: hidden;
}

/* 标签栏：底部1px黑线，左右留40px，标签居中排列 */
.yqlj-tabs {
  display: flex;
  width: 100%;
  border-bottom: 1px solid #000;
  padding: 0 40px;
  box-sizing: border-box;
  justify-content: center;
}

/* 每个标签：宽度由内容决定，不等分，左右内边距16px，标签间距8px */
.yqlj-tab {
  flex: 0 0 auto;
  text-align: center;
  font-size: 18px;
  color: #333;
  padding: 12px 16px;
  margin-right: 8px;
  cursor: pointer;
  text-decoration: none;
  position: relative;
  transition: color 0.2s;
}
.yqlj-tab:last-child {
  margin-right: 0;
}

/* 红线：3px，宽度跟随标签内容，基于黑线中间 */
.yqlj-tab::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -2px;
  width: 100%;
  height: 0;
  background: #d32f2f;
  transition: height 0.2s;
}

.yqlj-tab:hover::after,
.yqlj-tab.yqlj-active::after {
  height: 3px;
}
.yqlj-tab:hover,
.yqlj-tab.yqlj-active {
  color: #d32f2f;
  font-weight: bold;
}

/* 内容面板：左右内边距40px */
.yqlj-panel {
  display: none;
  padding: 20px 40px;
}
.yqlj-panel.yqlj-active {
  display: block;
}

/* 行内链接：| 由CSS伪元素统一生成，前后间距一致 */
.yqlj-inline {
  font-size: 14px;
  line-height: 2.2;
  text-align: left;
}
.yqlj-inline a {
  color: #333;
  text-decoration: none;
}
.yqlj-inline a::after {
  content: "|";
  margin: 0 8px;
  color: #ccc;
}
.yqlj-inline a:last-child::after {
  display: none;
}
.yqlj-inline a:hover {
  color: #1c5cb4;
  text-decoration: underline;
}

</style>

<!-- ========== 友情链接栏目HTML结构 ========== -->
<div class="yqlj-box">

  <!-- 顶部标签栏：5个主栏目居中排列 -->
