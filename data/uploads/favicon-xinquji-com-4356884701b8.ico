":1654,\"_964\":1655,\"_966\":1656,\"_968\":1657,\"_970\":1658,\"_972\":1659},\"Avatar\",\"Change Avatar\",\"Recommended: 400x400px, JPG/PNG, max 5MB.\",\"Profile Banner\",\"Change Banner\",\"Recommended: 1500x500px, JPG/PNG, max 10MB.\",\"Username\",\"Email\",\"Send Verification\",\"Email not verified, please check your inbox\",\"Email verified\",\"Headline\",\"e.g., Full-stack Developer / Indie Hacker\",\"This will appear below your name on your profile.\",{\"_975\":1661,\"_977\":1662,\"_979\":1663,\"_981\":1664,\"_983\":1665,\"_985\":1666},\"Change Password\",\"Current Password\",\"New Password\",\"Confirm New Password\",\"Password must be at least 6 characters\",\"Passwords do not match\",{\"_325\":1668,\"_499\":1669,\"_989\":1670,\"_991\":1671,\"_993\":1672,\"_995\":1673},\"Email Notifications\",\"Choose the types of emails you want to receive.\",\"Weekly Digest\",\"Sent every Monday with the hottest products and community updates from the past week.\",\"Comment Notifications\",\"Get notified when someone replies to your comment or mentions you.\",\"Save Changes\",{\"_999\":1676,\"_1001\":1677,\"_1003\":1678,\"_1005\":1679,\"_1007\":1680,\"_1009\":1681,\"_1011\":1682,\"_1013\":1683,\"_1015\":1684,\"_1017\":1665,\"_1018\":1685,\"_1020\":1686,\"_1022\":1687,\"_1024\":1688,\"_1026\":1689,\"_1028\":1682},\"Image size cannot exceed 5MB\",\"Only image files are allowed\",\"Avatar upload failed\",\"Image size cannot exceed 10MB\",\"Banner upload failed\",\"Verification email sent, please check your inbox\",\"Failed to send, please try again\",\"Not logged in\",\"Current password is incorrect\",\"Email already registered\",\"Saved successfully\",\"Save failed, please try again\",\"Avatar upload failed, please try again\",\"Banner upload failed, please try again\",{\"_325\":1323,\"_499\":1691,\"_1031\":1692,\"_397\":1693,\"_434\":1699,\"_709\":1701,\"_840\":1703,\"_490\":1707,\"_1060\":1710,\"_1066\":1713,\"_1068\":1713,\"_1069\":1714,\"_1071\":1715,\"_1073\":1716,\"_1075\":1717,\"_1077\":1718},\"View and manage all your submitted products and articles (including all review statuses)\",\"View public profile →\",{\"_1034\":1694,\"_1036\":1695,\"_1038\":1696,\"_1040\":1697,\"_1042\":1698},\"Total Products\",\"Approved Products\",\"Total Articles\",\"Published Articles\",\"(this page)\",{\"_1045\":1700,\"_345\":1314},\"Products\",{\"_336\":1309,\"_363\":1324,\"_1049\":1702,\"_233\":1260},\"View\",{\"_1052\":1704,\"_844\":1587,\"_842\":1705,\"_923\":1440,\"_1055\":1706},\"Approved\",\"Pending\",\"Scheduled\",{\"_283\":1708,\"_918\":1709},\"No products submitted yet\",\"No articles published yet\",{\"_1062\":1711,\"_1064\":1712},\"Created\",\"Updated\",\"Badge Missing\",\"Add the Xinquji badge to unlock Dofollow links. Please add it to your website and re-verify.\",\"Verify now →\",\"Publish Time\",\"Rejection Reason\",{\"_1079\":1719,\"_1081\":1720,\"_1083\":1721,\"_1085\":1722,\"_1087\":1723,\"_1089\":1724,\"_1091\":1725},\"Content doesn't match the website\",\"No badge detected\",\"Duplicate submission\",\"Purely promotional content\",\"SEO-driven content\",\"Content too brief\",\"Unrelated to the product ecosystem\",{\"_1094\":1727,\"_353\":1319,\"_355\":1320,\"_1096\":1728,\"_1098\":1729,\"_1100\":1730,\"_1102\":1731,\"_1104\":1732,\"_1106\":1733,\"_1108\":1320,\"_1110\":1734,\"_1112\":1319,\"_1114\":1735,\"_1116\":1736,\"_1118\":1737,\"_1120\":1738,\"_613\":1739,\"_390\":1744,\"_1142\":1746,\"_594\":1755,\"_1164\":1758,\"_311\":1764},\"Reset Password\",\"Welcome Back\",\"Create New Account\",\"Enter your email address and we'll send you a password reset link\",\"Remember your password?\",\"Back to Login\",\"Don't have an account?\",\"Already have an account?\",\"or use email\",\"Forgot password?\",\"Send Reset Email\",\"Processing...\",{\"_1123\":1740,\"_1125\":1741,\"_960\":1653,\"_1128\":1742,\"_1130\":1131,\"_1132\":1133,\"_1134\":1743},\"Nickname\",\"Your name\",\"Password\",\"At least 8 characters\",{\"_1137\":1745,\"_1139\":1339,\"_1140\":1140,\"_935\":1338},\"By logging in, you agree to our\",{\"_1144\":1747,\"_1028\":1748,\"_1147\":1749,\"_1017\":1665,\"_1018\":1685,\"_1149\":1750,\"_1151\":1751,\"_1153\":1752,\"_1155\":1753,\"_1157\":1754},\"Network connection failed, please check your network and try again\",\"Failed to send, please check the email address\",\"Please fill in the form completely\",\"Registration failed, please try again later\",\"Email and password are required\",\"Email or password is incorrect\",\"Login failed, please try again later\",\"Request failed, please try again\",{\"_1160\":1756,\"_1162\":1757},\"Password reset email sent, please check your inbox\",\"Password reset successful! Please log in with your new password\",{\"_325\":1759,\"_499\":1760,\"_979\":1663,\"_981\":1664,\"_985\":1666,\"_1017\":1761,\"_1120\":1738,\"_1170\":1727,\"_1171\":1762,\"_1173\":1763},\"Set New Password\",\"Please enter your new password\",\"Password must be at least 8 characters\",\"Password reset failed, please try again\",\"Network error, please try again later\",{\"_1176\":1319,\"_1177\":1320,\"_1178\":1727,\"_1179\":1765,\"_1181\":1766,\"_1183\":1767},\"Log in.\",\"Sign up.\",\"Reset password.\",{\"_386\":1769,\"_388\":1794,\"_390\":1813},{\"_325\":1770,\"_1188\":1771,\"_602\":1772},\"About Xinquji\",\"Learn about Xinquji — a community-driven product discovery and sharing platform connecting innovators with early adopters.\",[1773,1778,1782,1787],{\"_1192\":1774,\"_1194\":1775},\"Who We Are\",[1776,1777],\"Xinquji is a community-driven product discovery and sharing platform. We help developers, creators, and founders launch their products, and help early adopters discover the latest and coolest tech products.\",\"From productivity tools to AI applications, from developer tools to design resources, Xinquji brings together innovative products from around the world. New products launch here every day, competing on leaderboards through community upvotes and discussion.\",{\"_1192\":1779,\"_1194\":1780},\"Our Mission\",[1781],\"We believe every great product deserves to be discovered. Xinquji's mission is to connect innovators with early adopters, so great products get the attention they deserve and users find the tools that solve their problems faster.\",{\"_1192\":1783,\"_1194\":1784},\"Community \u0026 Engagement\",[1785,1786],\"On Xinquji, anyone can submit products, write articles, upvote, and comment. We encourage creators to interact directly with users and share the stories and insights behind their products.\",\"Want to explore popular topics? Browse our category list, or submit your product directly.\",{\"_1192\":1788,\"_1194\":1789,\"_421\":1352},\"Contact Us\",[1790,1791,1792,1793],\"We value feedback from every user. Whether it's product suggestions, feature requests, or issue reports, feel free to reach out to us.\",\"Email: support@xinquji.com\",\"For business partnerships or link exchange, please include your proposal and we'll respond within 1-3 business days.\",\"Scan the QR code with WeChat to contact the site owner:\",{\"_325\":1338,\"_1188\":1795,\"_602\":1796},\"Xinquji Privacy Policy — learn how we collect, use, and protect your personal information.\",[1797,1802,1806,1809],{\"_1192\":1798,\"_1194\":1799},\"Information We Collect\",[1800,1801],\"When you register an account, we collect your email address and username. When you submit products, write articles, or participate in comments, we collect the content you provide.\",\"We automatically record basic visit information, including IP address, browser type, pages visited, and time, used to analyze site performance and improve user experience.\",{\"_1192\":1803,\"_1194\":1804},\"How We Use Information\",[1805],\"We use the information we collect to provide and improve our services, including: displaying product content, maintaining account security, sending necessary service notifications, and optimizing the site experience through anonymized statistics.\",{\"_1192\":1227,\"_1194\":1807},[1808],\"We use cookies to remember your login status, language preference, and personalization settings. You can manage or delete cookies through your browser settings, though this may affect the proper functioning of some features.\",{\"_1192\":1810,\"_1194\":1811},\"Your Rights\",[1812],\"You have the right to access, correct, or delete your personal information. You can update your profile anytime in account settings, or request account and data deletion through the contact page.\",{\"_325\":1339,\"_1188\":1814,\"_602\":1815},\"Xinquji Terms of Service — the rules and agreements for using the Xinquji platform.\",[1816,1820,1825,1829],{\"_1192\":1817,\"_1194\":1818},\"Service Description\",[1819],\"Xinquji provides users with product submission, browsing, search, upvoting, commenting, and article writing services. By using this platform, you agree to these Terms of Service.\",{\"_1192\":1821,\"_1194\":1822},\"User Conduct\",[1823,1824],\"You agree that submitted content is truthful and lawful, does not infringe others' intellectual property, and contains no illegal, pornographic, violent, harassing, or hateful speech. We reserve the right to remove violating content and take action against violating accounts.\",\"Do not manipulate rankings through fake upvotes, fabricated reviews, or similar means. Violations will be handled seriously.\",{\"_1192\":1826,\"_1194\":1827},\"Intellectual Property\",[1828],\"You retain the copyright to your submitted content. By submitting content to Xinquji, you grant us a non-exclusive license to display and distribute it on the platform. The platform's trademarks, interface, and brand elements belong to Xinquji.\",{\"_1192\":1830,\"_1194\":1831},\"Disclaimer\",[1832,1833],\"Product information on Xinquji is submitted by users, and we make no warranty as to its accuracy or completeness. Please judge the suitability and safety of any product before using it.\",\"We reserve the right to modify, suspend, or termin