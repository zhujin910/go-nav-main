<script language="javascript">

var _umenu = $('.u_menu');
var _indexu = $('.index-u');
var _s;
var node_1 = new Array('-0px 0px', '-0px -220px', '0px -44px', '0px -88px', '0px -132px', '0px -176px');
var node_2 = new Array('-42px 0px', '-42px -220px', '-42px -44px', '-42px -88px', '-42px -132px');
_indexu.on('click', function () {
	menuview(true);
});

_umenu.on('mouseover', function () {
	menuview(true);
});

_umenu.on('mouseout', function () {
	menuview(false);
});
function menuview (s) {
	if(s) {
		_s && clearTimeout(_s);
		_umenu.show();

	} else {
		_s = setTimeout(function () {
			_umenu.hide();
		}, 300);
	}
}


$('.sidebar a').on('mouseover', function () {
    var _this = $(this);
    animation(_this, -1);
    if(_this.attr('class') == 'wechat') {
        _this.find('div').css({
            "width":'200px',
            "height":'200px',
            "opacity":'1'
        })
    }else if(_this.attr('class') == 'tel'){
        _this.find('div').css({
            "width":'200px',
            "height":'200px',
            "opacity":'1'
        })
    } else if(_this.attr('class') == 'service'){
        _this.find('div').css({
            "width":'200px',
            "height":'200px',
            "opacity":'1'
        })
        _this.find('a').show();
    }

});

$('.sidebar a').on('mouseout', function () {
    var _this = $(this);
    animation(_this, 1);
    _this.cancelBubble=true;
    _this.find('div').css({
        "opacity":'0',
        "width":'0px',
        "height":'0px'

    })

});
$('.sidebar a').on('click', function () {
    var _this = $(this);
    if(_this.attr('class') == 'backtop') {
        pageScroll();
    } else if(_this.attr('class') == 'licai') {
        window.open('/help-contrast.htm');
    } else if(_this.attr('class') == 'service') {
        //window.open('tencent://message/?uin=215151039&Site=qq&Menu=yes');
        javascript:window.open('http://wpa.qq.com/msgrd?v=3&uin=2230266396&site=qq&menu=yes', '_blank', 'height=502, width=644,toolbar=no,scrollbars=no,menubar=no,status=no');
    }
    return false;
});
function animation (obj, stat) {
    if (stat > 0) {
        obj.css('background-position',node_1[obj.index()]);
    } else {
        obj.css('background-position',node_2[obj.index()]);
    }

}
function search() {
    var keyword = $("#search_btn").val();
    if(!keyword || keyword == undefined) return;
    window.location = "/index-list----"+xn_urlencode(keyword)+"-.htm";
}
function pageScroll(){
    window.scrollBy(0,-100);
    scrolldelay = setTimeout('pageScroll()',10);
    var sTop=document.documentElement.scrollTop+document.body.scrollTop;
    if(sTop==0) clearTimeout(scrolldelay);
}

$(document).on("keydown", '#search_btn', function(e){
    if(e.keyCode == 13) {
        search();
    }
});
$.getUrlParam = function (name) {
    var reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)");
    var r = window.location.search.substr(1).match(reg);
    if (r != null) return unescape(r[2]); return null;
}

var _fcode = $.getUrlParam('fcode')
if(_fcode != null) {
    $.pdata('fcode', _fcode);
}

</script>
<script>
var _hmt = _hmt || [];
(function() {
  var hm = document.createElement("script");
  hm.src = "https://hm.baidu.com/hm.js?a67b2e336275760df52f9abb3756b665";
  var s = document.getElementsByTagName("script")[0]; 
  s.parentNode.insertBefore(hm, s);
})();
</script>

<script language="javascript">
    
    
    
    $(function () {
        $('.index-p-hot').on('mouseover', function () {
            $(this).find('.hot-menu').css('transform','translate(0%, -100%)');
        });

        $('.index-p-hot').on('mouseout', function () {
            $(this).find('.hot-menu').css('transform','translate(0%, 100%)');
        });
        $(".rec-project").on('mouseover', function () {
            $(this).find('.img-scale img').css('transform','scale(1.05)');
        });


        $(".rec-project").on('mouseout', function () {
            $(this).find('.img-scale img').css('transform','scale(1)');
        });
        $(".p-mod").find('li').on('mouseover', function () {
            $(this).find('.img-scale img').css('transform','scale(1.05)');
        });


        $(".p-mod").find('li').on('mouseout', function () {
            $(this).find('.img-scale img').css('transform','scale(1)');
        });

    });
    $('.circle').each(function(index, el) {

        var num = $(this).find('span').text() * 3.6;
        if (num <= 180) {
            $(this).find('.p_right').css('transform', "rotate(" + num + "deg)");
        } else if(num >360) {
            $(this).find('.p_right').css('transform', "rotate(180deg)");
            $(this).find('.p_left').css('transform', "rotate(" + (180) + "deg)");

        } else {
            $(this).find('.p_right').css('transform', "rotate(180deg)");
            $(this).find('.p_left').css('transform', "rotate(" + (num - 180) + "deg)");
        };
    });
    var swiper = new Swiper('.swiper-container', {
            pagination: '.swiper-pagination',
            paginationClickable: true,
            nextButton: '.swiper-button-next',
            prevButton: '.swiper-button-prev',
            spaceBetween: 30,
            loop: true,
            autoplay:3000,
            speed:800

        });
</script>
