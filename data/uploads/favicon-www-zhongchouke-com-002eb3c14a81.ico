<style type="text/css">
    .circle {
        margin-top:10px;
        width: 110px;
        height: 110px;
        position: relative;
        border-radius: 50%;
        background: #14364e;
    }
    .pie_left, .pie_right {
        width:110px;
        height:110px;
        position: absolute;
        top: 0;left: 0;
    }
    .p_left, .p_right {
        width:110px;
        height:110px;
        background:#d6d6db;
        border-radius: 50%;
        position: absolute;
        top: 0;
        left: 0;
    }
    .pie_right, .p_right {
        clip:rect(0,auto,auto,55px);
    }
    .pie_left, .p_left {
        clip:rect(0,55px,auto,0);
    }
    .mask {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        left: 10px;
        top: 10px;
        background: #FFF;
        position: absolute;
        text-align: center;
        line-height: 48px;
        font-size: 24px;
        color: #4e4e4e;
        padding-top:20px;
    }
    .mask >div{position: absolute; top:30px; left:6px; font-size:10px;}
        .swiper-container {
        width: 100%;
        height: 100%;
    }

    .circle160 {
        width: 160px;
        height: 160px;
        position: relative;
        border-radius: 50%;
        background: #14364e;
    }
    .circle160 .pie_left, .circle160 .pie_right {
        width:160px;
        height:160px;
        position: absolute;
        top: 0;left: 0;
    }
    .circle160 .p_left, .circle160 .p_right {
        width:160px;
        height:160px;
        background:#d6d6db;
        border-radius: 50%;
        position: absolute;
        top: 0;
        left: 0;
    }
    .circle160 .pie_right, .circle160 .p_right {
        clip:rect(0,auto,auto,80px);
    }
    .circle160 .pie_left, .circle160 .p_left {
        clip:rect(0,80px,auto,0);
    }
    .circle160 .mask {
        width: 130px;
