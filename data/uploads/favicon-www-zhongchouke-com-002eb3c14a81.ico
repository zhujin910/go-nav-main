            .sidebar .wechat, .sidebar .tel, .sidebar .service, .sidebar .backtop, .sidebar .sina, .sidebar .licai {background:url(/static/img/sidebar.png?123) no-repeat;}
            .sidebar .tel{background-position: 0px -44px;}
            .sidebar .service{background-position: 0px -88px;}
            .sidebar .backtop{background-position: 0px -132px;}
            .sidebar .sina{background-position: 0px -176px;}
            .sidebar .licai{background-position: 0px -220px;}
            .wechat >div, .tel >div {position: absolute; width:1px; height:1px; opacity: 0; transition: opacity 0.2s ease 0s;}
            .wechat >div {left:-200px; top:-148px;  background:url(/static/img/wechat_vip.png) no-repeat center; }
            .tel >div {left:-180px; top:-106px; background:url(/static/img/call.png?123) no-repeat center; }
            .service >div {left:-210px; top:-106px; border-radius: 3px; background:black;}
            .service > div{display:none;}
        </style>
