    <script type="text/javascript">
        $().ready(function () {
            $("div.home_menu_list:eq(0)>ul>li").on("mouseenter", function () {
                if ($(this).find("div.home_menu_listShow").length <= 0) {
                    var divv = document.createElement("div");
                    divv.className = " home_menu_listShow hide";
                    var lival = $(this).html();
                    divv.innerHTML = $(this).html();
                    $(divv).find("em.home_menu_btn").remove();
                    $(divv).find("a:hidden").show();
                    $(this).append(divv);
                }
                $(this).find("div.home_menu_listShow.hide").removeClass("hide");
            });
            $("div.home_menu_list:eq(0)>ul>li").on("mouseleave", function () {
                if ($(this).find("div.home_menu_listShow").length > 0) {
                    $(this).find("div.home_menu_listShow").addClass("hide");
                }
            });


            $("div.book_jszj>ul>li").on("click", function () {
                $("div.hp_gxdj_content ul:visible").addClass("hide");
                $("div.book_jszj>ul>li.active").removeClass("active");
                $(this).addClass("active");
                $("div.hp_gxdj_content ul").eq($(this).index()).removeClass("hide");
            });
            TabAction("div.hP_jrjq_nav>ul:eq(0) li", "div.hP_jrjq_content:eq(0)>div");
            TabAction("div.hP_jrjq_nav>ul:eq(1) li", "div.hP_jrjq_content:eq(1)>div");
            $("div.hP_herit_search>div.hy_seleLeft>span").on("click", function (e) {
                $(this).next().show();
                e.stopPropagation();
            });

            $("div.hP_herit_search>div.hy_seleLeft>div.hy_seleHide i").on("click", function (e) {
                $(this).parent().parent().find("input[type='hidden'][name]").val($(this).find("a").attr("data-val"));
                $(this).parent().hide();
                $(this).parent().prev("span").text($(this).text());
                e.stopPropagation();
            });

            document.body.addEventListener("click", function (e) {
                if ($("div.hy_seleHide:visible").length == 1 && !$(e.target).hasClass("hy_seleHide")) {
                    $("div.hy_seleHide:visible").hide();
                    return;
                }
            });
            $("div.hP_hanyu_search>div.hy_seleLeft>span").on("click", function (e) {
                $(this).next().show();
                e.stopPropagation();
            });
            $("div.hP_hanyu_search>div.hy_seleLeft>div>i").on("click", function (e) {
                $("form[data-id='zidian_cha']").attr("action", $(this).attr("data-val"));
                $(this).parent().hide();
                $(this).parent().prev("span").text($(this).text());
                e.stopPropagation();
            });

            TabAction("div.hP_fame_nav>ul:eq(0) li", "div.fame_content:eq(0)>div");
        });
    </script>
