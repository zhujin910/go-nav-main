r list-none items-center gap-2 rounded-full border border-border/70 bg-background/80 px-3 py-2 text-sm font-medium shadow-sm sm:px-4" aria-expanded="false" aria-label="菜单"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu h-4 w-4"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg><span class="hidden min-[360px]:inline">菜单</span></button></div></div></header><main><script type="application/ld+json">{"@context":"https://schema.org","@type":"WebApplication","name":"GIF Master","url":"https://gif-master.com/zh","applicationCategory":"MultimediaApplication","operatingSystem":"Web","inLanguage":"zh-CN","isAccessibleForFree":true,"description":"GIF Master 是一个免费在线 GIF 工具站，支持视频转GIF、GIF转MP4、GIF压缩到指定大小和动图制作，核心处理在浏览器本地完成。","featureList":["视频转GIF","GIF压缩","批量压缩GIF","GIF 转视频","去除 GIF 背景","GIF 播放速度调整","裁剪 GIF 动图","模糊 GIF","GIF 转 PNG","GIF 转 JPG","GIF 转 Lottie","GIF 转 APNG","GIF 转 WebP","WebP 转 GIF","PNG 转 GIF","在线录屏","倒计时 GIF 生成器","源文件留在你的浏览器和当前设备中","核心处理不依赖服务器文件管线","最终导出从浏览器本地内存下载"],"isPartOf":{"@type":"WebSite","name":"GIF Master","url":"https://gif-master.com"}}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"ItemList","name":"选择你的在线 GIF 工具","description":"围绕制作、压缩、录制和生成 GIF 的真实任务设计，打开页面就能开始处理当前任务。","itemListElement":[{"@type":"ListItem","position":1,"item":{"@type":"WebPage","name":"视频转GIF","description":"把视频快速转换为 GIF，并在同一个编辑器里添加文字、图片、箭头、emoji、矩形框、圆形框和马赛克，让操作过程一眼看懂。","url":"https://gif-master.com/zh/tools/video-to-gif"}},{"@type":"ListItem","position":2,"item":{"@type":"WebPage","name":"GIF压缩","description":"输入想要的文件大小，自动压缩 GIF，方便上传到微信、X/Twitter、Discord、Slack、Reddit、Telegram 等平台。","url":"https://gif-master.com/zh/tools/gif-compressor"}},{"@type":"ListItem","position":3,"item":{"@type":"WebPage","name":"批量压缩GIF","description":"一次处理多个 GIF 文件，适合文档、营销素材和批量上传前的体积优化。","url":"https://gif-master.com/zh/tools/batch-gif-compressor"}},{"@type":"ListItem","position":4,"item":{"@type":"WebPage","name":"GIF 转视频","description":"在浏览器本地将动态 GIF 转为 MP4、WebM 或 MOV 视频，并可设置目标视频时长。","url":"https://gif-master.com/zh/tools/gif-to-video"}},{"@type":"ListItem","position":5,"item":{"@type":"WebPage","name":"去除 GIF 背景","description":"在浏览器本地去除纯色 GIF 背景，支持手动修补残留边缘，并导出透明 GIF，无需上传服务器。","url":"https://gif-master.com/zh/tools/remove-gif-background"}},{"@type":"ListItem","position":6,"item":{"@type":"WebPage","name":"GIF 播放速度调整","description":"批量加速或减慢 GIF 动图。","url":"https://gif-master.com/zh/tools/gif-speed-changer"}},{"@type":"ListItem","position":7,"item":{"@type":"WebPage","name":"裁剪 GIF 动图","description":"裁剪 GIF 动图画面区域，并设置导出宽度或高度。","url":"https://gif-master.com/zh/tools/crop-gif"}},{"@type":"ListItem","position":8,"item":{"@type":"WebPage","name":"模糊 GIF","description":"在浏览器本地模糊整张 GIF 或选定区域，可按时间隐藏人脸、文字和其他敏感信息。","url":"https://gif-master.com/zh/tools/blur-gif"}},{"@type":"ListItem","position":9,"item":{"@type":"WebPage","name":"GIF 转 PNG","description":"将一个或多个 GIF 的第一帧、全部帧或自定义选取的帧提取为 PNG 图片，文件在浏览器本地处理。","url":"https://gif-master.com/zh/tools/gif-to-png"}},{"@type":"ListItem","position":10,"item":{"@type":"WebPage","name":"GIF 转 JPG","description":"将 GIF 的首帧、全部帧或指定帧导出为 JPG 图片，可设置 JPEG 质量与透明区域背景色。","url":"https://gif-master.com/zh/tools/gif-to-jpg"}},{"@type":"ListItem","position":11,"item":{"@type":"WebPage","name":"GIF 转 Lottie","description":"在浏览器本地将多个动态 GIF 分别转为 .lottie 动画包和独立 Lottie JSON，保留动画节奏与透明背景。","url":"https://gif-master.com/zh/tools/gif-to-lottie"}},{"@type":"ListItem","position":12,"item":{"@type":"WebPage","name":"GIF 转 APNG","description":"将一个或多个动态 GIF 转为 APNG 动图，保留动画时间和透明区域，文件在浏览器本地处理。","url":"https://gif-master.com/zh/tools/gif-to-apng"}},{"@type":"ListItem","position":13,"item":{"@type":"WebPage","name":"GIF 转 WebP","description":"将一个或多个动态 GIF 转为 WebP，可设置有损或无损质量，并保留动画和透明区域。","url":"https://gif-master.com/zh/tools/gif-to-webp"}},{"@type":"ListItem","position":14,"item":{"@type":"WebPage","name":"WebP 转 GIF","description":"将静态或动态 WebP 转为 GIF，可调整尺寸、播放速度、颜色质量和透明背景处理。","url":"https://gif-master.com/zh/tools/webp-to-gif"}},{"@type":"ListItem","position":15,"item":{"@type":"WebPage","name":"PNG 转 GIF","description":"将一张或多张 PNG 图片合成为 GIF 动图，调整帧顺序和播放速度，文件在浏览器本地处理。","url":"https://gif-master.com/zh/tools/png-to-gif"}},{"@type":"ListItem","position":16,"item":{"@type":"WebPage","name":"在线录屏","description":"直接在浏览器里录标签页、窗口或整个屏幕。录完后可以先本地保存和下载，也可以一键继续转成 GIF。","url":"https://gif-master.com/zh/tools/screen-recorder"}},{"@type":"ListItem","position":17,"item":{"@type":"WebPage","name":"倒计时 GIF 生成器","description":"设置秒或分钟倒计时，自定义标题、颜色和版式，直接在浏览器里生成并导出短时倒计时 GIF。","url":"https://gif-master.com/zh/tools/countdown-gif-generator"}}]}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"GIF Master 是什么？","acceptedAnswer":{"@type":"Answer","text":"GIF Master 是一个免费的在线 GIF 工具平台，支持在浏览器中制作、转换、压缩、录制和生成 GIF。"}},{"@type":"Question","name":"我的文件会上传到服务器吗？","acceptedAnswer":{"@type":"Answer","text":"不会。支持本地处理的工具会在浏览器中处理文件，不需要上传到我们的服务器，因此也不用在处理前漫长等待上传。"}},{"@type":"Question","name":"可以在线把视频转成 GIF 吗？","acceptedAnswer":{"@type":"Answer","text":"可以。你可以上传视频，截取需要的片段，添加标注，然后直接在浏览器中导出 GIF。"}},{"@type":"Question","name":"可以把 GIF 转为 MP4 吗？","acceptedAnswer":{"@type":"Answer","text":"可以。打开 GIF 转视频工具，在浏览器支持 H.264 编码时选择 MP4；可以保留原时长，也可以让短 GIF 重复到设定的视频时长。"}},{"@type":"Question","name":"可以把视频转 GIF 后压缩到指定大小吗？","acceptedAnswer":{"@type":"Answer","text":"可以。导出 GIF 后，在 Results 中点击“压缩到指定大小”。GIF 会在本地传给 GIF压缩工具，你可以再选预设或自定义目标大小。"}},{"@type":"Question","name":"可以把 GIF 压缩到指定大小吗？","acceptedAnswer":{"@type":"Answer","text":"可以。GIF压缩工具支持设置目标大小，并结合尺寸调整和抽帧来减少 GIF 体积。"}}]}</script><section class="overflow-hidden border-b border-border/70 bg-[radial-gradient(circle_at_top_left,rgba(238,119,82,0.18),transparent_32%),radial-gradient(