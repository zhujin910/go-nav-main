0 hover:bg-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 sm:min-h-[5rem] sm:p-4" href="/zh/tools/webp-to-gif"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-[hsl(var(--brand-2))]/10 text-[hsl(var(--brand-2))] sm:h-10 sm:w-10"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-image h-5 w-5" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg></span><span class="min-w-0"><span class="text-mobile-safe block text-sm font-semibold tracking-tight sm:text-base">WebP 转 GIF</span><span class="text-mobile-safe mt-1 hidden text-xs leading-5 text-muted-foreground sm:line-clamp-1">将静态或动态 WebP 转为 GIF，可调整尺寸、播放速度、颜色质量和透明背景处理。</span></span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-auto hidden h-4 w-4 shrink-0 text-muted-foreground transition group-hover:translate-x-0.5 sm:block" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><a class="group flex min-h-[4.5rem] min-w-0 items-center gap-3 rounded-lg border border-border/70 bg-background/80 p-3 shadow-sm backdrop-blur transition hover:border-[hsl(var(--brand-2))]/40 hover:bg-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 sm:min-h-[5rem] sm:p-4" href="/zh/tools/png-to-gif"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-[hsl(var(--brand-2))]/10 text-[hsl(var(--brand-2))] sm:h-10 sm:w-10"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-image h-5 w-5" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg></span><span class="min-w-0"><span class="text-mobile-safe block text-sm font-semibold tracking-tight sm:text-base">PNG 转 GIF</span><span class="text-mobile-safe mt-1 hidden text-xs leading-5 text-muted-foreground sm:line-clamp-1">将一张或多张 PNG 图片合成为 GIF 动图，调整帧顺序和播放速度，文件在浏览器本地处理。</span></span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-auto hidden h-4 w-4 shrink-0 text-muted-foreground transition group-hover:translate-x-0.5 sm:block" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><a class="group flex min-h-[4.5rem] min-w-0 items-center gap-3 rounded-lg border border-border/70 bg-background/80 p-3 shadow-sm backdrop-blur transition hover:border-[hsl(var(--brand-2))]/40 hover:bg-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 sm:min-h-[5rem] sm:p-4" href="/zh/tools/screen-recorder"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-[hsl(var(--brand-2))]/10 text-[hsl(var(--brand-2))] sm:h-10 sm:w-10"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-scan-line h-5 w-5" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h2"></path><path d="M17 3h2a2 2 0 0 1 2 2v2"></path><path d="M21 17v2a2 2 0 0 1-2 2h-2"></path><path d="M7 21H5a2 2 0 0 1-2-2v-2"></path><path d="M7 12h10"></path></svg></span><span class="min-w-0"><span class="text-mobile-safe block text-sm font-semibold tracking-tight sm:text-base">在线录屏</span><span class="text-mobile-safe mt-1 hidden text-xs leading-5 text-muted-foreground sm:line-clamp-1">直接在浏览器里录标签页、窗口或整个屏幕。录完后可以先本地保存和下载，也可以一键继续转成 GIF。</span></span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-auto hidden h-4 w-4 shrink-0 text-muted-foreground transition group-hover:translate-x-0.5 sm:block" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><a class="group flex min-h-[4.5rem] min-w-0 items-center gap-3 rounded-lg border border-border/70 bg-background/80 p-3 shadow-sm backdrop-blur transition hover:border-[hsl(var(--brand-2))]/40 hover:bg-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 sm:min-h-[5rem] sm:p-4" href="/zh/tools/countdown-gif-generator"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-[hsl(var(--brand-2))]/10 text-[hsl(var(--brand-2))] sm:h-10 sm:w-10"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock3 h-5 w-5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16.5 12"></polyline></svg></span><span class="min-w-0"><span class="text-mobile-safe block text-sm font-semibold tracking-tight sm:text-base">倒计时 GIF 生成器</span><span class="text-mobile-safe mt-1 hidden text-xs leading-5 text-muted-foreground sm:line-clamp-1">设置秒或分钟倒计时，自定义标题、颜色和版式，直接在浏览器里生成并导出短时倒计时 GIF。</span></span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-auto hidden h-4 w-4 shrink-0 text-muted-foreground transition group-hover:translate-x-0.5 sm:block" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></nav></div></section><section class="border-b border-border/70 bg-muted/20"><div class="mx-auto grid max-w-7xl gap-3 px-4 py-6 sm:grid-cols-2 sm:px-6 lg:grid-cols-5"><div class="flex items-start gap-3 rounded-lg border border-border/60 bg-background/70 p-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock3 mt-0.5 h-5 w-5 shrink-0 text-[hsl(var(--brand-2))]" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16.5 12"></polyline></svg><p class="text-sm leading-6 text-muted-foreground">浏览器本地处理文件</p></div><div class="flex items-start gap-3 rounded-lg border border-border/60 bg-background/70 p-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check mt-0.5 h-5 w-5 shrink-0 text-[hsl(var(--brand-2))]" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg><p class="text-sm leading-6 text-muted-foreground">无需上传到服务器</p></div><div class="flex items-start gap-3 rounded-lg border border-border/60 bg-background/70 p-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layers3 mt-0.5 h-5 w-5 shrink-0 text-[hsl(var(--brand-2))]" aria-hidden="true"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"></path><path d="m6.08 9.5-3.5 1.6a1 1 0 0 0 0 1.81l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9a1 1 0 0 0 0-1.83l-3.5-1.59"></path><path d="m6.08 14.5-3.5 1.6a1 1 0 0 0 0 1.81l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9a1 1 0 0 0 0-1.83l-3.5-1.59"></path></svg><p class="text-sm leading-6 text-muted-foreground">不用漫长等待上传</p></div><div class="flex items-start gap-3 rounded-lg border border-border/60 bg-background/70 p-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-badge-check mt-0.5 h-5 w-5 shrink-0 text-[hsl(var(--brand-2))]" aria-hidden="true"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"></path><path d="m9 12 2 2 4-4"></path></svg><p class="text-sm leading-6 text-muted-foreground">打开即可开始处理</p></div><div class="flex items-start gap-3 rounded-lg border border-border/60 bg-background/70 p-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles mt-0.5 h-5 w-5 shrink-0 text-[hsl(var(--brand-2))]" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg><p class="text-sm leading-6 text-muted-foreground">免费可试用</p></div></div></section><section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20"><div class="max-w-3xl space-y-4"><p class="text-sm font-semibold uppercase tracking-[0.24em] text-[hsl(var(--brand-2))]">核心工具</p><h2 class="text-mobile-safe text-2xl font-semibold tracking-tight text-balance sm:text-4xl">选择你的在线 GIF 工具</h2><p class="text-mobile-safe text-base leading-7 text-muted-foreground sm:text-lg">围绕制作、压缩、录制和生成 GIF 的真实任务设计，每个工具都尽量在浏览器本地完成核心处理。</p></div><div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-4"><article class="rounded-[1.25rem] border border-border/70 bg-muted/35 p-5"><h3 class="text-mobile-safe text-base font-semibold tracking-tight">制作与转换 GIF</h3><p class="mt-3 text-sm leading-6 text-muted-foreground">在视频、GIF 和 PNG 之间转换，制作需要的动图。</p><p class="mt-4 text-xs font-medium uppercase tracking-[0.18em] text-[hsl(var(--brand-2))]"><span><a class="rounded-sm transition hover:text-[hsl(var(--brand-2))]/80 hover:underline" href="/zh/tools/video-to-gif">视频转GIF</a></span><span><span class="px-1 text-muted-foreground">·</span><a class="rounded-sm transition hover:text-[hsl(var(--brand-2))]/80 hover:underline" href="/zh/tools/gif-to-video">GIF 转视频</a></span><span><span class="px-1 text-muted-foreground">·</span><a class="rounded-sm transition hover:text-[hsl(var(--brand-2))]/80 hover:underline" href="/zh/tools/png-to-gif">PNG 转 GIF</a></span><span><span class="px-1 text-muted-foreground">·</span><a class="rounded-sm transition hover:text-[hsl(var(--brand-2))]/80 hover:underline" href="/zh/tools/gif-to-png">GIF 转 PNG</a></span><span><span class="px-1 text-muted-foreground">·</span><a class="rounded-sm transition hover:text-[hsl(var(--brand-2))]/80 hover:underline" href="/zh/tools/gif-to-jpg">GIF 转 JPG</a></span><span><span class="px-1 text-muted-foreground">·</span><a class="rounded-sm transition hover:text-[hsl(var(--brand-2))]/80 hover:underline" href="/zh/tools/gif-to-lottie">GIF 转 Lottie</a></span><span><span class="px-1 text-muted-foreground">·</span><a class="rounded-sm transition hover:text-[hsl(var(--brand-2))]/80 hover:underline" href="/zh/tools/gif-to-apng">GIF 转 APNG</a></span><span><span class="px-1 text-muted-foreground">·</span><a class="rounded-sm transition hover:text-[hsl(var(--brand-2))]/80 hover:underline" href="/zh/tools/gif-to-webp">GIF 转 WebP</a></span><span><span class="px-1 text-muted-foreground">·</span><a class="rounded-sm transition hover:text-[hsl(var(--brand-2))]/80 hover:underline" href="/zh/tools/webp-to-gif">WebP 转 GIF</a></span></p></article><article class="rounded-[1.25rem] border border-border/70 bg-muted/35 p-5"><h3 class="text-mobile-safe text-base font-semibold tracking-tight">优化 GIF</h3><p class="mt-3 text-sm leading-6 text-muted-foreground">压缩体积，处理背景和不想展示的画面区域。</p><p class="mt-4 text-xs font-medium uppercase tracking-[0.18em] text-[hsl(var(--brand-2))]"><span><a class="rounded-sm transition hover:text-[hsl(var(--brand-2))]/80 hover:underline" href="/zh/tools/gif-compressor">GIF压缩</a></span><span><span class="px-1 text-muted-foreground">·</span><a class="rounded-sm transition hover:text-[hsl(var(--brand-2))]/80 hover:underline" href="/zh/tools/batch-gif-compressor">批量压缩GIF</a></span><span><span class="px-1 text-muted-foreground">·</span><a class="rounded-sm transition hover:text-[hsl(var(--brand-2))]/80 hover:underline" href="/zh/tools/remove-gif-background">去除 GIF 背景</a></span><span><span class="px-1 text-muted-foreground">·</span><a class="rounded-sm transition hover:text-[hsl(var(--brand-2))]/80 hover:underline" href="/zh/tools/gif-speed-changer">GIF 播放速度调整</a></span><span><span class="px-1 text-muted-foreground">·</span><a class="rounded-sm transition hover:text-[hsl(var(--brand-2))]/80 hover:underline" href="/zh/tools/crop-gif">裁剪 GIF 动图</a></span><span><span class="px-1 text-muted-foreground">·</span><a class="rounded-sm transition hover:text-[hsl(var(--brand-2))]/80 hover:underline" href="/zh/tools/blur-gif">模糊 GIF</a></span></p></article><article class="rounded-[1.25rem] border border-border/70 bg-muted/35 p-5"><h3 class="text-mobile-safe text-base font-semibold tracking-tight">录制 GIF</h3><p class="mt-3 text-sm leading-6 text-muted-foreground">录制屏幕视频后继续制作 GIF。</p><p class="mt-4 text-xs font-medium uppercase tracking-[0.18em] text-[hsl(var(--brand-2))]"><span><a class="rounded-sm transition hover:text-[hsl(var(--brand-2))]/80 hover:underline" href="/zh/tools/screen-recorder">在线录屏</a></span></p></article><article class="rounded-[1.25rem] border border-border/70 bg-muted/35 p-5"><h3 class="text-mobile-safe text-base font-semibold tracking-tight">生成 GIF</h3><p class="mt-3 text-sm leading-6 text-muted-foreground">直接生成倒计时等实用动图素材。</p><p class="mt-4 text-xs font-medium uppercase tracking-[0.18em] text-[hsl(var(--brand-2))]"><span><a class="rounded-sm transition hover:text-[hsl(var(--brand-2))]/80 hover:underline" href="/zh/tools/countdown-gif-generator">倒计时 GIF 生成器</a></span></p></article></div><div class="mt-10 grid gap-6 lg:grid-cols-3"><article class="group rounded-[1.5rem] border border-border/70 bg-card/80 p-6 shadow-[0_20px_60px_rgba(15,23,42,0.08)] transition hover:-translate-y-1 hover:border-[hsl(var(--brand-2))]/40 hover:shadow-[0_24px_70px_rgba(15,23,42,0.12)] sm:rounded-[2rem] sm:p-8"><p class="text-xs font-semibold uppercase tracking-[0.22em] text-[hsl(var(--brand-2))]">制作 GIF</p><h3 class="text-mobile-safe mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">视频转GIF</h3><p class="text-mobile-safe mt-4 text-sm leading-7 text-muted-foreground">把视频快速转换为 GIF，并在同一个编辑器里添加文字、图片、箭头、emoji、矩形框、圆形框和马赛克，让操作过程一眼看懂。</p><ul class="mt-6 space-y-3"><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>适合产品 Demo、功能演示和教程说明</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>不需要专业视频剪辑软件，上传后即可编辑</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>核心处理在浏览器本地完成，素材不用上传服务器</span></li></ul><a class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-9 py-2 mt-8 rounded-full px-6" href="/zh/tools/video-to-gif">视频转GIF<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-2 h-4 w-4 transition group-hover:translate-x-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></article><article class="group rounded-[1.5rem] border border-border/70 bg-card/80 p-6 shadow-[0_20px_60px_rgba(15,23,42,0.08)] transition hover:-translate-y-1 hover:border-[hsl(var(--brand-2))]/40 hover:shadow-[0_24px_70px_rgba(15,23,42,0.12)] sm:rounded-[2rem] sm:p-8"><p class="text-xs font-semibold uppercase tracking-[0.22em] text-[hsl(var(--brand-2))]">优化 GIF</p><h3 class="text-mobile-safe mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">GIF压缩</h3><p class="text-mobile-safe mt-4 text-sm leading-7 text-muted-foreground">输入想要的文件大小，自动压缩 GIF，方便上传到微信、X/Twitter、Discord、Slack、Reddit、Telegram 等平台。</p><ul class="mt-6 space-y-3"><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>按目标体积自动优化，减少反复调参</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>浏览器本地压缩，隐私素材更安心</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>支持尺寸调整、抽帧和压缩参数</span></li></ul><a class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-9 py-2 mt-8 rounded-full px-6" href="/zh/tools/gif-compressor">压缩GIF<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-2 h-4 w-4 transition group-hover:translate-x-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></article><article class="group rounded-[1.5rem] border border-border/70 bg-card/80 p-6 shadow-[0_20px_60px_rgba(15,23,42,0.08)] transition hover:-translate-y-1 hover:border-[hsl(var(--brand-2))]/40 hover:shadow-[0_24px_70px_rgba(15,23,42,0.12)] sm:rounded-[2rem] sm:p-8"><p class="text-xs font-semibold uppercase tracking-[0.22em] text-[hsl(var(--brand-2))]">批量压缩</p><h3 class="text-mobile-safe mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">批量压缩GIF</h3><p class="text-mobile-safe mt-4 text-sm leading-7 text-muted-foreground">一次处理多个 GIF 文件，适合文档、营销素材和批量上传前的体积优化。</p><ul class="mt-6 space-y-3"><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>适合同时压缩多张 GIF</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>方便整理文档、活动页和社媒素材</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>分别查看每个 GIF 的处理进度并下载压缩结果</span></li></ul><a class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-9 py-2 mt-8 rounded-full px-6" href="/zh/tools/batch-gif-compressor">批量压缩GIF<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-2 h-4 w-4 transition group-hover:translate-x-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></article><article class="group rounded-[1.5rem] border border-border/70 bg-card/80 p-6 shadow-[0_20px_60px_rgba(15,23,42,0.08)] transition hover:-translate-y-1 hover:border-[hsl(var(--brand-2))]/40 hover:shadow-[0_24px_70px_rgba(15,23,42,0.12)] sm:rounded-[2rem] sm:p-8"><p class="text-xs font-semibold uppercase tracking-[0.22em] text-[hsl(var(--brand-2))]">视频导出</p><h3 class="text-mobile-safe mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">GIF 转视频</h3><p class="text-mobile-safe mt-4 text-sm leading-7 text-muted-foreground">在浏览器本地将动态 GIF 转为 MP4、WebM 或 MOV 视频，并可设置目标视频时长。</p><ul class="mt-6 space-y-3"><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>保留 GIF 原始帧时间</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>将短 GIF 重复到目标视频时长</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>选择浏览器支持的视频格式</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>视频结果保存在当前浏览器</span></li></ul><a class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-9 py-2 mt-8 rounded-full px-6" href="/zh/tools/gif-to-video">GIF 转视频<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-2 h-4 w-4 transition group-hover:translate-x-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></article><article class="group rounded-[1.5rem] border border-border/70 bg-card/80 p-6 shadow-[0_20px_60px_rgba(15,23,42,0.08)] transition hover:-translate-y-1 hover:border-[hsl(var(--brand-2))]/40 hover:shadow-[0_24px_70px_rgba(15,23,42,0.12)] sm:rounded-[2rem] sm:p-8"><p class="text-xs font-semibold uppercase tracking-[0.22em] text-[hsl(var(--brand-2))]">透明 GIF</p><h3 class="text-mobile-safe mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">去除 GIF 背景</h3><p class="text-mobile-safe mt-4 text-sm leading-7 text-muted-foreground">在浏览器本地去除纯色 GIF 背景，支持手动修补残留边缘，并导出透明 GIF，无需上传服务器。</p><ul class="mt-6 space-y-3"><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>适合白底、绿幕和简单纯色背景 GIF</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>支持逐帧橡皮擦和恢复画笔修补</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>100% 浏览器本地处理，不走云端文件管线</span></li></ul><a class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-9 py-2 mt-8 rounded-full px-6" href="/zh/tools/remove-gif-background">去除GIF背景<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-2 h-4 w-4 transition group-hover:translate-x-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></article><article class="group rounded-[1.5rem] border border-border/70 bg-card/80 p-6 shadow-[0_20px_60px_rgba(15,23,42,0.08)] transition hover:-translate-y-1 hover:border-[hsl(var(--brand-2))]/40 hover:shadow-[0_24px_70px_rgba(15,23,42,0.12)] sm:rounded-[2rem] sm:p-8"><p class="text-xs font-semibold uppercase tracking-[0.22em] text-[hsl(var(--brand-2))]">GIF 播放</p><h3 class="text-mobile-safe mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">GIF 播放速度调整</h3><p class="text-mobile-safe mt-4 text-sm leading-7 text-muted-foreground">批量加速或减慢 GIF 动图。</p><ul class="mt-6 space-y-3"><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>1.1 倍到 50 倍精细调节</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>负数减慢，正数加快</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>支持浏览器本地批量处理</span></li></ul><a class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-9 py-2 mt-8 rounded-full px-6" href="/zh/tools/gif-speed-changer">调整 GIF 播放速度<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-2 h-4 w-4 transition group-hover:translate-x-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></article><article class="group rounded-[1.5rem] border border-border/70 bg-card/80 p-6 shadow-[0_20px_60px_rgba(15,23,42,0.08)] transition hover:-translate-y-1 hover:border-[hsl(var(--brand-2))]/40 hover:shadow-[0_24px_70px_rgba(15,23,42,0.12)] sm:rounded-[2rem] sm:p-8"><p class="text-xs font-semibold uppercase tracking-[0.22em] text-[hsl(var(--brand-2))]">GIF 裁剪</p><h3 class="text-mobile-safe mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">裁剪 GIF 动图</h3><p class="text-mobile-safe mt-4 text-sm leading-7 text-muted-foreground">裁剪 GIF 动图画面区域，并设置导出宽度或高度。</p><ul class="mt-6 space-y-3"><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>拖拽裁剪区域</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>精确像素控制</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>导出后保持动画</span></li></ul><a class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-9 py-2 mt-8 rounded-full px-6" href="/zh/tools/crop-gif">裁剪 GIF 动图<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-2 h-4 w-4 transition group-hover:translate-x-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></article><article class="group rounded-[1.5rem] border border-border/70 bg-card/80 p-6 shadow-[0_20px_60px_rgba(15,23,42,0.08)] transition hover:-translate-y-1 hover:border-[hsl(var(--brand-2))]/40 hover:shadow-[0_24px_70px_rgba(15,23,42,0.12)] sm:rounded-[2rem] sm:p-8"><p class="text-xs font-semibold uppercase tracking-[0.22em] text-[hsl(var(--brand-2))]">隐私处理</p><h3 class="text-mobile-safe mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">模糊 GIF</h3><p class="text-mobile-safe mt-4 text-sm leading-7 text-muted-foreground">在浏览器本地模糊整张 GIF 或选定区域，可按时间隐藏人脸、文字和其他敏感信息。</p><ul class="mt-6 space-y-3"><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>默认即可一键模糊整张 GIF</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>支持多个局部区域和时间段</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>可选择模糊、像素化或纯色遮挡</span></li></ul><a class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-9 py-2 mt-8 rounded-full px-6" href="/zh/tools/blur-gif">模糊 GIF<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-2 h-4 w-4 transition group-hover:translate-x-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></article><article class="group rounded-[1.5rem] border border-border/70 bg-card/80 p-6 shadow-[0_20px_60px_rgba(15,23,42,0.08)] transition hover:-translate-y-1 hover:border-[hsl(var(--brand-2))]/40 hover:shadow-[0_24px_70px_rgba(15,23,42,0.12)] sm:rounded-[2rem] sm:p-8"><p class="text-xs font-semibold uppercase tracking-[0.22em] text-[hsl(var(--brand-2))]">帧提取</p><h3 class="text-mobile-safe mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">GIF 转 PNG</h3><p class="text-mobile-safe mt-4 text-sm leading-7 text-muted-foreground">将一个或多个 GIF 的第一帧、全部帧或自定义选取的帧提取为 PNG 图片，文件在浏览器本地处理。</p><ul class="mt-6 space-y-3"><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>默认直接提取 GIF 第一帧</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>支持提取全部帧或自定义勾选帧</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>GIF 任务和 PNG 结果保存在当前浏览器</span></li></ul><a class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-9 py-2 mt-8 rounded-full px-6" href="/zh/tools/gif-to-png">GIF 转 PNG<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-2 h-4 w-4 transition group-hover:translate-x-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></article><article class="group rounded-[1.5rem] border border-border/70 bg-card/80 p-6 shadow-[0_20px_60px_rgba(15,23,42,0.08)] transition hover:-translate-y-1 hover:border-[hsl(var(--brand-2))]/40 hover:shadow-[0_24px_70px_rgba(15,23,42,0.12)] sm:rounded-[2rem] sm:p-8"><p class="text-xs font-semibold uppercase tracking-[0.22em] text-[hsl(var(--brand-2))]">帧提取</p><h3 class="text-mobile-safe mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">GIF 转 JPG</h3><p class="text-mobile-safe mt-4 text-sm leading-7 text-muted-foreground">将 GIF 的首帧、全部帧或指定帧导出为 JPG 图片，可设置 JPEG 质量与透明区域背景色。</p><ul class="mt-6 space-y-3"><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>导出单帧或全部动画帧 JPG</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>设置 JPEG 质量和透明区域背景色</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>GIF 任务和 JPG 结果保存在当前浏览器</span></li></ul><a class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-9 py-2 mt-8 rounded-full px-6" href="/zh/tools/gif-to-jpg">GIF 转 JPG<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-2 h-4 w-4 transition group-hover:translate-x-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></article><article class="group rounded-[1.5rem] border border-border/70 bg-card/80 p-6 shadow-[0_20px_60px_rgba(15,23,42,0.08)] transition hover:-translate-y-1 hover:border-[hsl(var(--brand-2))]/40 hover:shadow-[0_24px_70px_rgba(15,23,42,0.12)] sm:rounded-[2rem] sm:p-8"><p class="text-xs font-semibold uppercase tracking-[0.22em] text-[hsl(var(--brand-2))]">Lottie 动画包</p><h3 class="text-mobile-safe mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">GIF 转 Lottie</h3><p class="text-mobile-safe mt-4 text-sm leading-7 text-muted-foreground">在浏览器本地将多个动态 GIF 分别转为 .lottie 动画包和独立 Lottie JSON，保留动画节奏与透明背景。</p><ul class="mt-6 space-y-3"><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>每个 GIF 默认同时生成 .lottie 和 JSON</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>保留帧时长和透明像素</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>真实 Runtime 预览并支持单项或 ZIP 下载</span></li></ul><a class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-9 py-2 mt-8 rounded-full px-6" href="/zh/tools/gif-to-lottie">GIF 转 Lottie<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-2 h-4 w-4 transition group-hover:translate-x-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></article><article class="group rounded-[1.5rem] border border-border/70 bg-card/80 p-6 shadow-[0_20px_60px_rgba(15,23,42,0.08)] transition hover:-translate-y-1 hover:border-[hsl(var(--brand-2))]/40 hover:shadow-[0_24px_70px_rgba(15,23,42,0.12)] sm:rounded-[2rem] sm:p-8"><p class="text-xs font-semibold uppercase tracking-[0.22em] text-[hsl(var(--brand-2))]">动画 PNG</p><h3 class="text-mobile-safe mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">GIF 转 APNG</h3><p class="text-mobile-safe mt-4 text-sm leading-7 text-muted-foreground">将一个或多个动态 GIF 转为 APNG 动图，保留动画时间和透明区域，文件在浏览器本地处理。</p><ul class="mt-6 space-y-3"><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>将完整动画保存在一个 PNG 文件中</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>保留帧播放时间和透明区域</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>支持在浏览器本地批量转换</span></li></ul><a class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-9 py-2 mt-8 rounded-full px-6" href="/zh/tools/gif-to-apng">GIF 转 APNG<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-2 h-4 w-4 transition group-hover:translate-x-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></article><article class="group rounded-[1.5rem] border border-border/70 bg-card/80 p-6 shadow-[0_20px_60px_rgba(15,23,42,0.08)] transition hover:-translate-y-1 hover:border-[hsl(var(--brand-2))]/40 hover:shadow-[0_24px_70px_rgba(15,23,42,0.12)] sm:rounded-[2rem] sm:p-8"><p class="text-xs font-semibold uppercase tracking-[0.22em] text-[hsl(var(--brand-2))]">动态 WebP</p><h3 class="text-mobile-safe mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">GIF 转 WebP</h3><p class="text-mobile-safe mt-4 text-sm leading-7 text-muted-foreground">将一个或多个动态 GIF 转为 WebP，可设置有损或无损质量，并保留动画和透明区域。</p><ul class="mt-6 space-y-3"><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>将完整动画保存在一个 WebP 文件中</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>选择有损或无损压缩</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>支持在浏览器本地批量转换</span></li></ul><a class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-9 py-2 mt-8 rounded-full px-6" href="/zh/tools/gif-to-webp">GIF 转 WebP<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-2 h-4 w-4 transition group-hover:translate-x-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></article><article class="group rounded-[1.5rem] border border-border/70 bg-card/80 p-6 shadow-[0_20px_60px_rgba(15,23,42,0.08)] transition hover:-translate-y-1 hover:border-[hsl(var(--brand-2))]/40 hover:shadow-[0_24px_70px_rgba(15,23,42,0.12)] sm:rounded-[2rem] sm:p-8"><p class="text-xs font-semibold uppercase tracking-[0.22em] text-[hsl(var(--brand-2))]">动态 GIF</p><h3 class="text-mobile-safe mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">WebP 转 GIF</h3><p class="text-mobile-safe mt-4 text-sm leading-7 text-muted-foreground">将静态或动态 WebP 转为 GIF，可调整尺寸、播放速度、颜色质量和透明背景处理。</p><ul class="mt-6 space-y-3"><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>将动画帧和播放时间保存在一个 GIF 中</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>调整尺寸、播放速度和颜色质量</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>多个 WebP 都在浏览器本地处理</span></li></ul><a class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-9 py-2 mt-8 rounded-full px-6" href="/zh/tools/webp-to-gif">WebP 转 GIF<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-2 h-4 w-4 transition group-hover:translate-x-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></article><article class="group rounded-[1.5rem] border border-border/70 bg-card/80 p-6 shadow-[0_20px_60px_rgba(15,23,42,0.08)] transition hover:-translate-y-1 hover:border-[hsl(var(--brand-2))]/40 hover:shadow-[0_24px_70px_rgba(15,23,42,0.12)] sm:rounded-[2rem] sm:p-8"><p class="text-xs font-semibold uppercase tracking-[0.22em] text-[hsl(var(--brand-2))]">PNG 动图</p><h3 class="text-mobile-safe mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">PNG 转 GIF</h3><p class="text-mobile-safe mt-4 text-sm leading-7 text-muted-foreground">将一张或多张 PNG 图片合成为 GIF 动图，调整帧顺序和播放速度，文件在浏览器本地处理。</p><ul class="mt-6 space-y-3"><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>将 PNG 图片序列合成为一个 GIF 动图</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>拖拽调整动画帧顺序</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>当前序列和 GIF 结果保存在浏览器本地</span></li></ul><a class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-9 py-2 mt-8 rounded-full px-6" href="/zh/tools/png-to-gif">PNG 转 GIF<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-2 h-4 w-4 transition group-hover:translate-x-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></article><article class="group rounded-[1.5rem] border border-border/70 bg-card/80 p-6 shadow-[0_20px_60px_rgba(15,23,42,0.08)] transition hover:-translate-y-1 hover:border-[hsl(var(--brand-2))]/40 hover:shadow-[0_24px_70px_rgba(15,23,42,0.12)] sm:rounded-[2rem] sm:p-8"><p class="text-xs font-semibold uppercase tracking-[0.22em] text-[hsl(var(--brand-2))]">录制 GIF</p><h3 class="text-mobile-safe mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">在线录屏</h3><p class="text-mobile-safe mt-4 text-sm leading-7 text-muted-foreground">直接在浏览器里录标签页、窗口或整个屏幕。录完后可以先本地保存和下载，也可以一键继续转成 GIF。</p><ul class="mt-6 space-y-3"><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>不需要安装录屏软件，打开页面即可开始</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>录屏历史保存在当前浏览器和当前设备里</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>支持继续进入视频转GIF编辑器</span></li></ul><a class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-9 py-2 mt-8 rounded-full px-6" href="/zh/tools/screen-recorder">开始在线录屏<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-2 h-4 w-4 transition group-hover:translate-x-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></article><article class="group rounded-[1.5rem] border border-border/70 bg-card/80 p-6 shadow-[0_20px_60px_rgba(15,23,42,0.08)] transition hover:-translate-y-1 hover:border-[hsl(var(--brand-2))]/40 hover:shadow-[0_24px_70px_rgba(15,23,42,0.12)] sm:rounded-[2rem] sm:p-8"><p class="text-xs font-semibold uppercase tracking-[0.22em] text-[hsl(var(--brand-2))]">倒计时动图</p><h3 class="text-mobile-safe mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">倒计时 GIF 生成器</h3><p class="text-mobile-safe mt-4 text-sm leading-7 text-muted-foreground">设置秒或分钟倒计时，自定义标题、颜色和版式，直接在浏览器里生成并导出短时倒计时 GIF。</p><ul class="mt-6 space-y-3"><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>支持按秒或按分钟自定义时长</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>适合活动横幅、限时优惠和倒计时素材</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>预览和生成都在浏览器本地完成</span></li></ul><a class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-9 py-2 mt-8 rounded-full px-6" href="/zh/tools/countdown-gif-generator">制作倒计时GIF<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-2 h-4 w-4 transition group-hover:translate-x-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></article></div></section><section class="border-y border-border/70 bg-muted/35"><div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 sm:py-20 lg:grid-cols-[0.9fr_1.1fr] lg:items-center"><div class="max-w-3xl space-y-4"><p class="text-sm font-semibold uppercase tracking-[0.24em] text-[hsl(var(--brand-2))]">隐私安全</p><h2 class="text-mobile-safe text-2xl font-semibold tracking-tight text-balance sm:text-4xl">为什么浏览器本地处理更安全？</h2><p class="text-mobile-safe text-base leading-7 text-muted-foreground sm:text-lg">很多在线 GIF 工具会先把文件上传到服务器再处理。GIF Master 的核心工具采用浏览器本地处理方式，你的视频、录屏和 GIF 文件不需要上传到服务器。最终下载的文件也来自浏览器本地内存，而不是服务器返回的处理结果。</p></div><div class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1"><article class="rounded-[1.25rem] border border-border/70 bg-background/90 p-5 shadow-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check mb-4 h-5 w-5 text-[hsl(var(--brand-2))]"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg><p class="text-sm leading-7 text-foreground/85">源文件留在你的浏览器和当前设备中</p></article><article class="rounded-[1.25rem] border border-border/70 bg-background/90 p-5 shadow-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock-keyhole mb-4 h-5 w-5 text-[hsl(var(--brand-2))]"><circle cx="12" cy="16" r="1"></circle><rect x="3" y="10" width="18" height="12" rx="2"></rect><path d="M7 10V7a5 5 0 0 1 10 0v3"></path></svg><p class="text-sm leading-7 text-foreground/85">核心处理不依赖服务器文件管线</p></article><article class="rounded-[1.25rem] border border-border/70 bg-background/90 p-5 shadow-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-badge-check mb-4 h-5 w-5 text-[hsl(var(--brand-2))]"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"></path><path d="m9 12 2 2 4-4"></path></svg><p class="text-sm leading-7 text-foreground/85">最终导出从浏览器本地内存下载</p></article></div></div></section><section class="border-b border-border/70"><div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20"><div class="max-w-3xl space-y-4 mx-auto text-center"><p class="text-sm font-semibold uppercase tracking-[0.24em] text-[hsl(var(--brand-2))]">使用场景</p><h2 class="text-mobile-safe text-2xl font-semibold tracking-tight text-balance sm:text-4xl">让 GIF 更快说明问题</h2><p class="text-mobile-safe text-base leading-7 text-muted-foreground sm:text-lg">从产品演示到社交分享，GIF Master 把常见 GIF 工作流放进同一个隐私安全的浏览器工具站。</p></div><div class="mt-10 grid gap-6 lg:grid-cols-2"><article class="rounded-[1.5rem] border border-border/70 bg-background/90 p-6 shadow-[0_20px_50px_rgba(15,23,42,0.08)] sm:rounded-[2rem] sm:p-7"><h3 class="text-mobile-safe text-xl font-semibold tracking-tight sm:text-2xl">产品 Demo</h3><p class="mt-4 text-sm leading-7 text-muted-foreground">为产品功能、交互细节或新版本亮点制作带标注的 Demo GIF。</p><ul class="mt-6 space-y-3"><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>用箭头指向关键按钮和操作位置</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>用文字解释步骤和结果</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>用马赛克隐藏敏感信息</span></li></ul></article><article class="rounded-[1.5rem] border border-border/70 bg-background/90 p-6 shadow-[0_20px_50px_rgba(15,23,42,0.08)] sm:rounded-[2rem] sm:p-7"><h3 class="text-mobile-safe text-xl font-semibold tracking-tight sm:text-2xl">教程说明</h3><p class="mt-4 text-sm leading-7 text-muted-foreground">把复杂步骤压缩成一张可以循环播放的动图，让用户不用打开视频也能看懂。</p><ul class="mt-6 space-y-3"><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>适合帮助文档、更新日志和教学内容</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>短时间展示完整操作路径</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>图片、emoji 和形状可以补充说明重点</span></li></ul></article><article class="rounded-[1.5rem] border border-border/70 bg-background/90 p-6 shadow-[0_20px_50px_rgba(15,23,42,0.08)] sm:rounded-[2rem] sm:p-7"><h3 class="text-mobile-safe text-xl font-semibold tracking-tight sm:text-2xl">社媒上传</h3><p class="mt-4 text-sm leading-7 text-muted-foreground">把 GIF 压缩到平台限制内，方便发到社交媒体、聊天工具或协作软件。</p><ul class="mt-6 space-y-3"><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>按目标大小自动压缩</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>一次处理多个 GIF 文件</span></li><li class="flex items-start gap-3 text-sm leading-7 text-foreground/85"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check mt-1 h-4 w-4 shrink-0 text-[hsl(var(--brand-2))]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span>减少上传失败和重复导出的时间</span></li></ul></article></div></div></section><section><div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20"><div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between"><div class="max-w-3xl space-y-4"><p class="text-sm font-semibold uppercase tracking-[0.24em] text-[hsl(var(--brand-2))]">博客</p><h2 class="text-mobile-safe text-2xl font-semibold tracking-tight text-balance sm:text-4xl">GIF 制作与压缩指南</h2><p class="text-mobile-safe text-base leading-7 text-muted-foreground sm:text-lg">了解怎样裁剪视频、控制体积、添加标注，以及让 GIF 在不同平台更容易分享。</p></div><a class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-9 py-2 rounded-full px-6" href="/zh/blog">查看全部文章</a></div><div class="mt-10 grid gap-6 lg:grid-cols-3"><article class="rounded-[1.5rem] border border-border/70 bg-background/90 p-6 shadow-[0_20px_50px_rgba(15,23,42,0.08)] sm:rounded-[2rem] sm:p-7"><div class="flex items-center gap-3 text-xs uppercase tracking-[0.22em] text-muted-foreground"><span>视频转GIF</span><span>2026-06-29</span></div><h3 class="text-mobile-safe mt-4 text-xl font-semibold tracking-tight text-balance sm:text-2xl">如何把视频快速转成带标注的 GIF</h3><p class="mt-4 text-sm leading-7 text-muted-foreground">如果你只是想把一段产品录屏、教程片段或社媒视频变成 GIF，最稳的做法是先截短，再在同一个编辑器里加箭头、文字、形状和马赛克。</p><a class="mt-5 inline-flex items-center rounded-full border border-border/70 bg-muted/40 px-3 py-1 text-xs font-medium uppercase tracking-[0.16em] text-[hsl(var(--brand-2))]" href="/zh/tools/video-to-gif">相关内容<!-- -->: <!-- -->视频转GIF</a><a class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-[hsl(var(--brand-2))]" href="/zh/blog/convert-video-to-annotated-gif-in-3-seconds">继续阅读<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></article><article class="rounded-[1.5rem] border border-border/70 bg-background/90 p-6 shadow-[0_20px_50px_rgba(15,23,42,0.08)] sm:rounded-[2rem] sm:p-7"><div class="flex items-center gap-3 text-xs uppercase tracking-[0.22em] text-muted-foreground"><span>产品 Demo</span><span>2026-06-29</span></div><h3 class="text-mobile-safe mt-4 text-xl font-semibold tracking-tight text-balance sm:text-2xl">如何快速制作带标注的产品 Demo GIF</h3><p class="mt-4 text-sm leading-7 text-muted-foreground">这篇教程很简单：先录一段短视频，再用箭头和文字把重点说明白，最后直接导出；如果 GIF 太大，再继续压缩。</p><a class="mt-5 inline-flex items-center rounded-full border border-border/70 bg-muted/40 px-3 py-1 text-xs font-medium uppercase tracking-[0.16em] text-[hsl(var(--brand-2))]" href="/zh/tools/video-to-gif">相关内容<!-- -->: <!-- -->视频转GIF</a><a class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-[hsl(var(--brand-2))]" href="/zh/blog/make-annotated-product-demo-gif">继续阅读<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></article><article class="rounded-[1.5rem] border border-border/70 bg-background/90 p-6 shadow-[0_20px_50px_rgba(15,23,42,0.08)] sm:rounded-[2rem] sm:p-7"><div class="flex items-center gap-3 text-xs uppercase tracking-[0.22em] text-muted-foreground"><span>GIF压缩</span><span>2026-07-09</span></div><h3 class="text-mobile-safe mt-4 text-xl font-semibold tracking-tight text-balance sm:text-2xl">如何压缩 GIF，才能上传到 X、Discord、Gmail 和 Outlook？</h3><p class="mt-4 text-sm leading-7 text-muted-foreground">先看你要上传到哪个平台，再设置对应的目标大小。X、Discord、Gmail 和 Outlook 的限制不一样，但大多数 GIF 都是先压一版，不够再调宽度和抽帧。</p><a class="mt-5 inline-flex items-center rounded-full border border-border/70 bg-muted/40 px-3 py-1 text-xs font-medium uppercase tracking-[0.16em] text-[hsl(var(--brand-2))]" href="/zh/tools/gif-compressor">相关内容<!-- -->: <!-- -->GIF压缩</a><a class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-[hsl(var(--brand-2))]" href="/zh/blog/compress-a-gif-for-x-discord-gmail-and-outlook">继续阅读<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></article><article class="rounded-[1.5rem] border border-border/70 bg-background/90 p-6 shadow-[0_20px_50px_rgba(15,23,42,0.08)] sm:rounded-[2rem] sm:p-7"><div class="flex items-center gap-3 text-xs uppercase tracking-[0.22em] text-muted-foreground"><span>去除GIF背景</span><span>2026-07-09</span></div><h3 class="text-mobile-safe mt-4 text-xl font-semibold tracking-tight text-balance sm:text-2xl">如何移除GIF背景并导出透明GIF</h3><p class="mt-4 text-sm leading-7 text-muted-foreground">这篇教程很简单：先上传你的 GIF，系统会自动识别背景颜色；如果不对，就在 GIF 里手动取色；最后点击生成，即可导出透明 GIF。</p><a class="mt-5 inline-flex items-center rounded-full border border-border/70 bg-muted/40 px-3 py-1 text-xs font-medium uppercase tracking-[0.16em] text-[hsl(var(--brand-2))]" href="/zh/tools/remove-gif-background">相关内容<!-- -->: <!-- -->去除 GIF 背景</a><a class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-[hsl(var(--brand-2))]" href="/zh/blog/remove-gif-background-and-export-transparent-gif">继续阅读<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></article><article class="rounded-[1.5rem] border border-border/70 bg-background/90 p-6 shadow-[0_20px_50px_rgba(15,23,42,0.08)] sm:rounded-[2rem] sm:p-7"><div class="flex items-center gap-3 text-xs uppercase tracking-[0.22em] text-muted-foreground"><span>倒计时GIF</span><span>2026-07-09</span></div><h3 class="text-mobile-safe mt-4 text-xl font-semibold tracking-tight text-balance sm:text-2xl">如何为活动、促销或发售页制作倒计时 GIF</h3><p class="mt-4 text-sm leading-7 text-muted-foreground">先选好倒计时总时长，再设置标题、时间单位标签、样式和颜色，最后点击生成 GIF 即可。</p><a class="mt-5 inline-flex items-center rounded-full border border-border/70 bg-muted/40 px-3 py-1 text-xs font-medium uppercase tracking-[0.16em] text-[hsl(var(--brand-2))]" href="/zh/tools/countdown-gif-generator">相关内容<!-- -->: <!-- -->倒计时 GIF 生成器</a><a class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-[hsl(var(--brand-2))]" href="/zh/blog/make-a-countdown-gif-for-promotions">继续阅读<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></article><article class="rounded-[1.5rem] border border-border/70 bg-background/90 p-6 shadow-[0_20px_50px_rgba(15,23,42,0.08)] sm:rounded-[2rem] sm:p-7"><div class="flex items-center gap-3 text-xs uppercase tracking-[0.22em] text-muted-foreground"><span>倒计时GIF</span><span>2026-07-10</span></div><h3 class="text-mobile-safe mt-4 text-xl font-semibold tracking-tight text-balance sm:text-2xl">如何制作一个清晰好用的倒计时 GIF</h3><p class="mt-4 text-sm leading-7 text-muted-foreground">先确定倒计时要放在哪里，再设置时长、标题、颜色和版式。只要数字够清楚，倒计时 GIF 就能很快承担提醒作用。</p><a class="mt-5 inline-flex items-center rounded-full border border-border/70 bg-muted/40 px-3 py-1 text-xs font-medium uppercase tracking-[0.16em] text-[hsl(var(--brand-2))]" href="/zh/tools/countdown-gif-generator">相关内容<!-- -->: <!-- -->倒计时 GIF 生成器</a><a class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-[hsl(var(--brand-2))]" href="/zh/blog/how-to-make-a-countdown-gif">继续阅读<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></article><article class="rounded-[1.5rem] border border-border/70 bg-background/90 p-6 shadow-[0_20px_50px_rgba(15,23,42,0.08)] sm:rounded-[2rem] sm:p-7"><div class="flex items-center gap-3 text-xs uppercase tracking-[0.22em] text-muted-foreground"><span>倒计时GIF</span><span>2026-07-10</span></div><h3 class="text-mobile-safe mt-4 text-xl font-semibold tracking-tight text-balance sm:text-2xl">如何制作 1 分钟倒计时 GIF</h3><p class="mt-4 text-sm leading-7 text-muted-foreground">直接选择 1 分钟预设，或者输入 60 秒，再设置标题、时间单位标签、样式和颜色，最后点击生成 GIF 即可。</p><a class="mt-5 inline-flex items-center rounded-full border border-border/70 bg-muted/40 px-3 py-1 text-xs font-medium uppercase tracking-[0.16em] text-[hsl(var(--brand-2))]" href="/zh/tools/countdown-gif-generator">相关内容<!-- -->: <!-- -->倒计时 GIF 生成器</a><a class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-[hsl(var(--brand-2))]" href="/zh/blog/one-minute-countdown-gif">继续阅读<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></article><article class="rounded-[1.5rem] border border-border/70 bg-background/90 p-6 shadow-[0_20px_50px_rgba(15,23,42,0.08)] sm:rounded-[2rem] sm:p-7"><div class="flex items-center gap-3 text-xs uppercase tracking-[0.22em] text-muted-foreground"><span>倒计时GIF</span><span>2026-07-10</span></div><h3 class="text-mobile-safe mt-4 text-xl font-semibold tracking-tight text-balance sm:text-2xl">如何制作 5 分钟倒计时 GIF</h3><p class="mt-4 text-sm leading-7 text-muted-foreground">直接选择 5 分钟预设，或者输入 5 分钟，再设置标题、时间单位标签、样式和颜色，最后点击生成 GIF 即可。</p><a class="mt-5 inline-flex items-center rounded-full border border-border/70 bg-muted/40 px-3 py-1 text-xs font-medium uppercase tracking-[0.16em] text-[hsl(var(--brand-2))]" href="/zh/tools/countdown-gif-generator">相关内容<!-- -->: <!-- -->倒计时 GIF 生成器</a><a class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-[hsl(var(--brand-2))]" href="/zh/blog/five-minute-countdown-gif">继续阅读<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></article></div></div></section><section class="mx-auto max-w-7xl px-6 py-20"><div class="max-w-3xl space-y-4 mx-auto text-center"><p class="text-sm font-semibold uppercase tracking-[0.24em] text-[hsl(var(--brand-2))]">常见问题</p><h2 class="text-mobile-safe text-2xl font-semibold tracking-tight text-balance sm:text-4xl">开始前你可能会关心</h2><p class="text-mobile-safe text-base leading-7 text-muted-foreground sm:text-lg">关于本地处理、GIF 与视频转换和压缩到指定大小的常见问题。</p></div><div class="mx-auto mt-10 grid max-w-4xl gap-5"><details class="rounded-[1.75rem] border border-border/70 bg-card/80 p-6 shadow-sm"><summary class="cursor-pointer list-none text-lg font-semibold tracking-tight">GIF Master 是什么？</summary><p class="mt-4 text-sm leading-7 text-muted-foreground">GIF Master 是一个免费的在线 GIF 工具平台，支持在浏览器中制作、转换、压缩、录制和生成 GIF。</p></details><details class="rounded-[1.75rem] border border-border/70 bg-card/80 p-6 shadow-sm"><summary class="cursor-pointer list-none text-lg font-semibold tracking-tight">我的文件会上传到服务器吗？</summary><p class="mt-4 text-sm leading-7 text-muted-foreground">不会。支持本地处理的工具会在浏览器中处理文件，不需要上传到我们的服务器，因此也不用在处理前漫长等待上传。</p></details><details class="rounded-[1.75rem] border border-border/70 bg-card/80 p-6 shadow-sm"><summary class="cursor-pointer list-none text-lg font-semibold tracking-tight">可以在线把视频转成 GIF 吗？</summary><p class="mt-4 text-sm leading-7 text-muted-foreground">可以。你可以上传视频，截取需要的片段，添加标注，然后直接在浏览器中导出 GIF。</p></details><details class="rounded-[1.75rem] border border-border/70 bg-card/80 p-6 shadow-sm"><summary class="cursor-pointer list-none text-lg font-semibold tracking-tight">可以把 GIF 转为 MP4 吗？</summary><p class="mt-4 text-sm leading-7 text-muted-foreground">可以。打开 GIF 转视频工具，在浏览器支持 H.264 编码时选择 MP4；可以保留原时长，也可以让短 GIF 重复到设定的视频时长。</p></details><details class="rounded-[1.75rem] border border-border/70 bg-card/80 p-6 shadow-sm"><summary class="cursor-pointer list-none text-lg font-semibold tracking-tight">可以把视频转 GIF 后压缩到指定大小吗？</summary><p class="mt-4 text-sm leading-7 text-muted-foreground">可以。导出 GIF 后，在 Results 中点击“压缩到指定大小”。GIF 会在本地传给 GIF压缩工具，你可以再选预设或自定义目标大小。</p></details><details class="rounded-[1.75rem] border border-border/70 bg-card/80 p-6 shadow-sm"><summary class="cursor-pointer list-none text-lg font-semibold tracking-tight">可以把 GIF 压缩到指定大小吗？</summary><p class="mt-4 text-sm leading-7 text-muted-foreground">可以。GIF压缩工具支持设置目标大小，并结合尺寸调整和抽帧来减少 GIF 体积。</p></details></div></section></main><footer class="border-t border-border/70 bg-[radial-gradient(circle_at_top_left,rgba(20,184,166,0.12),transparent_38%),radial-gradient(circle_at_bottom_right,rgba(238,119,82,0.12),transparent_38%)]"><div class="mx-auto grid max-w-7xl gap-10 px-6 py-14 md:grid-cols-[1.4fr_repeat(4,minmax(0,1fr))]"><div class="space-y-5"><a class="inline-flex items-center gap-3 text-xl font-semibold tracking-tight" href="/zh"><span class="flex h-10 w-10 items-center justify-center overflow-hidden rounded-xl bg-white shadow-[0_6px_18px_rgba(15,23,42,0.12)] ring-1 ring-black/5"><img alt="" loading="lazy" width="40" height="40" decoding="async" data-nimg="1" class="h-full w-full" style="color:transparent" srcSet="/_next/image?url=%2Ficons%2Fgif-master-128.png&amp;w=48&amp;q=75 1x, /_next/image?url=%2Ficons%2Fgif-master-128.png&amp;w=96&amp;q=75 2x" src="/_next/image?url=%2Ficons%2Fgif-master-128.png&amp;w=96&amp;q=75"/></span><span>GIF Master</span></a><p class="max-w-sm text-sm leading-7 text-muted-foreground">在线 GIF 制作与压缩工具</p><div class="space-y-2 text-sm leading-7 text-muted-foreground"><p>联系邮箱<!-- -->:<!-- --> <a href="/cdn-cgi/l/email-protection#3b484e4b4b54494f7b5c525d16565a484f5e4915585456" class="font-medium text-foreground transition hover:text-[hsl(var(--brand-2))]"><span class="__cf_email__" data-cfemail="99eaece9e9f6ebedd9fef0ffb4f4f8eaedfcebb7faf6f4">[email&#160;protected]</span></a></p><p>© 2026<!-- --> <span class="font-medium text-foreground">GIF Master</span>.<!-- --> <!-- -->所有权利保留</p><p>为快速、安全的浏览器 GIF 工作流而构建</p></div><div class="space-y-3"><p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">推荐收录</p><div class="flex flex-col items-start gap-3"><a href="https://saashubdirectory.com/product/gif-m