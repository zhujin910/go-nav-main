  <script type="text/javascript" src="https://ss4.360tres.com/!0b08ed96/radar-analytic-js-sdk.umd.js"></script>
  <script src="https://ss4.360tres.com/static/e8b9097ed0005195.js"></script>
  <script src="./public/swiper/swiper.min.js"></script>
  <script src='./public/header.js'></script>
  <script src='./public/log.js'></script>
  <script src="./public/utils.js"></script>
  <script type="text/javascript">
    var apiOrigin = 'gy-api'

    //首页轮播图配置
    var mySwiper_home
    function initSwiper() {
      mySwiper_home = new Swiper('.swiper-container-home', {
        autoHeight: true,
        direction: 'horizontal',
        observer: true,
        observeParents: true,
        loop: true,
        speed: 800,
        autoplay: {
          delay: 3000,
          disableOnInteraction: false
        },
        pagination: {
          el: '.swiper-pagination',
          type: 'bullets',
          bulletClass: 'custom-bullet',
          bulletActiveClass: 'custom-bullet-active'
        }
      })

      //新闻页轮播图配置属性
      mySwiper_home.el.onmouseover = function () { //鼠标放上暂停轮播
        mySwiper_home.autoplay.stop();
      }

      mySwiper_home.el.onmouseleave = function () {
        mySwiper_home.autoplay.start();
      }
    }

    // 获取 banner 图
    getBannerImgs()
    function getBannerImgs() {
      $.ajax(
        apiOrigin + '/home', 
        { method: 'get', dataType: 'json' }
      ).done(function(res) {
        if(res.meta && res.meta.code === 'SUCCESS') {
          if(!res.data) { return } 
          generateBannerImgs(res.data.top_list)

          initSwiper()
        }
      })
    }

    function generateBannerImgs(data) {
      if(!data || !data.length) { return }
      var ele = []

      if(window.GYCanWebp) {
        for(var i=0; i<data.length; i++) {
          var item = data[i]
          ele.push('<div class="swiper-slide">')
          ele.push('  <a href="/projectdetail.html?item_uuid='+ item.item_uuid +'">')
          ele.push('    <img src="'+ window.GYConvertToWebp(item.pc_list_img_id) +'" alt="'+ item.title +'" />')
          ele.push('  </a>')
          ele.push('</div>')
        }        
      } else {
        for(var i=0; i<data.length; i++) {
          var item = data[i]
          ele.push('<div class="swiper-slide">')
          ele.push('  <a href="/projectdetail.html?item_uuid='+ item.item_uuid +'">')
          ele.push('    <img src="'+ item.pc_list_img_id +'" alt="'+ item.title +'" />')
          ele.push('  </a>')
          ele.push('</div>')
        }
      }

      $('.swiper-wrapper').append(ele.join(''))

    }


    // 新闻模块
    getNews()
    function getNews() {
      $.ajax(
        apiOrigin + '/medias',
        { method: 'get', dataType: 'json' }
      ).done(function(res) {
        if(res.meta && res.meta.code === 'SUCCESS') {
          if(res.data && res.data.length === 0) { 
            $('#media-content').remove()
            return 
          }
        
          generateNews(res.data)
        }
      })
    }

    function generateNews(data) {
      var leftNew = data.find(item => item.top_flag === 2)
      var eleLeft = []
      eleLeft.push('<div class="media_left__img">')

      if(window.GYCanWebp) {
        eleLeft.push('  <img src="'+ window.GYConvertToWebp(leftNew.pic) +'" />')
      } else {
        eleLeft.push('  <img src="'+ leftNew.pic +'" />')
      }

      eleLeft.push('</div>')
      eleLeft.push('<div class="fs16 c-999999 fw-4 mt30 plr30">'+ leftNew.subheading +'</div>')
      eleLeft.push('<div class="plr30 fs22 c-262626 l-h-30 mt30 fw-4">'+ leftNew.main_title +'</div>')
      eleLeft.push('<a href="'+ leftNew.report_url +'" class="mt60 ml30 c-0FB576 media_button" target="_blank">查看详情</a>')

      $('.media_left').append(eleLeft.join(''))


      var rightNews = data.filter(item => item.top_flag === 1).slice(0, 4)
      var eleRight = []
      for(var i=0; i<rightNews.length; i++){
        var item = rightNews[i]

        eleRight.push('<a href="'+ item.report_url +'" target="_blank">')
        eleRight.push('  <div class="mt30 pb20 mb80 media_list pb30">')
        eleRight.push('    <div class="fs16 c-999999">'+ item.subheading +'</div>')
        eleRight.push('    <div class="fs22 c-262626 mt20 l-h-30 fw-4">'+ item.main_title +'</div>')
        eleRight.push('  </div>')
        eleRight.push('</a>')
      }

      $('.media_right').append(eleRight.join(''))
      $('.media_right').append('<p class="mt60 "><a class="c-FF7900" href="./media.html">了解更多>></a></p>')

    }
  
    
    // banner 下方配置
    const configs = [
      {
        title: '全部',
        key: 'all',
        url: '/projects.html'
      },
      {
        title: '医疗',
        key: 'health',
        url: '/projects.html?type=health'
      },
      {
        title: '教育',
        key: 'edu',
        url: '/projects.html?type=edu'
      },
      {
        title: '济困',
        key: 'difficulty',
        url: '/projects.html?type=difficulty'
      },
      {
        title: '自然',
        key: 'nature',
        url: '/projects.html?type=nature'
      },
      {
        title: '其他',
        key: 'other',
        url: '/projects.html?type=other'
      },
    ]

    const createProjectListStr = (url, type, title) => {
      return `
        <a href="${url}" class="projects-list__item">
          <div class="projects-list__item-icon ${type}"></div>
          <p class="projects-list__item-text">${title}</p>
        </a>
      `
    }

    const htmlStr = configs.reduce((prev, curr) => {
      const { url, key, title } = curr
      return prev += createProjectListStr(url, key, title)
    }, '')

    $('.projects-list').html(htmlStr)


    // 机构荣誉
    const news = [
      '2023年度施予受品牌推广合作平台', '北京民营企业社会责任百强', 
      '凤凰公益2023公益盛典“年度十大公益企业”入围奖', '获“2021—2022年度中国互联网行业自律贡献和公益奖”', 
      '周鸿祎获选2022光彩之星', '周鸿祎获选2023中国民营企业社会责任优秀企业家'
    ];

    const newsImages = [
      'https://p4.ssl.qhimg.com/t017b14421ec68d5ae1.png', 'https://p1.ssl.qhimg.com/t01835625a1919c70b5.jpg',
      'https://p1.ssl.qhimg.com/t0186130135f10b79b1.png', 'https://p3.ssl.qhimg.com/t01946f05441495bc9f.jpg',
      'https://p4.ssl.qhimg.com/t018ec3b8e03251f079.png', 'https://p4.ssl.qhimg.com/t01b56c3813d854e285.png'
    ];

    $(function() {  
      const htmlStr = news.reduce((prev, curr) => {
        return prev += `
          <li class="jigou-honor__news-item ${prev === '' && 'active'}">
            <p>${curr}</p>
            <div class="jigou-honor__news-icon__wrap">
              <div class="jigou-honor__news-icon"></div>
            </div>
          </li>
        `
      }, '');
      $('.jigou-honor__news').html(htmlStr);


      const imgsStr = newsImages.reduce((prev, curr) => {
        let imgStr = '';

        if(window.GYCanWebp) {
          imgStr = `<img src="${ window.GYConvertToWebp(curr)}" />`
        } else {
          imgStr = `<img src="${curr}" />`
        }

        return prev += imgStr
      }, '');
      $('.jigou-honor__img').html(imgsStr);


      $('.jigou-honor__news').on('click', 'li', function() {
        $('.jigou-honor__news li').each((index, item) => $(item).removeClass('active'))
        $(this).addClass('active')

        $('.jigou-honor__img img').css('display', 'none');
        
        $('.jigou-honor__img img').eq($(this).index()).css('display', 'block');
      })
    })

  
  </script>
  
  <!-- 性能监控脚本 -->
  <script src="https://s5.ssl.qhres2.com/static/da03cf145098d422.js"></script>
</body>

</html>
