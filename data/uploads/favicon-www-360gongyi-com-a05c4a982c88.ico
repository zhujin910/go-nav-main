  <style type="text/css">
    .chou_pc {
      width: 100%;
    }

    .wrapper {
      width: 100%;
      position: relative;
    }

    .content>div {
      margin: 0 auto;
    }

    .bind_mobile {
      width: 360px;
      background: #fff;
      position: absolute;
      top: 15%;
      right: 10%;
      z-index: 999;
    }

    .bind_mobile button {
      width: 100%;
      height: 60px;
      background: linear-gradient(270deg, rgba(15, 181, 118, 1) 0%, rgba(106, 211, 139, 1) 100%);
      border-radius: 4px;
      border: none;
      color: #fff;
      font-size: 20px;
      font-weight: 600;
    }

    .form_text {
      margin-top: 12px;
      line-height: 28px;
    }

    .form_text>li {
      display: flex;
      align-items: center;
    }

    .form_text>li::before {
      content: '';
      display: inline-block;
      width: 6px;
      height: 6px;
      margin-right: 5px;
      border-radius: 50%;
      background: #0FB576;
    }

    .success_img {
      width: 100%;
      height: 240px;
    }

    .job_radius {
      width: 140px;
      height: 140px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #0FB576;
    }

    .job_radius img {
      width: 50%;
    }

    .job_wrap {
      justify-content: center;
    }

    .job_wrap>div {
      margin-right: 145px;
    }

    .job_wrap>div:last-child {
      margin-right: 0;
    }

    .media {
      display: flex;
      justify-content: center;
    }

    .media_left {
      width: 520px;
    }

    .media_left__img {
      width: 520px;
      height: 280px;
    }

    .media_left img {
      width: 100%;
      height: 280px;
    }

    .media_button {
      cursor: pointer;
      background: none;
      display: inline-block;
      width: 160px;
      height: 48px;
      font-size: 16px;
      text-align: center;
      line-height: 48px;
      border: 1px solid #FF1D25;
      color: #FF1D25;
      border-radius: 28px;
    }

    .media_button:hover {
      background: linear-gradient(90deg, #FF7BAC 0%, #FF1D25 100%);
      color: #fff;
    }

    .media_right {
      width: 498px;
    }

    .media_right>div {
      border-bottom: 1px solid #DDDDDD;
    }


    .success_item {
      width: 350px;
      height: 460px;
    }

    .success_content {
      width: 1100px;
      margin: 60px auto 0;
    }

    .text_show2 {
      text-overflow: -o-ellipsis-lastline;
      overflow: hidden;
      text-overflow: ellipsis;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      -webkit-box-orient: vertical;
    }

    .succ {
      top: 50%;
      left: 50%;
      z-index: 9999;
      width: 731px;
      height: 520px;
      display: none;
    }

    .succ .content {
      padding: 90px 0;
      box-shadow: 0px 5px 27px 0px rgba(14, 107, 69, 0.12);
      width: 731px;
      background: rgba(255, 255, 255, 1);
      border-radius: 8px;
      margin-left: -50%;
      margin-top: -350px;
    }

    .succ .close {
      right: 40px;
      top: 40px;
    }

    .media_list {
      border-bottom: 1px solid #DDDDDD;
    }

    .swiper-container-home {
      height: 504px;
      overflow: hidden;
      background: #f9f9f9;
    }

    #swiper-wrapper {
      height: 504px;
    }

    #swiper-wrapper .swiper-slide,
    #swiper-wrapper img{
      height: 100%;
    }

    .custom-bullet {
      border-radius: 50%;
      width: 8px;
      height: 8px;
      margin: 0 5px;
      display: inline-block;
      background: rgba(0,0,0,.2);
    }
    .custom-bullet-active {
      width: 16px;
      border-radius: 4px;
      background: #ff1d25;
    }

    .projects-list {
      display: flex;
      align-items: center;
      justify-content: space-between;
      max-width: 1000px;
      margin: 0 auto;
    }

    .projects-list__item {
      width: 100px;
      transition: 0.3s;
    }

    .projects-list__item-text {
      font-size: 16px;
      line-height: 22px;
      font-weight: bold;
      text-align: center;
      padding-top: 15px;
    }

    .projects-list__item-icon {
      width: 46px;
      height: 55px;
      background: url(https://p2.ssl.qhimg.com/t01dc7950b33268c7c7.png) no-repeat 0 0;
      background-size: 294px;
      margin: 0 auto;
    }

    .projects-list__item:hover {
      transform: scale(1.2);
    }

    .projects-list__item-icon.health {
      width: 52px;
      background-position: -46px 0;
    }

    .projects-list__item-icon.edu {
      width: 49px;
      background-position: -100px 0;
    }

    .projects-list__item-icon.difficulty {
      width: 48px;
      background-position: -150px 0;
    }

    .projects-list__item-icon.nature {
      width: 48px;
      background-position: -198px 0;
    }

    .projects-list__item-icon.other {
      width: 48px;
      background-position: -246px 0;
    }


    .jigou-honor__content {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      align-items: start;
      margin-top: 60px;
      height: 360px;
    }

    .jigou-honor__news {
      flex: 1;
      padding-left: 50px;
      overflow-y: auto;
      height: 100%;
      direction: rtl;
    }

    .jigou-honor__news-item {
      text-align: left;
      color: #999;
      font-size: 24px;
      line-height: 1.5;
      margin-bottom: 30px;
      cursor: pointer;
    }

    .jigou-honor__news-icon__wrap {
      display: none;
    }


    .jigou-honor__news-item.active {
      color: #ff1d25;
    }
    .jigou-honor__news-item.active .jigou-honor__news-icon__wrap {
      display: block;
      overflow: hidden;
    }
    .jigou-honor__news-item.active .jigou-honor__news-icon {
      background: #F2F5F9;
    }

    .jigou-honor__news-icon {
      margin-top: 20px;
      float: left;
      width: 40px;
      height: 40px;
      border: 1px solid #E5E5E5;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .jigou-honor__news-icon::before {
      content: "";
      display: block;
      width: 20px;
      height: 20px;
      background: url(https://p2.ssl.qhimg.com/t01461efc6ba8837564.png) no-repeat center;
      background-size: contain;
    }


    .jigou-honor__img {
      padding-left: 50px;
      display: flex;
      justify-content: end;
      width: 45%;
      height: 100%;
    }

    .jigou-honor__img img {
      display: none;
      height: 100%;
      max-width: 100%;
      vertical-align: middle;
    }

    .jigou-honor__img img:nth-child(1) {
      display: block;
    }

  </style>

  <script alt="jquery" src="https://ss4.360tres.com/static/92ea5ca69d56c975.js"></script>
  <!-- js-cookie v3.0.1 -->
  <script src="https://ss4.360tres.com/static/6d2a1c3c9f338427.js"></script>
  <script src="./public/env.js"></script>
  <!-- js报错监控脚本  -->
  <script src="https://s0.ssl.qhres2.com/static/777ca42b93a8a6e3.js"></script>

</head>

<body style="position:relative">
