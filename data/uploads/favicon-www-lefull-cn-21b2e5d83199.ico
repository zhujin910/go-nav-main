    <div class="require-module main" id="require-module">
        <div class="advantages">
            <div class="disf">
                <div class="acquisition flex">
                    <i class="font_family icon-shougoufuwu-xuanzhong"></i>
                    <h3>收购服务</h3>
                    <p>我们为投资者寻找可发展租赁住房项目的收购标的。</p>
                    <div class="bg bg-cover"></div>
                </div>
                <div class="rental flex ml30">
                    <i class="font_family icon-zulinfuwu-xuanzhong"></i>
                    <h3>租赁服务</h3>
                    <p>我们承租各类租赁住房资产。</p>
                    <div class="bg bg-cover"></div>
                </div>
            </div>
            <div class="disf">
                <div class="operation flex">
                    <i class="font_family icon-yunyingguanlifuwu-xuanzhong"></i>
                    <h3>运营管理服务</h3>
                    <p>我们为租赁住房项目提供全周期运营服务，包括品牌导入、平台运营、会员共享、招租去化、人才派驻、系统接入、专业培训、经营分析、金融服务、社群管理等。</p>
                    <div class="bg bg-cover"></div>
                </div>
                <div class="construction flex ml30">
                    <i class="font_family icon-jiansheguanlifuwu-xuanzhong"></i>
                    <h3>建设管理服务</h3>
                    <p>我们为租赁住房项目提供工程建设与装修管理，从前期咨询到设计，再到项目管理的一站式全包全流程管理服务。</p>
                    <div class="bg bg-cover"></div>
                </div>
            </div>
            <div class="disf">
                <div class="investment flex">
                    <i class="font_family icon-touzifuwu-xuanzhong"></i>
                    <h3>投资服务</h3>
                    <p>我们为个人和机构投资者提供租赁住房项目的投资机会。</p>
                    <div class="bg bg-cover"></div>
                </div>
                <div class="consulting flex ml30">
                    <i class="font_family icon-zixunfuwu-xuanzhong"></i>
                    <h3>咨询服务</h3>
                    <p>为租赁住房项目发展提供规划设计技术支持服务，智慧化社区方案建议，市场可行性研究服务，市场研究与战略建议，品牌重塑指导，建设期技术支持，人员招聘及培训，多维度运营管理，平台服务及战略增值服务等。
                    </p>
                    <div class="bg bg-cover"></div>
                </div>
            </div>
        </div>
    </div>
