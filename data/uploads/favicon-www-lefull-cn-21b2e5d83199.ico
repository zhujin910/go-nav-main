    <section class="w100 f-cooperates" id="cooperate" style="display: none;">
        <div class="main f-contact" style="border-radius: 20px;">
            <div class="guanbi-y"><img src="./component/insight/images/guanbi.png" alt=""></div>
            <i class="bottomIcon"></i>
            <div class="titleInsight">
                <div class="f-titleInsight tp1">
                    <h2 class="spac">COOPERATION</h2>
                    <h3>联系合作</h3>
                </div>
            </div>
            <div class="f-form">
                <div class="group">
                    <input name="name" id="modal-name" type="text" placeholder="姓名" autocomplete="off">
                    <input name="phone" id="modal-phone" type="text" placeholder="手机号" autocomplete="off">
                </div>
                <div class="group">
                    <div class="f-select">
                        <input type="text" id="ipt-provinceList" name="type" placeholder="省份" autocomplete="off"
                            readonly="true">
                        <i class="icons"></i>
                        <div class="items">
                            <ul id="modal-provinceList" class="f-scroll"></ul>
                        </div>
                    </div>
                    <div class="f-select">
                        <input type="text" id="ipt-cityList" name="type" placeholder="城市" autocomplete="off"
                            readonly="true">
                        <i class="icons"></i>
                        <div class="items">
                            <ul id="modal-cityList" class="f-scroll"></ul>
                        </div>
                    </div>
                    <div class="f-select">
                        <input type="text" id="ipt-type" name="type" placeholder="合作类型" autocomplete="off"
                            readonly="true">
                        <i class="icons"></i>
                        <div class="items">
                            <ul id="modal-type">
                                <li data-id="3">品牌加盟</li>
                                <li data-id="4">股份投资</li>
                                <li data-id="5">委托管理</li>
                                <li data-id="6">企业合作</li>
                                <li data-id="7">保租房服务</li>
                            </ul>
                        </div>
                    </div>
                    <div class="f-select" style="width: 760px; margin-top: 20px; margin-bottom: 20px; display: none;"
                        id="brandhide">
                        <input type="text" style="width: 100%;" id="ipt-brandNew" name="type" placeholder="请选择您意向加盟的品牌"
                            autocomplete="off" readonly="true">
                        <i class="icons"></i>
                        <div class="items">
                            <ul id="modal-brand">
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="group">
                    <textarea maxlength="200" id="modal-content" placeholder="请填写您的合作内容"
                        style="resize: none"></textarea>
                </div>
                <div class="group">
                    <button class="btn" id="modal-submit">立即提交</button>
                </div>
            </div>
            <div class="f-layer"></div>
        </div>
    </section>

