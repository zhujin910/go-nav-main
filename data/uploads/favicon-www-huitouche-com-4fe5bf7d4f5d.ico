    function showLicensing() {
        $("#licenceMasker").show()
        $("#licenceImage").bind('click', function (event) {
            event.preventDefault();
            return false
        })
        $("#licenceMasker").on('click', function () {
            $("#licenceMasker").hide()
        })
    }
    $("#telecomLicensing").on('click', function () {
        $("#licenceImage").attr("src", '/static2/images2/telecomLicensing.jpg')
        showLicensing()
    })
    $("#businessLicense").on('click', function () {
