    <script>
    document.addEventListener("DOMContentLoaded", function() {
        const barItems = document.querySelectorAll(".x_ifModal-dock-item[data-url]");
        const modal = document.getElementById("x_ifModal-myModal");
        const shell = modal ? modal.querySelector(".x_ifModal-modal-shell") : null;
        const iframe = document.getElementById("x_ifModal-modalIframe");
        const closeBtn = document.querySelector(".x_ifModal-close");
        const fullscreenBtn = document.getElementById("x_ifModal-fullscreenBtn");
        const titleEl = document.querySelector(".x_ifModal-modal-title");
        const dock = document.getElementById("x_ifModal-dock");
        const dockClose = document.getElementById("x_ifModal-dock-close");

        let isFullscreen = false;
        let currentURL = "";
        let isOpen = false;
        let closingTimer = null;

        function openModal(url, title) {
            if (!modal || !shell || !iframe) return;
            if (closingTimer) {
                clearTimeout(closingTimer);
                closingTimer = null;
            }
            currentURL = url;
            iframe.src = url;
            if (titleEl) titleEl.textContent = title || "";
            
            modal.style.display = "flex";
            modal.offsetHeight; 
            modal.setAttribute("aria-hidden", "false");
            
            modal.classList.add("is-open");
            shell.classList.add("is-open");
            isOpen = true;
        }

        function closeModal() {
            if (!modal || !shell) return;
            if (!isOpen) {
                modal.style.display = "none";
                return;
            }
            
            modal.classList.remove("is-open");
            shell.classList.remove("is-open");

            modal.classList.add("is-closing");
            shell.classList.add("is-closing");
            
            isOpen = false;

            closingTimer = setTimeout(() => {
                modal.classList.remove("is-closing");
                shell.classList.remove("is-closing");
                modal.style.display = "none";
                modal.setAttribute("aria-hidden", "true");

                if (isFullscreen) exitFullscreenMode();
                iframe.src = "";
                closingTimer = null;
            }, 200);
        }

        if (barItems) {
            barItems.forEach(item => {
                item.addEventListener("click", function() {
                    openModal(this.dataset.url, this.dataset.title);
                });
            });
        }

        if (closeBtn) closeBtn.addEventListener("click", closeModal);

        window.addEventListener("click", function(e) {
            if (e.target === modal) closeModal();
        });

        window.addEventListener("keydown", function(e) {
            if (e.key === "Escape") closeModal();
        });

        if (fullscreenBtn) {
            fullscreenBtn.addEventListener("click", function() {
                if (!isFullscreen) enterFullscreenMode();
                else exitFullscreenMode();
            });
        }

        function enterFullscreenMode() {
            if (!shell) return;
            shell.classList.add("is-fullscreen");
            document.body.style.overflow = "hidden";
            isFullscreen = true;
        }

        function exitFullscreenMode() {
            if (!isFullscreen || !shell) return;
            shell.classList.remove("is-fullscreen");
            document.body.style.overflow = "";
            isFullscreen = false;
        }

        if (dock && dockClose) {
            dockClose.addEventListener("click", function() {
                dock.classList.add("is-hide");
                setTimeout(() => { dock.style.display = "none"; }, 300);
            });
        }
        
        
        const openNewTabBtn = document.getElementById("x_ifModal-openNewTabBtn");
        if (openNewTabBtn) {
            openNewTabBtn.addEventListener("click", function() {
                if (currentURL) window.open(currentURL, "_blank");
            });
        }

        

    });
    </script><script src = 'https://fffxx.com/content/plugins/nciaer_vote/jquery.min.3.5.1.js'></script>
