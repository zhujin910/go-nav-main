    <style>
        .post-heatmap-wrapper {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
            font-size: 12px;
            color: #57606a;
            background: transparent;
            border-radius: 8px;
            box-sizing: border-box;
            width: 100%;
        }

        [data-theme="dark"] .post-heatmap-wrapper,
        body.dark-mode .post-heatmap-wrapper {
            color: #8b949e;
        }

        .ph-admin-container,
        .ph-sidebar-container {
            width: 100%;
            padding: 0;
        }

        .ph-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

        .ph-summary {
            font-size: 13px;
            color: inherit;
        }

        .ph-summary strong {
            color: #24292f;
        }

        [data-theme="dark"] .ph-summary strong,
        body.dark-mode .ph-summary strong {
            color: #c9d1d9;
        }

        .ph-svg-container {
            width: 100%;
            overflow: hidden;
        }

        .ph-heatmap-svg {
            display: block;
            width: 100%;
            height: auto;
            max-width: 100%;
        }

        .ph-svg-text {
            font-size: 9px;
            fill: #8c959f;
            font-family: inherit;
            user-select: none;
        }

        [data-theme="dark"] .ph-svg-text,
        body.dark-mode .ph-svg-text {
            fill: #6e7681;
        }

        .ph-svg-cell {
            cursor: pointer;
            transition: stroke 0.15s ease, stroke-width 0.15s ease;
        }

        .ph-svg-cell:hover {
            stroke: rgba(0, 0, 0, 0.45);
            stroke-width: 1.2px;
        }

        [data-theme="dark"] .ph-svg-cell:hover,
        body.dark-mode .ph-svg-cell:hover {
            stroke: rgba(255, 255, 255, 0.6);
            stroke-width: 1.2px;
        }

        .ph-footer {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 6px;
            margin-top: 12px;
            font-size: 11px;
            color: #8c959f;
        }

        .ph-legend-svg {
            display: inline-block;
            vertical-align: middle;
        }

        .ph-legend-svg .ph-svg-cell {
            cursor: default;
        }

        .ph-legend-svg .ph-svg-cell:hover {
            stroke: none;
        }

        /* 经典绿主题 (GitHub 风格) */
        .ph-theme-green .ph-level-0 {
            fill: #ebedf0;
        }

        .ph-theme-green .ph-level-1 {
            fill: #9be9a8;
        }

        .ph-theme-green .ph-level-2 {
            fill: #40c463;
        }

        .ph-theme-green .ph-level-3 {
            fill: #30a14e;
        }

        .ph-theme-green .ph-level-4 {
            fill: #216e39;
        }

        [data-theme="dark"] .ph-theme-green .ph-level-0,
        body.dark-mode .ph-theme-green .ph-level-0 {
            fill: #161b22;
            stroke: rgba(255, 255, 255, 0.06);
            stroke-width: 0.8px;
        }

        [data-theme="dark"] .ph-theme-green .ph-level-1,
        body.dark-mode .ph-theme-green .ph-level-1 {
            fill: #0e4429;
            stroke: none;
        }

        [data-theme="dark"] .ph-theme-green .ph-level-2,
        body.dark-mode .ph-theme-green .ph-level-2 {
            fill: #006d32;
            stroke: none;
        }

        [data-theme="dark"] .ph-theme-green .ph-level-3,
        body.dark-mode .ph-theme-green .ph-level-3 {
            fill: #26a641;
            stroke: none;
        }

        [data-theme="dark"] .ph-theme-green .ph-level-4,
        body.dark-mode .ph-theme-green .ph-level-4 {
            fill: #39d353;
            stroke: none;
        }

        /* 科技蓝主题 */
        .ph-theme-blue .ph-level-0 {
            fill: #ebedf0;
        }

        .ph-theme-blue .ph-level-1 {
            fill: #bae6fd;
        }

        .ph-theme-blue .ph-level-2 {
            fill: #38bdf8;
        }

        .ph-theme-blue .ph-level-3 {
            fill: #0284c7;
        }

        .ph-theme-blue .ph-level-4 {
            fill: #0369a1;
        }

        [data-theme="dark"] .ph-theme-blue .ph-level-0,
        body.dark-mode .ph-theme-blue .ph-level-0 {
            fill: #161b22;
            stroke: rgba(255, 255, 255, 0.06);
            stroke-width: 0.8px;
        }

        [data-theme="dark"] .ph-theme-blue .ph-level-1,
        body.dark-mode .ph-theme-blue .ph-level-1 {
            fill: #082f49;
            stroke: none;
        }

        [data-theme="dark"] .ph-theme-blue .ph-level-2,
        body.dark-mode .ph-theme-blue .ph-level-2 {
            fill: #0369a1;
            stroke: none;
        }

        [data-theme="dark"] .ph-theme-blue .ph-level-3,
        body.dark-mode .ph-theme-blue .ph-level-3 {
            fill: #0284c7;
            stroke: none;
        }

        [data-theme="dark"] .ph-theme-blue .ph-level-4,
        body.dark-mode .ph-theme-blue .ph-level-4 {
            fill: #38bdf8;
            stroke: none;
        }

        /* 活力橙主题 */
        .ph-theme-orange .ph-level-0 {
            fill: #ebedf0;
        }

        .ph-theme-orange .ph-level-1 {
            fill: #fed7aa;
        }

        .ph-theme-orange .ph-level-2 {
            fill: #fb923c;
        }

        .ph-theme-orange .ph-level-3 {
            fill: #ea580c;
        }

        .ph-theme-orange .ph-level-4 {
            fill: #c2410c;
        }

        [data-theme="dark"] .ph-theme-orange .ph-level-0,
        body.dark-mode .ph-theme-orange .ph-level-0 {
            fill: #161b22;
            stroke: rgba(255, 255, 255, 0.06);
            stroke-width: 0.8px;
        }

        [data-theme="dark"] .ph-theme-orange .ph-level-1,
        body.dark-mode .ph-theme-orange .ph-level-1 {
            fill: #431407;
            stroke: none;
        }

        [data-theme="dark"] .ph-theme-orange .ph-level-2,
        body.dark-mode .ph-theme-orange .ph-level-2 {
            fill: #9a3412;
            stroke: none;
        }

        [data-theme="dark"] .ph-theme-orange .ph-level-3,
        body.dark-mode .ph-theme-orange .ph-level-3 {
            fill: #ea580c;
            stroke: none;
        }

        [data-theme="dark"] .ph-theme-orange .ph-level-4,
        body.dark-mode .ph-theme-orange .ph-level-4 {
            fill: #fb923c;
            stroke: none;
        }
    </style>
